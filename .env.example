# Variables de entorno públicas para producción / Cloudflare Pages / desarrollo local
PUBLIC_WHATSAPP_PHONE=573000000000
PUBLIC_CONTACT_EMAIL=contacto@aleric.dev

# Resend API Key para el envío de correos del formulario (https://resend.com)
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=Aleric.dev <notification@aleric.dev>

# Cloudflare Turnstile (Anti-bot / Captcha Inteligente e Invisible)
# Para desarrollo/pruebas puedes usar los keys de Cloudflare Always-Pass:
# Sitekey: 1x00000000000000000000AA | Secret: 1x0000000000000000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
