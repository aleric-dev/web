---
import LinksLayout from '../../layouts/LinksLayout.astro';
import { Image } from 'astro:assets';

// Configuración Centralizada
const CONFIG = {
  whatsappNumber: '573013229292',
  whatsappUrl: 'https://wa.me/573013229292?text=Hola%20Aleric.dev,%20me%20gustar%C3%ADa%20cotizar%20un%20proyecto',
  email: 'contacto@aleric.dev',
  emailUrl: 'mailto:contacto@aleric.dev',
  instagramUrl: 'https://instagram.com/aleric.dev',
  linkedinUrl: 'https://linkedin.com/company/aleric-dev',
  websiteUrl: '/',
};
---

<LinksLayout
  title="Aleric.dev | Enlaces Oficiales & Contacto Directo"
  description="Chatea con Aleric.dev por WhatsApp, visita nuestro sitio web o déjanos un mensaje. Páginas web que venden, software a la medida y automatizaciones."
>
  <!-- Background Glow & Canvas Container -->
  <main class="min-h-screen w-full bg-slate-950 text-slate-100 flex flex-col items-center justify-between p-4 sm:p-6 md:py-8 relative overflow-hidden">
    
    <!-- Ambient Glow Effects -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-96 h-96 bg-indigo-600/15 rounded-full blur-3xl pointer-events-none -z-0"></div>
    <div class="absolute bottom-10 left-1/2 -translate-x-1/2 w-80 h-80 bg-emerald-600/10 rounded-full blur-3xl pointer-events-none -z-0"></div>

    <!-- Inner Card Container (Max Width 420px - Mobile First Óptimo) -->
    <div class="w-full max-w-sm mx-auto flex flex-col items-center relative z-10">
      
      <!-- Top Bar: Disponible a la izquierda | Compartir a la derecha (justify-between) -->
      <div class="w-full flex items-center justify-between gap-3 mb-6">
        <!-- Status Pill -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-950/70 border border-emerald-500/40 text-emerald-400 text-xs font-semibold shadow-sm">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span>Disponible</span>
        </div>

        <!-- Share Button -->
        <button
          id="share-btn"
          type="button"
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-slate-900/90 border border-slate-800 text-slate-300 hover:text-white hover:border-slate-700 text-xs font-medium transition active:scale-95 shadow-sm cursor-pointer"
          aria-label="Compartir este perfil"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
          </svg>
          <span id="share-btn-text">Compartir</span>
        </button>
      </div>

      <!-- Header con ÉNFASIS FUERTE EN EL LOGO -->
      <header class="flex flex-col items-center text-center mb-6 w-full">
        <a href="/" class="inline-block group mb-2 transition transform hover:scale-[1.03]">
          <Image
            src="/logo-horizontal.png"
            alt="Aleric.dev Logo"
            width={480}
            height={140}
            class="h-24 sm:h-32 w-auto object-contain drop-shadow-2xl"
            priority
          />
        </a>

        <!-- Bio Simple y Directa -->
        <p class="text-xs sm:text-sm text-slate-300 text-center leading-relaxed max-w-xs font-normal">
          Páginas web que venden, software a tu medida y automatizaciones de WhatsApp.
        </p>
      </header>

      <!-- CANALES PRINCIPALES DESTACADOS CON COLOR -->
      <section class="w-full space-y-3 mb-4" aria-label="Canales principales">
        
        <!-- Botón 1: WhatsApp Directo (Verde Esmeralda) -->
        <a
          href={CONFIG.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full h-12 rounded-full bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-xs uppercase tracking-wider shadow-lg shadow-emerald-950/60 transition-all duration-200 active:scale-[0.97] flex items-center justify-center relative px-3 group cursor-pointer border border-emerald-400/40"
        >
          <span class="absolute left-2 w-8 h-8 rounded-full bg-white/20 flex items-center justify-center shadow-inner group-hover:scale-105 transition-transform text-white shrink-0">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
          </span>
          <span class="text-center font-extrabold tracking-wider truncate px-4">
            CONTÁCTANOS POR WHATSAPP
          </span>
        </a>

        <!-- Botón 2: Sitio Web Oficial (Índigo Vibrante) -->
        <a
          href={CONFIG.websiteUrl}
          class="w-full h-12 rounded-full bg-indigo-600 hover:bg-indigo-500 text-white font-extrabold text-xs uppercase tracking-wider shadow-lg shadow-indigo-950/60 transition-all duration-200 active:scale-[0.97] flex items-center justify-center relative px-3 group cursor-pointer border border-indigo-400/40"
        >
          <span class="absolute left-2 w-8 h-8 rounded-full bg-white/20 flex items-center justify-center shadow-inner group-hover:scale-105 transition-transform text-white shrink-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
            </svg>
          </span>
          <span class="text-center font-extrabold tracking-wider truncate px-4">
            VISITA NUESTRO SITIO WEB
          </span>
        </a>

      </section>

      <!-- SECCIÓN ACCIONES SECUNDARIAS: CONTACTO DIRECTO & REDES -->
      <section class="w-full space-y-2.5 mb-5" aria-label="Acciones y Redes">
        
        <!-- Botón Contacto Directo / Dejar Mensaje (Lleva a /contactanos) -->
        <a
          href="/contactanos"
          class="w-full h-12 rounded-full bg-white hover:bg-slate-100 text-slate-900 font-extrabold text-[11px] sm:text-xs uppercase tracking-wider shadow-md shadow-black/30 transition-all duration-200 active:scale-[0.97] flex items-center justify-center relative px-3 group cursor-pointer border border-slate-200"
        >
          <span class="absolute left-2 w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center shadow-inner group-hover:scale-105 transition-transform text-indigo-600 shrink-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
            </svg>
          </span>
          <span class="text-center font-extrabold tracking-wider truncate px-6">
            CONTÁCTANOS DIRECTAMENTE
          </span>
          <svg class="w-4 h-4 text-slate-400 group-hover:text-slate-900 group-hover:translate-x-0.5 transition-transform absolute right-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
          </svg>
        </a>

        <!-- Instagram -->
        <a
          href={CONFIG.instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full h-11 sm:h-12 rounded-full bg-slate-900 hover:bg-slate-800 text-slate-200 hover:text-white font-extrabold text-[11px] sm:text-xs uppercase tracking-wider shadow-sm transition-all duration-200 active:scale-[0.97] flex items-center justify-center relative px-3 group cursor-pointer border border-slate-800 hover:border-pink-500/50"
        >
          <span class="absolute left-2 w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-slate-800 flex items-center justify-center shadow-inner group-hover:scale-105 transition-transform text-pink-400 shrink-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke-width="2"></rect>
              <path stroke-width="2" d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" stroke-width="2.5" stroke-linecap="round"></line>
            </svg>
          </span>
          <span class="text-center font-extrabold tracking-wider truncate px-8">
            SÍGUENOS EN INSTAGRAM
          </span>
          <svg class="w-4 h-4 text-slate-500 group-hover:text-white group-hover:translate-x-0.5 transition-transform absolute right-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
          </svg>
        </a>

        <!-- LinkedIn -->
        <a
          href={CONFIG.linkedinUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full h-11 sm:h-12 rounded-full bg-slate-900 hover:bg-slate-800 text-slate-200 hover:text-white font-extrabold text-[11px] sm:text-xs uppercase tracking-wider shadow-sm transition-all duration-200 active:scale-[0.97] flex items-center justify-center relative px-3 group cursor-pointer border border-slate-800 hover:border-sky-500/50"
        >
          <span class="absolute left-2 w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-slate-800 flex items-center justify-center shadow-inner group-hover:scale-105 transition-transform text-sky-400 shrink-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-width="2" d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6z"></path>
              <rect x="2" y="9" width="4" height="12" stroke-width="2"></rect>
              <circle cx="4" cy="4" r="2" stroke-width="2"></circle>
            </svg>
          </span>
          <span class="text-center font-extrabold tracking-wider truncate px-8">
            CONÉCTATE EN LINKEDIN
          </span>
          <svg class="w-4 h-4 text-slate-500 group-hover:text-white group-hover:translate-x-0.5 transition-transform absolute right-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
          </svg>
        </a>

      </section>

      <!-- REUBICACIÓN DEL CORREO: Bloque Discreto y Directo -->
      <div class="w-full text-center pt-2 pb-4">
        <span class="text-[11px] text-slate-400 block mb-1">¿Prefieres escribirnos directamente por correo?</span>
        <a
          href={CONFIG.emailUrl}
          class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-900 border border-slate-800 text-xs font-mono text-indigo-300 hover:text-white hover:border-indigo-500/50 transition shadow-sm"
        >
          <svg class="w-3.5 h-3.5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
          <span>{CONFIG.email}</span>
        </a>
      </div>

      <!-- Footer Minimalista -->
      <footer class="text-center space-y-2 text-xs text-slate-500 font-mono pb-4 pt-1">
        <div class="flex items-center justify-center gap-2 font-sans text-slate-400 font-medium">
          <span class="text-indigo-400 font-semibold">Menos fricción, más resultados</span>
          <span>•</span>
          <span>Código 100% propio</span>
        </div>
        <p>© {new Date().getFullYear()} Aleric.dev. Todos los derechos reservados.</p>
      </footer>

    </div>

  </main>
</LinksLayout>

<!-- Script para botón compartir -->
<script is:inline>
  (function() {
    function initShareLogic() {
      const shareBtn = document.getElementById('share-btn');
      const shareText = document.getElementById('share-btn-text');
      if (shareBtn && shareText) {
        shareBtn.onclick = async () => {
          const shareUrl = 'https://aleric.dev';

          const shareMessage = `¡Hola! Te presento a Aleric.dev 🚀

Somos el equipo de tecnología que tu empresa necesita para crecer sin dolores de cabeza operativos. Nos encargamos de construir soluciones a la medida de tu negocio:

🌐 Páginas web y landings rápidas diseñadas para vender más.
💬 Automatizaciones de WhatsApp 24/7, cotizaciones y cobranzas.
🚀 Software propio para centralizar tus procesos y dejar atrás Excel.
🛡️ Consultoría y soporte técnico para mejorar tus plataformas actuales.

Menos fricción y más resultados, sin ataduras a terceros.

Échale un vistazo y hablemos aquí:
${shareUrl}`;

          const shareData = {
            title: 'Aleric.dev | Boutique de Software & Automatizaciones',
            text: shareMessage,
          };

          if (navigator.share) {
            try {
              await navigator.share(shareData);
            } catch (err) {
              // Cancelado por el usuario
            }
          } else if (navigator.clipboard) {
            try {
              await navigator.clipboard.writeText(shareMessage);
              const originalText = shareText.textContent;
              shareText.textContent = '¡Mensaje Copiado!';
              shareBtn.classList.add('border-emerald-500', 'text-emerald-400');
              setTimeout(() => {
                shareText.textContent = originalText;
                shareBtn.classList.remove('border-emerald-500', 'text-emerald-400');
              }, 2500);
            } catch (e) {
              // Fallback
            }
          }
        };
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initShareLogic);
    } else {
      initShareLogic();
    }
    document.addEventListener('astro:after-swap', initShareLogic);
  })();
</script>
