---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import WebComparison from "../../components/WebComparison.astro";
import FaqSection from "../../components/FaqSection.astro";
import ContactSection from "../../components/ContactSection.astro";
import Footer from "../../components/Footer.astro";

const webServices = [
  {
    icon: "⚡",
    title: "Landings de Alta Conversión (CRO)",
    description:
      "Páginas promocionales diseñadas con un solo objetivo: captar clientes y cerrar ventas sin distracciones.",
  },
  {
    icon: "🛍️",
    title: "Tiendas E-commerce Ágiles",
    description:
      "Catálogos y tiendas online con pagos en línea (PSE, tarjetas, transferencias) o cierre directo por WhatsApp.",
  },
  {
    icon: "🏢",
    title: "Sitios Web Corporativos",
    description:
      "Presencia formal y profesional para tu marca, transmitiendo máxima confianza a tus clientes e inversionistas.",
  },
  {
    icon: "🚀",
    title: "Velocidad Extrema en Celulares",
    description:
      "Tus páginas abren en menos de 1 segundo. Tus clientes no esperan y tu dinero en publicidad rinde más.",
  },
  {
    icon: "📲",
    title: "Catálogos Interactivos",
    description:
      "Presentación atractiva de tus productos o servicios con botones rápidos de cotización y consulta.",
  },
  {
    icon: "🔄",
    title: "Rediseño de Sitios Lentos",
    description:
      "Transformamos tu sitio actual pesado o desactualizado en una máquina moderna, limpia y vendedora.",
  },
  {
    icon: "🔍",
    title: "Visibilidad en Google (SEO Comercial)",
    description:
      "Optimizamos tu contenido y estructura para que los clientes que buscan lo que vendes te encuentren primero.",
  },
  {
    icon: "💬",
    title: "Cotización Rápida & Entrega Express",
    description:
      "Presupuesto claro y entrega de tu sitio listo para vender en un plazo de 3 a 7 días hábiles.",
  },
];
---

<Layout
  title="Aleric.dev | Desarrollo Web, Landings que Venden & E-commerce Ágil"
  description="Construimos páginas web, landings de alta conversión y tiendas online ultrarrápidas diseñadas para multiplicar tus ventas y posicionar tu marca."
>
  <Navbar />

  <main
    class="bg-slate-50 dark:bg-slate-950 transition-colors duration-300"
  >
    <!-- Hero Split Especializado Desarrollo Web -->
    <section
      id="hero"
      class="pt-24 sm:pt-32 pb-12 md:pb-16 relative border-b border-slate-200 dark:border-slate-800 overflow-hidden"
    >
      <div
        class="max-w-7xl mx-auto px-6 grid lg:grid-cols-12 gap-12 items-center relative z-10"
      >
        <div class="lg:col-span-7 space-y-6 text-center lg:text-left flex flex-col items-center lg:items-start">
          <span
            class="inline-flex items-center gap-2 rounded-lg border border-cyan-200 dark:border-cyan-900 bg-cyan-50 dark:bg-cyan-950/80 px-3.5 py-1.5 text-xs font-bold text-cyan-700 dark:text-cyan-300"
          >
            🌐 Páginas Web para Vender Más
          </span>

          <h1
            class="text-[2.5rem] sm:text-5xl lg:text-6xl font-black text-slate-900 dark:text-white tracking-tight leading-[1.15]"
          >
            Páginas web rápidas diseñadas para <span
              class="text-cyan-600 dark:text-cyan-400"
              >vender más todos los días</span
            >
          </h1>

          <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed max-w-xl mx-auto lg:mx-0">
            Carga en celular en menos de un segundo y enfocada 100% en captar clientes.
          </p>

          <!-- Imagen Real de Producto en Mobile (< lg) — Integrada al flujo narrativo antes de los botones -->
          <div class="block lg:hidden pt-1 pb-1 w-full max-w-lg mx-auto text-left">
            <div class="relative rounded-2xl overflow-hidden shadow-xl border border-slate-200/90 dark:border-slate-800/90 bg-white dark:bg-slate-900 group">
              <img
                src="/assets/services/solution-web.webp"
                alt="Páginas web y tiendas online de alta conversión Aleric.dev"
                class="w-full h-auto object-cover"
                width="640"
                height="480"
                loading="eager"
              />
              <div class="absolute bottom-2.5 left-2.5 bg-white/95 dark:bg-slate-900/95 backdrop-blur-xs border border-slate-200 dark:border-slate-800 rounded-lg px-2.5 py-1 text-[11px] font-bold text-slate-800 dark:text-slate-200 shadow-xs flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-cyan-500"></span>
                <span>Carga &lt; 0.5s en Celular · Alta Conversión</span>
              </div>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3.5 pt-2 w-full sm:w-auto">
            <a
              href="#contacto"
              class="w-full sm:w-auto h-11 px-6 rounded-xl bg-cyan-600 hover:bg-cyan-700 text-white font-bold text-xs uppercase tracking-wider shadow-xs transition flex items-center justify-center"
            >
              Cotizar Página Web
            </a>
            <a
              href="/"
              class="w-full sm:w-auto h-11 px-5 rounded-xl bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 font-bold text-xs border border-slate-300 dark:border-slate-800 hover:bg-slate-100 dark:hover:bg-slate-800 transition flex items-center justify-center"
            >
              ← Volver al Inicio
            </a>
          </div>
        </div>

        <!-- Visual Showcase Imagen Real en Desktop (Oculta en Mobile) -->
        <div class="hidden lg:block lg:col-span-5 w-full">
          <div class="relative w-full max-w-lg lg:max-w-none mx-auto select-none">
            <div class="relative rounded-3xl overflow-hidden shadow-2xl border border-slate-200/90 dark:border-slate-800/90 bg-white dark:bg-slate-900 group">
              <img
                src="/assets/services/solution-web.webp"
                alt="Páginas web y tiendas online de alta conversión Aleric.dev"
                class="w-full h-auto object-cover"
                width="640"
                height="480"
                loading="eager"
              />
            </div>
            <div class="hidden sm:flex absolute -bottom-4 -left-4 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md border border-slate-200 dark:border-slate-800 rounded-2xl p-3 shadow-xl items-center gap-3">
              <div class="w-8 h-8 rounded-xl bg-cyan-50 dark:bg-cyan-950/60 text-cyan-600 dark:text-cyan-400 flex items-center justify-center font-bold text-sm">
                ⚡
              </div>
              <div>
                <p class="text-xs font-bold text-slate-900 dark:text-white">&lt; 0.5s en Celular</p>
                <p class="text-[10px] text-slate-500 dark:text-slate-400">Apertura instantánea</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Por Qué una Landing Page Multiplica tus Ventas -->
    <section class="py-16 bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800">
      <div class="max-w-7xl mx-auto px-6">
        <div class="text-center max-w-4xl mx-auto mb-14">
          <h2 class="text-3xl sm:text-4xl lg:text-[2.75rem] font-black text-slate-900 dark:text-white tracking-tight leading-[1.15]">
            ¿Por qué una Landing Page vende mucho más que un sitio web tradicional?
          </h2>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          <div class="p-7 rounded-2xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 space-y-3">
            <div class="w-12 h-12 rounded-xl bg-cyan-100 dark:bg-cyan-900/60 text-cyan-700 dark:text-cyan-300 flex items-center justify-center text-2xl font-bold">
              🎯
            </div>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white">Cero Distracciones</h3>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
              Un sitio común tiene decenas de enlaces donde el cliente se pierde. Una landing tiene una única misión: presentar el beneficio y llevar al usuario a comprar o contactarte.
            </p>
          </div>

          <div class="p-7 rounded-2xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 space-y-3">
            <div class="w-12 h-12 rounded-xl bg-cyan-100 dark:bg-cyan-900/60 text-cyan-700 dark:text-cyan-300 flex items-center justify-center text-2xl font-bold">
              ⚡
            </div>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white">Rapidez = Eficiencia Pura</h3>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
              No necesitas saber de código para entender que la velocidad vende. Nuestras páginas se abren en menos de medio segundo, aprovechando cada peso que inviertes en publicidad.
            </p>
          </div>

          <div class="p-7 rounded-2xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 space-y-3">
            <div class="w-12 h-12 rounded-xl bg-cyan-100 dark:bg-cyan-900/60 text-cyan-700 dark:text-cyan-300 flex items-center justify-center text-2xl font-bold">
              💳
            </div>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white">E-commerce &amp; Cobro Ágil</h3>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
              Vende tus productos directamente por internet con pagos seguros (PSE, tarjetas de crédito, transferencias) o canaliza los pedidos con mensaje prellenado a tu WhatsApp.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Matriz Comparativa: WordPress vs Landing Aleric -->
    <WebComparison />

    <!-- Catálogo de Servicios Web -->
    <section id="beneficios" class="scroll-mt-20 py-16 bg-slate-50 dark:bg-slate-950">
      <div class="max-w-7xl mx-auto px-6">
        <div class="text-center max-w-4xl mx-auto mb-14">
          <h2 class="text-3xl sm:text-4xl lg:text-[2.75rem] font-black text-slate-900 dark:text-white tracking-tight leading-[1.15]">
            ¿Qué podemos construir para tu negocio?
          </h2>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          {
            webServices.map((f) => (
              <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 flex flex-col justify-between hover:border-cyan-400 transition shadow-sm">
                <div>
                  <div class="text-2xl mb-3 p-2.5 rounded-xl bg-cyan-50 dark:bg-cyan-950/60 w-fit">
                    {f.icon}
                  </div>
                  <h3 class="text-base font-bold text-slate-900 dark:text-white mb-2">
                    {f.title}
                  </h3>
                  <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed font-normal">
                    {f.description}
                  </p>
                </div>
                <div class="pt-4 mt-4 border-t border-slate-100 dark:border-slate-800">
                  <a
                    href="#contacto"
                    class="text-xs font-bold text-cyan-600 dark:text-cyan-400 hover:underline flex items-center gap-1"
                  >
                    <span>Cotizar esta solución</span> →
                  </a>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Banner Cotización Express -->
    <section class="py-12 bg-cyan-600 text-white text-center">
      <div class="max-w-4xl mx-auto px-6 space-y-4">
        <h3 class="text-2xl sm:text-3xl font-black tracking-tight">¿Tienes un negocio y necesitas vender por internet esta misma semana?</h3>
        <p class="text-cyan-100 text-sm sm:text-base max-w-xl mx-auto">
          Te entregamos una propuesta clara con precio fijo y tiempos de entrega garantizados.
        </p>
        <div class="pt-2">
          <a
            href="#contacto"
            class="inline-block px-7 py-3.5 rounded-xl bg-white text-cyan-800 hover:bg-cyan-50 font-bold text-xs uppercase tracking-wider shadow-md transition"
          >
            Solicitar Cotización Rápida
          </a>
        </div>
      </div>
    </section>

    <!-- Preguntas Frecuentes Reales & Garantías Blindadas -->
    <FaqSection />

    <!-- Formulario de Captura de Leads Dedicado -->
    <ContactSection
      defaultService="Desarrollo Web & Landings de Alta Conversión"
    />
  </main>

  <Footer />
</Layout>
