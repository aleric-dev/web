---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import ContactSection from '../../components/ContactSection.astro';
import Footer from '../../components/Footer.astro';

const consultingServices = [
  {
    icon: '🔍',
    title: 'Auditoría de Código & Deuda Técnica',
    description: 'Revisión minuciosa de repositorios para detectar malas prácticas, problemas de arquitectura y cuellos de botella de rendimiento.',
  },
  {
    icon: '🩹',
    title: 'Rescate de Proyectos Legacy & Inconclusos',
    description: 'Saneamiento y recuperación de aplicaciones abandonadas o con errores críticos para ponerlas operativas rápidamente.',
  },
  {
    icon: '🛡️',
    title: 'Inspección de Proveedores Externos',
    description: 'Evaluación técnica imparcial del trabajo entregado por agencias o freelancers contratados para validar su calidad real.',
  },
  {
    icon: '🚀',
    title: 'Optimización de Desempeño & Bases de Datos',
    description: 'Tuning de consultas SQL/NoSQL, indexación y estrategias de almacenamiento en caché con Redis.',
  },
  {
    icon: '🔒',
    title: 'Auditoría de Seguridad & Vulnerabilidades',
    description: 'Escaneo de fallos de seguridad (OWASP Top 10), fuga de credenciales y desconfiguración de servidores.',
  },
  {
    icon: '🏛️',
    title: 'Asesoría de Arquitectura CTO as a Service',
    description: 'Dirección técnica senior para la toma de decisiones estratégicas de stack, infraestructura cloud y contratación.',
  },
  {
    icon: '☁️',
    title: 'Migración & Optimización de Infraestructura Cloud',
    description: 'Transición eficiente a servicios en AWS, GCP o VPS optimizando costos y escalabilidad.',
  },
  {
    icon: '📋',
    title: 'Definición de Buenas Prácticas & CI/CD',
    description: 'Implementación de pipelines de integración continua, pruebas automatizadas y estándares de código en tu equipo.',
  },
];
---

<Layout
  title="Consultoría & Auditoría Técnica Senior | Aleric.dev"
  description="Evaluamos, diagnosticamos y saneamos proyectos de software. Auditoría de código, rescate de plataformas legacy e inspección de proveedores externos."
>
  <Navbar />

  <main class="pt-28 bg-slate-900/40 dark:bg-slate-950 transition-colors duration-300">
    <!-- Hero Especializado Consultoría Técnica -->
    <section id="hero" class="py-16 relative overflow-hidden">
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[400px] bg-amber-600/15 rounded-full blur-[140px] pointer-events-none"></div>

      <div class="max-w-7xl mx-auto px-6 relative z-10 text-center">
        <span class="inline-flex items-center gap-2 rounded-full border border-amber-500/40 bg-amber-500/10 px-4 py-2 text-xs font-mono font-bold text-amber-600 dark:text-amber-300 mb-6">
          🛡️ Para CTOs, Fundadores &amp; Líderes de Tecnología
        </span>

        <h1 class="text-4xl sm:text-6xl font-extrabold text-slate-900 dark:text-white tracking-tight max-w-4xl mx-auto leading-tight mb-6">
          Consultoría Técnica Senior &amp; <span class="bg-gradient-to-r from-amber-500 via-orange-500 to-yellow-500 bg-clip-text text-transparent">Auditoría de Código</span>
        </h1>

        <p class="text-slate-600 dark:text-slate-300 text-lg sm:text-xl max-w-2xl mx-auto leading-relaxed mb-10">
          ¿Tu software está lento, fallando o estancado? Diagnosticamos la causa raíz de los problemas técnicos y te entregamos un plan de acción claro.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="#contacto"
            class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-gradient-to-r from-amber-500 to-orange-600 text-white font-extrabold text-xs uppercase tracking-wider shadow-xl shadow-amber-950/30 hover:scale-105 transition cursor-pointer flex items-center justify-center"
          >
            Solicitar Auditoría / Diagnóstico
          </a>
          <a
            href="/"
            class="w-full sm:w-auto px-7 py-4 rounded-2xl bg-slate-100 dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-white font-bold text-xs border border-slate-200 dark:border-slate-800 transition flex items-center justify-center"
          >
            ← Volver al Inicio
          </a>
        </div>
      </div>
    </section>

    <!-- Catálogo Especializado de Servicios Consultoría (8 Tarjetas) -->
    <section id="beneficios" class="py-16 bg-slate-100/80 dark:bg-slate-900/60 border-t border-slate-200 dark:border-slate-800">
      <div class="max-w-7xl mx-auto px-6">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-3">Catálogo de Servicios de Consultoría &amp; Auditoría</h2>
          <p class="text-slate-600 dark:text-slate-400 text-sm">Transparencia, diagnóstico imparcial y soluciones de ingeniería comprobadas.</p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-7">
          {consultingServices.map((f) => (
            <div class="p-7 rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950/80 shadow-md hover:shadow-xl hover:-translate-y-1 transition duration-300 flex flex-col justify-between">
              <div>
                <div class="text-3xl mb-4 p-3 rounded-2xl bg-amber-500/10 w-fit">{f.icon}</div>
                <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">{f.title}</h3>
                <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed font-normal">{f.description}</p>
              </div>
              <div class="pt-5 mt-4 border-t border-slate-100 dark:border-slate-900">
                <a href="#contacto" class="text-xs font-bold text-amber-600 dark:text-amber-400 hover:underline flex items-center gap-1">
                  <span>Solicitar auditoría</span> →
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Formulario de Captura de Leads Dedicado con Selección Automática -->
    <ContactSection defaultService="Consultoría & Auditoría Técnica Senior" />
  </main>

  <Footer />
</Layout>
