---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import AuditPillars from "../../components/AuditPillars.astro";
import FaqSection from "../../components/FaqSection.astro";
import ContactSection from "../../components/ContactSection.astro";
import Footer from "../../components/Footer.astro";

const technicalSpecialties = [
  {
    icon: "📘",
    title: "Fullstack TypeScript (NestJS & React 19 / Next.js)",
    description:
      "Arquitecturas limpias y desacopladas con tipado estricto end-to-end. Backend escalable con NestJS (inyección de dependencias, CQRS, guards) y frontend moderno con React 19 y Next.js App Router.",
  },
  {
    icon: "🐘",
    title: "PostgreSQL Avanzado & Optimización SQL",
    description:
      "Modelado de bases de datos relacionales, optimización de queries con EXPLAIN ANALYZE, índices compuestos y GIN, Row Level Security (RLS) multi-tenant y migraciones con Prisma y Drizzle ORM.",
  },
  {
    icon: "⚙️",
    title: "Orquestación de Flujos & Automatización",
    description:
      "Automatización de pipelines empresariales y tareas en segundo plano. Webhooks seguros, gestión de errores y sincronización en tiempo real entre sistemas heterogéneos.",
  },
  {
    icon: "🐍",
    title: "Python (FastAPI & Scripts Asíncronos)",
    description:
      "Microservicios ultrarrápidos con FastAPI y Pydantic, scripts de procesamiento por lotes, extracción y transformación de datos (ETL) y tareas en segundo plano con Redis y Celery.",
  },
  {
    icon: "💬",
    title: "WhatsApp Cloud API Oficial",
    description:
      "Integración nativa con la API oficial mediante webhooks seguros, envío de plantillas interactivas y arquitectura tolerante a fallos sin emuladores.",
  },
  {
    icon: "🧾",
    title: "Integración de Sistemas ERP & Facturación Electrónica",
    description:
      "Conexión directa con APIs empresariales para emisión de facturación electrónica automática, creación de clientes, recibos de caja y sincronización de catálogo e inventarios en tiempo real.",
  },
  {
    icon: "🔍",
    title: "Auditoría de Código & Seguridad OWASP",
    description:
      "Inspección minuciosa de repositorios para detectar deuda técnica, cuellos de botella de latencia, fugas de memoria, vulnerabilidades de inyección y evaluación de proveedores externos.",
  },
  {
    icon: "🎓",
    title: "Capacitación Técnica & Mentoría 1-a-1",
    description:
      "Acompañamiento a desarrolladores y equipos tech en buenas prácticas de ingeniería, code reviews en vivo, pruebas automatizadas (Jest/Vitest) y preparación para retos técnicos senior.",
  },
];

const deepStackDetails = [
  {
    category: "Fullstack TypeScript",
    tags: ["NestJS", "Node.js", "React 19", "Next.js 15", "TypeScript 5.8", "Zod", "Tailwind CSS"],
    highlight: "Tipado estricto de extremo a extremo para eliminar errores en tiempo de ejecución.",
  },
  {
    category: "Bases de Datos & Persistencia",
    tags: ["PostgreSQL", "Prisma ORM", "Drizzle", "Redis Cache", "Supabase", "Row Level Security"],
    highlight: "Consultas optimizadas sin N+1, índices estratégicos y aislamiento de datos.",
  },
  {
    category: "Automatización & Conectores",
    tags: ["Orquestación de Flujos", "WhatsApp Cloud API", "Integración ERP", "Paneles Multiagente", "Webhooks Seguros"],
    highlight: "Integraciones empresariales oficiales sin riesgo de bloqueos de cuenta.",
  },
  {
    category: "Python & Microservicios",
    tags: ["Python 3.12", "FastAPI", "Pydantic v2", "Uvicorn", "AsyncIO", "Web Scraping"],
    highlight: "Rendimiento asíncrono con validación de tipos automática y OpenAPI.",
  },
];
---

<Layout
  title="Aleric.dev | Consultoría Técnica Senior & Auditoría de Software"
  description="Consultoría técnica senior, auditoría de código, rescate legacy, integración de sistemas ERP, WhatsApp Cloud API, arquitectura en la nube y mentoría Fullstack."
>
  <Navbar />

  <main
    class="bg-slate-50 dark:bg-slate-950 transition-colors duration-300"
  >
    <!-- Hero Especializado Consultoría Técnica -->
    <section
      id="hero"
      class="pt-24 sm:pt-32 pb-12 md:pb-16 relative border-b border-slate-200 dark:border-slate-800 overflow-hidden"
    >
      <div
        class="max-w-7xl mx-auto px-6 grid lg:grid-cols-12 gap-12 items-center relative z-10"
      >
        <div class="lg:col-span-7 space-y-6 text-center lg:text-left flex flex-col items-center lg:items-start">
          <span
            class="inline-flex items-center gap-2 rounded-lg border border-amber-200 dark:border-amber-900 bg-amber-50 dark:bg-amber-950/80 px-3.5 py-1.5 text-xs font-bold text-amber-700 dark:text-amber-300"
          >
            🛡️ Para CTOs, Líderes Tech, Empresas &amp; Desarrolladores
          </span>

          <h1
            class="text-[2.5rem] sm:text-5xl lg:text-6xl font-black text-slate-900 dark:text-white tracking-tight leading-[1.15]"
          >
            Diagnóstico técnico y rescate de <span
              class="text-amber-600 dark:text-amber-400"
              >plataformas de software</span
            >
          </h1>

          <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed max-w-xl mx-auto lg:mx-0">
            Identificamos causas de lentitud, solucionamos fallas críticas y conectamos tus sistemas con ingeniería senior.
          </p>

          <!-- Imagen Real de Producto en Mobile (< lg) — Integrada al flujo narrativo antes de los botones -->
          <div class="block lg:hidden pt-1 pb-1 w-full max-w-lg mx-auto text-left">
            <div class="relative rounded-2xl overflow-hidden shadow-xl border border-slate-200/90 dark:border-slate-800/90 bg-white dark:bg-slate-900 group">
              <img
                src="/assets/services/solution-consultancy.jpg"
                alt="Consultoría técnica y auditoría de software Aleric.dev"
                class="w-full h-auto object-cover"
                width="640"
                height="480"
                loading="eager"
              />
              <div class="absolute bottom-2.5 left-2.5 bg-white/95 dark:bg-slate-900/95 backdrop-blur-xs border border-slate-200 dark:border-slate-800 rounded-lg px-2.5 py-1 text-[11px] font-bold text-slate-800 dark:text-slate-200 shadow-xs flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                <span>Ingeniería Senior · Diagnóstico en 48h</span>
              </div>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3.5 pt-2 w-full sm:w-auto">
            <a
              href="#contacto"
              class="w-full sm:w-auto h-11 px-6 rounded-xl bg-amber-600 hover:bg-amber-700 text-white font-bold text-xs uppercase tracking-wider shadow-xs transition flex items-center justify-center"
            >
              Agendar Diagnóstico Técnico
            </a>
            <a
              href="/"
              class="w-full sm:w-auto h-11 px-5 rounded-xl bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 font-bold text-xs border border-slate-300 dark:border-slate-800 hover:bg-slate-100 dark:hover:bg-slate-800 transition flex items-center justify-center"
            >
              ← Volver al Inicio
            </a>
          </div>
        </div>

        <!-- Visual Showcase Imagen Real en Desktop (Oculta en Mobile) -->
        <div class="hidden lg:block lg:col-span-5 w-full">
          <div class="relative w-full max-w-lg lg:max-w-none mx-auto select-none">
            <div class="relative rounded-3xl overflow-hidden shadow-2xl border border-slate-200/90 dark:border-slate-800/90 bg-white dark:bg-slate-900 group">
              <img
                src="/assets/services/solution-consultancy.jpg"
                alt="Consultoría técnica y auditoría de software Aleric.dev"
                class="w-full h-auto object-cover transform transition-transform duration-500 group-hover:scale-[1.02]"
                width="640"
                height="480"
                loading="eager"
              />
            </div>
            <div class="hidden sm:flex absolute -bottom-4 -left-4 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md border border-slate-200 dark:border-slate-800 rounded-2xl p-3 shadow-xl items-center gap-3">
              <div class="w-8 h-8 rounded-xl bg-amber-50 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 flex items-center justify-center font-bold text-sm">
                🛡️
              </div>
              <div>
                <p class="text-xs font-bold text-slate-900 dark:text-white">Auditoría &amp; Respaldo</p>
                <p class="text-[10px] text-slate-500 dark:text-slate-400">Diagnóstico imparcial</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección de Diagnóstico: Scorecard de Auditoría Técnica -->
    <section class="py-16 bg-slate-100/70 dark:bg-slate-900/40 border-b border-slate-200 dark:border-slate-800">
      <div class="max-w-7xl mx-auto px-6">
        <div class="grid lg:grid-cols-12 gap-10 items-center">
          <div class="lg:col-span-5 space-y-4">
            <span class="inline-block px-3.5 py-1 rounded-lg bg-amber-100 dark:bg-amber-950 border border-amber-200 dark:border-amber-800 text-amber-700 dark:text-amber-300 text-xs font-bold uppercase tracking-wider">
              Diagnóstico de Ingeniería
            </span>
            <h2 class="text-3xl font-extrabold text-slate-900 dark:text-white leading-tight">
              Scorecard de Auditoría Técnica &amp; Deuda de Código
            </h2>
            <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed">
              Analizamos a profundidad el estado de tu software para identificar cuellos de botella de rendimiento, fallos de seguridad y problemas de escalabilidad antes de que afecten a tus clientes o disparen tus costos.
            </p>
            <ul class="space-y-2.5 text-xs text-slate-600 dark:text-slate-400 font-medium pt-1">
              <li class="flex items-center gap-2">
                <span class="text-amber-500 font-bold">✓</span> Identificación de queries lentas N+1 y memory leaks.
              </li>
              <li class="flex items-center gap-2">
                <span class="text-amber-500 font-bold">✓</span> Auditoría contra el estándar de seguridad OWASP Top 10.
              </li>
              <li class="flex items-center gap-2">
                <span class="text-amber-500 font-bold">✓</span> Plan accionable de refactorización y rescate técnico.
              </li>
            </ul>
          </div>

          <div class="lg:col-span-7">
            <AuditPillars />
          </div>
        </div>
      </div>
    </section>

    <!-- Desglose Técnico Exhaustivo por Área -->
    <section class="py-16 bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800">
      <div class="max-w-7xl mx-auto px-6">
        <div class="text-center max-w-3xl mx-auto mb-14 space-y-3">
          <span class="inline-block px-3.5 py-1 rounded-lg bg-amber-100 dark:bg-amber-950 border border-amber-200 dark:border-amber-800 text-amber-700 dark:text-amber-300 text-xs font-bold uppercase tracking-wider">
            Dominio Tecnológico
          </span>
          <h2 class="text-3xl font-extrabold text-slate-900 dark:text-white">
            Ingeniería Senior sin Vicios Técnicos
          </h2>
          <p class="text-slate-600 dark:text-slate-400 text-sm sm:text-base">
            No improvisamos. Aplicamos patrones de arquitectura probados, principios SOLID y tipado estricto.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          {deepStackDetails.map((item) => (
            <div class="p-7 rounded-2xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 space-y-4">
              <h3 class="text-lg font-bold text-slate-900 dark:text-white">{item.category}</h3>
              <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed font-mono">{item.highlight}</p>
              <div class="flex flex-wrap gap-2 pt-2">
                {item.tags.map((tag) => (
                  <span class="px-2.5 py-1 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-[11px] font-mono text-slate-700 dark:text-slate-300">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Catálogo de Servicios de Consultoría Técnica -->
    <section id="beneficios" class="scroll-mt-20 py-16 bg-slate-50 dark:bg-slate-950">
      <div class="max-w-7xl mx-auto px-6">
        <div class="text-center max-w-2xl mx-auto mb-14">
          <h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-3">
            Servicios de Consultoría &amp; Acompañamiento
          </h2>
          <p class="text-slate-600 dark:text-slate-400 text-sm">
            Diagnóstico, resolución de fallas críticas y formación técnica para tu equipo.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          {
            technicalSpecialties.map((f) => (
              <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 flex flex-col justify-between hover:border-amber-400 transition shadow-sm">
                <div>
                  <div class="text-2xl mb-3 p-2.5 rounded-xl bg-amber-50 dark:bg-amber-950/60 w-fit">
                    {f.icon}
                  </div>
                  <h3 class="text-base font-bold text-slate-900 dark:text-white mb-2">
                    {f.title}
                  </h3>
                  <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed font-normal">
                    {f.description}
                  </p>
                </div>
                <div class="pt-4 mt-4 border-t border-slate-100 dark:border-slate-800">
                  <a
                    href="#contacto"
                    class="text-xs font-bold text-amber-600 dark:text-amber-400 hover:underline flex items-center gap-1"
                  >
                    <span>Consultar servicio</span> →
                  </a>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Sección de Mentoría y Capacitación Técnica Integrada -->
    <section class="py-16 bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800">
      <div class="max-w-7xl mx-auto px-6">
        <div class="grid lg:grid-cols-12 gap-10 items-center">
          <div class="lg:col-span-7 space-y-4">
            <span class="inline-block px-3.5 py-1 rounded-lg bg-amber-100 dark:bg-amber-950 border border-amber-200 dark:border-amber-800 text-amber-700 dark:text-amber-300 text-xs font-bold uppercase tracking-wider">
              Capacitación &amp; Transferencia de Conocimiento
            </span>
            <h2 class="text-3xl font-extrabold text-slate-900 dark:text-white">
              Mentoría Técnica 1-a-1 &amp; Formación de Equipos de Desarrollo
            </h2>
            <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed">
              No solo intervenimos sistemas; también transferimos estándares senior de ingeniería a tus programadores. Sesiones prácticas de code review, resolución de bloqueos en producción, diseño de arquitectura de software y adopción de TypeScript estricto, PostgreSQL y testing automatizado.
            </p>
            <div class="grid sm:grid-cols-2 gap-3 pt-2 text-xs text-slate-600 dark:text-slate-400 font-medium">
              <div class="flex items-center gap-2">
                <span class="text-amber-500 font-bold">✓</span> Code reviews en vivo de proyectos reales
              </div>
              <div class="flex items-center gap-2">
                <span class="text-amber-500 font-bold">✓</span> Limpieza de deuda técnica y refactorización
              </div>
              <div class="flex items-center gap-2">
                <span class="text-amber-500 font-bold">✓</span> Pruebas unitarias e integración con Vitest
              </div>
              <div class="flex items-center gap-2">
                <span class="text-amber-500 font-bold">✓</span> Acompañamiento a CTOs y líderes técnicos
              </div>
            </div>
          </div>

          <div class="lg:col-span-5">
            <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 space-y-4">
              <h4 class="text-sm font-bold text-slate-900 dark:text-white uppercase tracking-wider font-mono">
                Modalidades de Consultoría
              </h4>
              <div class="space-y-2 text-xs">
                <div class="p-3 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
                  <div class="font-bold text-amber-600 dark:text-amber-400">Diagnóstico Puntual / Auditoría</div>
                  <p class="text-slate-500 dark:text-slate-400 text-[11px]">Revisión integral de código y arquitectura con reporte escrito de hallazgos y prioridades.</p>
                </div>
                <div class="p-3 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
                  <div class="font-bold text-amber-600 dark:text-amber-400">Bolsa de Horas de Ingeniería</div>
                  <p class="text-slate-500 dark:text-slate-400 text-[11px]">Acompañamiento continuo, resolución de bugs críticos e integración de APIs (ERP, WhatsApp, Pasarelas).</p>
                </div>
                <div class="p-3 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
                  <div class="font-bold text-amber-600 dark:text-amber-400">Mentoría Técnica Personalizada</div>
                  <p class="text-slate-500 dark:text-slate-400 text-[11px]">Sesiones individuales en vivo para acelerar la madurez técnica de desarrolladores.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Preguntas Frecuentes Reales & Garantías Blindadas -->
    <FaqSection />

    <!-- Formulario de Captura de Leads Dedicado -->
    <ContactSection
      defaultService="Consultoría Técnica"
    />
  </main>

  <Footer />
</Layout>
