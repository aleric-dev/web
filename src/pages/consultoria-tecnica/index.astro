---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import AuditPillars from "../../components/AuditPillars.astro";
import ContactSection from "../../components/ContactSection.astro";
import Footer from "../../components/Footer.astro";

const consultingServices = [
  {
    icon: "🔍",
    title: "Auditoría de Código & Deuda Técnica",
    description:
      "Revisión minuciosa para detectar malas prácticas, problemas de arquitectura y cuellos de botella.",
  },
  {
    icon: "🩹",
    title: "Rescate de Proyectos Legacy",
    description:
      "Saneamiento y recuperación de aplicaciones abandonadas o con errores críticos para ponerlas operativas.",
  },
  {
    icon: "🛡️",
    title: "Inspección de Proveedores Externos",
    description:
      "Evaluación técnica imparcial del trabajo entregado por agencias o freelancers contratados.",
  },
  {
    icon: "🚀",
    title: "Optimización de Desempeño & SQL",
    description:
      "Tuning de consultas SQL/NoSQL, indexación y estrategias de almacenamiento en caché con Redis.",
  },
  {
    icon: "🔒",
    title: "Auditoría de Seguridad (OWASP)",
    description:
      "Escaneo de fallos de seguridad, fuga de credenciales y desconfiguración de servidores.",
  },
  {
    icon: "🏛️",
    title: "Asesoría CTO as a Service",
    description:
      "Dirección técnica senior para toma de decisiones de stack, arquitectura cloud y contratación.",
  },
  {
    icon: "☁️",
    title: "Migración & Optimización Cloud",
    description:
      "Transición eficiente a servicios en AWS, GCP o VPS optimizando costos y escalabilidad.",
  },
  {
    icon: "📋",
    title: "Buenas Prácticas & Pipelines CI/CD",
    description:
      "Implementación de integración continua, pruebas automatizadas y estándares de código.",
  },
];
---

<Layout
  title="Consultoría & Auditoría Técnica Senior | Aleric.dev"
  description="Evaluamos, diagnosticamos y saneamos proyectos de software. Auditoría de código, rescate de plataformas legacy e inspección de proveedores externos."
>
  <Navbar />

  <main
    class="pt-24 bg-slate-50 dark:bg-slate-950 transition-colors duration-300"
  >
    <!-- Hero Especializado Consultoría Técnica -->
    <section
      id="hero"
      class="py-16 md:py-24 relative border-b border-slate-200 dark:border-slate-800"
    >
      <div
        class="max-w-7xl mx-auto px-6 grid lg:grid-cols-12 gap-12 items-center"
      >
        <div class="lg:col-span-7 space-y-6">
          <span
            class="inline-flex items-center gap-2 rounded-lg border border-amber-200 dark:border-amber-900 bg-amber-50 dark:bg-amber-950/80 px-3.5 py-1.5 text-xs font-bold text-amber-700 dark:text-amber-300"
          >
            🛡️ Para CTOs, Fundadores &amp; Líderes de Tecnología
          </span>

          <h1
            class="text-4xl sm:text-5xl lg:text-6xl font-black text-slate-900 dark:text-white tracking-tight leading-tight"
          >
            Consultoría Técnica Senior &amp; <span
              class="text-amber-600 dark:text-amber-400"
              >Auditoría de Código</span
            >
          </h1>

          <p class="text-slate-600 dark:text-slate-300 text-lg leading-relaxed">
            ¿Tu software está lento, fallando o estancado? Diagnosticamos la
            causa raíz de los problemas técnicos y te entregamos un plan de
            acción claro e imparcial.
          </p>

          <div class="flex flex-col sm:flex-row items-center gap-4 pt-2">
            <a
              href="#contacto"
              class="w-full sm:w-auto px-7 py-3.5 rounded-xl bg-amber-600 hover:bg-amber-700 text-white font-bold text-xs uppercase tracking-wider shadow-sm transition flex items-center justify-center"
            >
              Solicitar Auditoría / Diagnóstico
            </a>
            <a
              href="/"
              class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 font-bold text-xs border border-slate-300 dark:border-slate-800 hover:bg-slate-100 dark:hover:bg-slate-800 transition flex items-center justify-center"
            >
              ← Volver al Inicio
            </a>
          </div>
        </div>

        <!-- Audit Scorecard Dashboard Component (Componente Modular) -->
        <div class="lg:col-span-5">
          <AuditPillars />
        </div>
      </div>
    </section>

    <!-- Catálogo de Servicios Consultoría -->
    <section id="beneficios" class="scroll-mt-20 py-16 bg-slate-50 dark:bg-slate-950">

      <div class="max-w-7xl mx-auto px-6">
        <div class="text-center max-w-2xl mx-auto mb-14">
          <h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-3">
            Servicios de Consultoría &amp; Auditoría
          </h2>
          <p class="text-slate-600 dark:text-slate-400 text-sm">
            Transparencia, diagnóstico imparcial y soluciones de ingeniería
            comprobadas.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          {
            consultingServices.map((f) => (
              <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 flex flex-col justify-between hover:border-amber-400 transition">
                <div>
                  <div class="text-2xl mb-3 p-2.5 rounded-xl bg-amber-50 dark:bg-amber-950/60 w-fit">
                    {f.icon}
                  </div>
                  <h3 class="text-base font-bold text-slate-900 dark:text-white mb-2">
                    {f.title}
                  </h3>
                  <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed font-normal">
                    {f.description}
                  </p>
                </div>
                <div class="pt-4 mt-4 border-t border-slate-100 dark:border-slate-800">
                  <a
                    href="#contacto"
                    class="text-xs font-bold text-amber-600 dark:text-amber-400 hover:underline flex items-center gap-1"
                  >
                    <span>Solicitar auditoría</span> →
                  </a>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Formulario de Captura de Leads Dedicado -->
    <ContactSection defaultService="Consultoría & Auditoría Técnica Senior" />
  </main>

  <Footer />
</Layout>
