---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import ContactSection from '../../components/ContactSection.astro';
import Footer from '../../components/Footer.astro';

const automationServices = [
  {
    icon: '💬',
    title: 'Bots de WhatsApp Cloud API (Oficial)',
    description: 'Atención automática de clientes, respuestas frecuentes y calificación de leads por WhatsApp las 24 horas del día.',
  },
  {
    icon: '⚡',
    title: 'Flujos Complejos en n8n & Make',
    description: 'Orquestación de procesos entre aplicaciones (Google Sheets, CRMs, Email, Webhooks) sin intervención humana.',
  },
  {
    icon: '👥',
    title: 'Integración Chatwoot Multiagente',
    description: 'Plataforma centralizada para que múltiples asesores gestionen canales de WhatsApp, Telegram y redes desde un solo lugar.',
  },
  {
    icon: '🐍',
    title: 'Scripts Python & Web Scraping',
    description: 'Extracción automatizada de datos, monitoreo de precios y procesamiento masivo de información pública.',
  },
  {
    icon: '🔄',
    title: 'Sincronización Automática CRM / ERP',
    description: 'Conexión en tiempo real para mantener inventarios, ventas y contactos sincronizados entre sistemas.',
  },
  {
    icon: '📈',
    title: 'Automatización de Reportes & Alertas',
    description: 'Envíos periódicos automatizados de informes de gestión a correo electrónico o canales de Telegram/Slack.',
  },
  {
    icon: '📑',
    title: 'Automatización de Facturación & Cobros',
    description: 'Envío automático de recordatorios de pago por WhatsApp y generación inmediata de recibos o comprobantes.',
  },
  {
    icon: '🔔',
    title: 'Webhooks & Notificaciones en Tiempo Real',
    description: 'Recepción instantánea de eventos desde plataformas de pago o formularios para disparar flujos inmediatos.',
  },
];
---

<Layout
  title="Automatización de Procesos & WhatsApp API | Aleric.dev"
  description="Conectamos tus sistemas y automatizamos la atención comercial por WhatsApp. Flujos en n8n, bots oficiales y optimización operativa sin fricción."
>
  <Navbar />

  <main class="pt-28 bg-slate-900/40 dark:bg-slate-950 transition-colors duration-300">
    <!-- Hero Especializado Automatización -->
    <section id="hero" class="py-16 relative overflow-hidden">
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[400px] bg-emerald-600/15 rounded-full blur-[140px] pointer-events-none"></div>

      <div class="max-w-7xl mx-auto px-6 relative z-10 text-center">
        <span class="inline-flex items-center gap-2 rounded-full border border-emerald-500/40 bg-emerald-500/10 px-4 py-2 text-xs font-mono font-bold text-emerald-600 dark:text-emerald-300 mb-6">
          ⚡ Para Equipos de Operaciones &amp; Ventas
        </span>

        <h1 class="text-4xl sm:text-6xl font-extrabold text-slate-900 dark:text-white tracking-tight max-w-4xl mx-auto leading-tight mb-6">
          Automatización Operativa &amp; <span class="bg-gradient-to-r from-emerald-500 via-teal-500 to-cyan-500 bg-clip-text text-transparent">Bots de WhatsApp API</span>
        </h1>

        <p class="text-slate-600 dark:text-slate-300 text-lg sm:text-xl max-w-2xl mx-auto leading-relaxed mb-10">
          Elimina tareas manuales repetitivas. Conectamos tus ventas, CRM e inventarios para trabajar automáticamente 24 horas al día, 7 días a la semana.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="#contacto"
            class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-gradient-to-r from-emerald-500 to-teal-600 text-white font-extrabold text-xs uppercase tracking-wider shadow-xl shadow-emerald-950/30 hover:scale-105 transition cursor-pointer flex items-center justify-center"
          >
            Cotizar Automatización de Procesos
          </a>
          <a
            href="/"
            class="w-full sm:w-auto px-7 py-4 rounded-2xl bg-slate-100 dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-white font-bold text-xs border border-slate-200 dark:border-slate-800 transition flex items-center justify-center"
          >
            ← Volver al Inicio
          </a>
        </div>
      </div>
    </section>

    <!-- Catálogo Especializado de Servicios Automatización (8 Tarjetas) -->
    <section id="beneficios" class="py-16 bg-slate-100/80 dark:bg-slate-900/60 border-t border-slate-200 dark:border-slate-800">
      <div class="max-w-7xl mx-auto px-6">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-3">Catálogo de Soluciones de Automatización</h2>
          <p class="text-slate-600 dark:text-slate-400 text-sm">Elimina errores humanos e incrementa la velocidad de respuesta de tu empresa.</p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-7">
          {automationServices.map((f) => (
            <div class="p-7 rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950/80 shadow-md hover:shadow-xl hover:-translate-y-1 transition duration-300 flex flex-col justify-between">
              <div>
                <div class="text-3xl mb-4 p-3 rounded-2xl bg-emerald-500/10 w-fit">{f.icon}</div>
                <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">{f.title}</h3>
                <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed font-normal">{f.description}</p>
              </div>
              <div class="pt-5 mt-4 border-t border-slate-100 dark:border-slate-900">
                <a href="#contacto" class="text-xs font-bold text-emerald-600 dark:text-emerald-400 hover:underline flex items-center gap-1">
                  <span>Cotizar flujo</span> →
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Formulario de Captura de Leads Dedicado con Selección Automática -->
    <ContactSection defaultService="Automatización de Operaciones & WhatsApp API" />
  </main>

  <Footer />
</Layout>
