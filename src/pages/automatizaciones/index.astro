---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import WhatsAppBenefits from "../../components/WhatsAppBenefits.astro";
import ContactSection from "../../components/ContactSection.astro";
import Footer from "../../components/Footer.astro";

const automationServices = [
  {
    icon: "💬",
    title: "Bots de WhatsApp Cloud API (Oficial)",
    description:
      "Atención automática de clientes, respuestas frecuentes y calificación de leads por WhatsApp 24/7.",
  },
  {
    icon: "⚡",
    title: "Flujos Complejos en n8n & Make",
    description:
      "Orquestación de procesos entre aplicaciones (Google Sheets, CRMs, Email, Webhooks) sin fricción.",
  },
  {
    icon: "👥",
    title: "Integración Chatwoot Multiagente",
    description:
      "Plataforma centralizada para que múltiples asesores gestionen canales de WhatsApp y redes en un solo lugar.",
  },
  {
    icon: "🐍",
    title: "Scripts Python & Web Scraping",
    description:
      "Extracción automatizada de datos, monitoreo de precios y procesamiento masivo de información.",
  },
  {
    icon: "🔄",
    title: "Sincronización CRM / ERP",
    description:
      "Conexión en tiempo real para mantener inventarios, ventas y contactos sincronizados entre sistemas.",
  },
  {
    icon: "📈",
    title: "Reportes & Alertas Automáticas",
    description:
      "Envíos periódicos automatizados de informes de gestión a correo o canales de Telegram/Slack.",
  },
  {
    icon: "📑",
    title: "Facturación & Recordatorios",
    description:
      "Envío automático de recordatorios de pago por WhatsApp y generación inmediata de recibos.",
  },
  {
    icon: "🔔",
    title: "Webhooks & Eventos Instantáneos",
    description:
      "Recepción en tiempo real de eventos desde plataformas de pago o formularios para disparar flujos.",
  },
];

const flowSteps = [
  {
    step: "1. Evento Disparador",
    detail: "Nuevo Lead en Formulario / Pago Recibido",
  },
  {
    step: "2. Orquestador n8n",
    detail: "Validación de datos y enriquecimiento en CRM",
  },
  {
    step: "3. WhatsApp Cloud API",
    detail: "Envío inmediato de mensaje oficial interactivo",
  },
  {
    step: "4. Inbox Multiagente",
    detail: "Asignación a asesor humano si requiere cierre",
  },
];
---

<Layout
  title="Automatización de Procesos & WhatsApp API | Aleric.dev"
  description="Conectamos tus sistemas y automatizamos la atención comercial por WhatsApp. Flujos en n8n, bots oficiales y optimización operativa sin fricción."
>
  <Navbar />

  <main
    class="pt-24 bg-slate-50 dark:bg-slate-950 transition-colors duration-300"
  >
    <!-- Hero Especializado Automatizaciones -->
    <section
      id="hero"
      class="py-16 md:py-24 relative border-b border-slate-200 dark:border-slate-800"
    >
      <div
        class="max-w-7xl mx-auto px-6 grid lg:grid-cols-12 gap-12 items-center"
      >
        <div class="lg:col-span-7 space-y-6">
          <span
            class="inline-flex items-center gap-2 rounded-lg border border-emerald-200 dark:border-emerald-900 bg-emerald-50 dark:bg-emerald-950/80 px-3.5 py-1.5 text-xs font-bold text-emerald-700 dark:text-emerald-300"
          >
            ⚡ Para Equipos de Operaciones &amp; Ventas
          </span>

          <h1
            class="text-4xl sm:text-5xl lg:text-6xl font-black text-slate-900 dark:text-white tracking-tight leading-tight"
          >
            Automatización Operativa &amp; <span
              class="text-emerald-600 dark:text-emerald-400"
              >Bots de WhatsApp API</span
            >
          </h1>

          <p class="text-slate-600 dark:text-slate-300 text-lg leading-relaxed">
            Elimina tareas manuales repetitivas. Conectamos tus ventas, CRM e
            inventarios para trabajar automáticamente 24 horas al día, 7 días a
            la semana sin margen de error.
          </p>

          <div class="flex flex-col sm:flex-row items-center gap-4 pt-2">
            <a
              href="#contacto"
              class="w-full sm:w-auto px-7 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs uppercase tracking-wider shadow-sm transition flex items-center justify-center"
            >
              Cotizar Automatización de Procesos
            </a>
            <a
              href="/"
              class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 font-bold text-xs border border-slate-300 dark:border-slate-800 hover:bg-slate-100 dark:hover:bg-slate-800 transition flex items-center justify-center"
            >
              ← Volver al Inicio
            </a>
          </div>
        </div>

        <!-- Workflow Diagram Visual Component -->
        <div class="lg:col-span-5">
          <div
            class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm space-y-3"
          >
            <div
              class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-800"
            >
              <span class="text-xs font-bold text-slate-900 dark:text-white"
                >Flujo Operativo Automatizado</span
              >
              <span
                class="text-[10px] font-mono font-bold text-emerald-600 dark:text-emerald-400"
                >Sin Fricción</span
              >
            </div>

            <div class="space-y-2.5">
              {
                flowSteps.map((node) => (
                  <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-xs">
                    <div class="font-bold text-emerald-600 dark:text-emerald-400 mb-0.5">
                      {node.step}
                    </div>
                    <div class="text-slate-600 dark:text-slate-300 font-medium">
                      {node.detail}
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Beneficios WhatsApp API Oficial (Componente Modular) -->
    <WhatsAppBenefits />

    <!-- Catálogo de Servicios Automatización -->
    <section id="beneficios" class="scroll-mt-20 py-16 bg-slate-50 dark:bg-slate-950">

      <div class="max-w-7xl mx-auto px-6">
        <div class="text-center max-w-2xl mx-auto mb-14">
          <h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-3">
            Soluciones de Automatización
          </h2>
          <p class="text-slate-600 dark:text-slate-400 text-sm">
            Elimina errores humanos e incrementa la velocidad de respuesta de tu
            empresa.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          {
            automationServices.map((f) => (
              <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 flex flex-col justify-between hover:border-emerald-400 transition">
                <div>
                  <div class="text-2xl mb-3 p-2.5 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 w-fit">
                    {f.icon}
                  </div>
                  <h3 class="text-base font-bold text-slate-900 dark:text-white mb-2">
                    {f.title}
                  </h3>
                  <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed font-normal">
                    {f.description}
                  </p>
                </div>
                <div class="pt-4 mt-4 border-t border-slate-100 dark:border-slate-800">
                  <a
                    href="#contacto"
                    class="text-xs font-bold text-emerald-600 dark:text-emerald-400 hover:underline flex items-center gap-1"
                  >
                    <span>Consultar automatización</span> →

                  </a>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Formulario de Captura de Leads Dedicado -->
    <ContactSection
      defaultService="Automatización de Operaciones & WhatsApp API"
    />
  </main>

  <Footer />
</Layout>
