---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import WhatsAppBenefits from "../../components/WhatsAppBenefits.astro";
import WhyUsSection from "../../components/WhyUsSection.astro";
import ContactSection from "../../components/ContactSection.astro";
import Footer from "../../components/Footer.astro";

const automationServices = [
  {
    icon: "💬",
    title: "Rescate de Conversaciones Perdidas",
    description:
      "Responde a cada cliente en menos de 2 segundos. Evita que prospectos calificados se vayan con tu competencia por falta de tiempo.",
  },
  {
    icon: "⚡",
    title: "Cotizaciones Inmediatas en WhatsApp",
    description:
      "El cliente responde un par de preguntas guiadas y recibe su cotización estimada al instante, listo para cerrar con tu asesor.",
  },
  {
    icon: "💰",
    title: "Cobranzas y Recordatorios de Pago",
    description:
      "Avisos automáticos amables con link directo de pago (PSE, transferencias) antes y el día del vencimiento. Reduce tu cartera morosa sin desgaste.",
  },
  {
    icon: "👥",
    title: "Bandeja Multiagente para tu Equipo",
    description:
      "Conecta a todos tus asesores al mismo número oficial de WhatsApp con Chatwoot. Cada vendedor atiende sus propios chats sin prestarse el celular.",
  },
  {
    icon: "🔄",
    title: "Conexión de Sistemas sin Fricción (n8n)",
    description:
      "Orquestamos tus flujos para que los leads de formularios, compras o mensajes se guarden solos en tu base de datos o CRM.",
  },
  {
    icon: "📑",
    title: "Generación de Recibos y Confirmaciones",
    description:
      "Envío instantáneo de comprobantes, recibos de pago o confirmaciones de agendamiento por WhatsApp tan pronto el cliente paga.",
  },
  {
    icon: "⏰",
    title: "Seguimiento Automático de Prospectos",
    description:
      "Mensajes de reactivación a los prospectos que dejaron de contestar, recordándoles su cotización y facilitando la decisión de compra.",
  },
  {
    icon: "🛡️",
    title: "Conexión Oficial Meta (Cero Bloqueos)",
    description:
      "Implementación con WhatsApp Cloud API oficial. Cero riesgos de que Meta bloquee o suspenda el número de tu empresa.",
  },
];

const flowSteps = [
  {
    step: "1. Llega un Mensaje a Cualquier Hora",
    detail: "Un cliente escribe un domingo o a las 11 PM preguntando precios o disponibilidad.",
  },
  {
    step: "2. Respuesta Inmediata & Guiada",
    detail: "El bot oficial responde con botones y opciones claras para atender la necesidad en segundos.",
  },
  {
    step: "3. Cotización o Cobro Automático",
    detail: "Se genera el presupuesto estimado o se entrega el link directo de pago sin intervención humana.",
  },
  {
    step: "4. Pase Inteligente al Asesor Humano",
    detail: "Si el cliente solicita atención personalizada o ya está listo para pagar, un asesor continúa la conversación.",
  },
];
---

<Layout
  title="Aleric.dev | Automatización de WhatsApp, Cobranzas & Atención al Cliente 24/7"
  description="Automatiza la atención comercial de WhatsApp, cotizaciones y cobranzas. Recupera clientes perdidos y elimina tareas repetitivas con herramientas oficiales."
>
  <Navbar />

  <main
    class="pt-20 bg-slate-50 dark:bg-slate-950 transition-colors duration-300"
  >
    <!-- Hero Especializado Automatizaciones -->
    <section
      id="hero"
      class="pt-3 pb-12 md:pt-5 md:pb-14 relative border-b border-slate-200 dark:border-slate-800"
    >
      <div
        class="max-w-7xl mx-auto px-6 grid lg:grid-cols-12 gap-12 items-center"
      >
        <div class="lg:col-span-7 space-y-6">
          <span
            class="inline-flex items-center gap-2 rounded-lg border border-emerald-200 dark:border-emerald-900 bg-emerald-50 dark:bg-emerald-950/80 px-3.5 py-1.5 text-xs font-bold text-emerald-700 dark:text-emerald-300"
          >
            ⚡ Atención Inmediata &amp; Cero Ventas Perdidas
          </span>

          <h1
            class="text-4xl sm:text-5xl lg:text-6xl font-black text-slate-900 dark:text-white tracking-tight leading-tight"
          >
            No pierdas más clientes en WhatsApp por <span
              class="text-emerald-600 dark:text-emerald-400"
              >demorarte en responder</span
            >
          </h1>

          <p class="text-slate-600 dark:text-slate-300 text-lg leading-relaxed">
            ¿Tu equipo se satura de chats, no alcanza a contestar a tiempo o se le olvidan los seguimientos? Automatizamos la <strong>atención de clientes, las cotizaciones y los cobros por WhatsApp 24/7</strong> para que tu negocio nunca duerma y ningún prospecto quede desatendido.
          </p>

          <div class="flex flex-col sm:flex-row items-center gap-4 pt-2">
            <a
              href="#contacto"
              class="w-full sm:w-auto px-7 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs uppercase tracking-wider shadow-sm transition flex items-center justify-center"
            >
              Automatizar Mi WhatsApp &amp; Procesos
            </a>
            <a
              href="/"
              class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 font-bold text-xs border border-slate-300 dark:border-slate-800 hover:bg-slate-100 dark:hover:bg-slate-800 transition flex items-center justify-center"
            >
              ← Volver al Inicio
            </a>
          </div>
        </div>

        <!-- Workflow Diagram Visual Component -->
        <div class="lg:col-span-5">
          <div
            class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm space-y-3"
          >
            <div
              class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-800"
            >
              <span class="text-xs font-bold text-slate-900 dark:text-white"
                >Cómo Funciona en la Vida Real</span
              >
              <span
                class="text-[10px] font-mono font-bold text-emerald-600 dark:text-emerald-400"
                >Sin Fricción</span
              >
            </div>

            <div class="space-y-2.5">
              {
                flowSteps.map((node) => (
                  <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-xs">
                    <div class="font-bold text-emerald-600 dark:text-emerald-400 mb-0.5">
                      {node.step}
                    </div>
                    <div class="text-slate-600 dark:text-slate-300 font-medium">
                      {node.detail}
                    </div>
                  </div>
                ))
              }
            </div>

            <div class="p-3 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-900 text-xs text-emerald-900 dark:text-emerald-200">
              💡 <strong>Herramientas que usamos:</strong> WhatsApp Cloud API oficial de Meta (sin bloqueos), orquestadores visuales como n8n y plataformas multiagente como Chatwoot.
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección Especial: Dolor de WhatsApp & Cobranzas -->
    <section class="py-16 bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800">
      <div class="max-w-7xl mx-auto px-6">
        <div class="text-center max-w-3xl mx-auto mb-14 space-y-3">
          <span class="inline-block px-3.5 py-1 rounded-lg bg-emerald-100 dark:bg-emerald-950 border border-emerald-200 dark:border-emerald-800 text-emerald-700 dark:text-emerald-300 text-xs font-bold uppercase tracking-wider">
            Solución a Problemas Frecuentes
          </span>
          <h2 class="text-3xl font-extrabold text-slate-900 dark:text-white">
            ¿Cuántas ventas se te están escapando por falta de tiempo?
          </h2>
          <p class="text-slate-600 dark:text-slate-400 text-sm sm:text-base">
            El 70% de las ventas en Latinoamérica inician en WhatsApp, pero la mayoría de empresas fallan en la rapidez y el seguimiento.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          <div class="p-7 rounded-2xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 space-y-3">
            <div class="w-12 h-12 rounded-xl bg-emerald-100 dark:bg-emerald-900/60 text-emerald-700 dark:text-emerald-300 flex items-center justify-center text-2xl font-bold">
              🕒
            </div>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white">Demoras que Matan Ventas</h3>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
              Tardar más de 10 minutos en responder a un prospecto nuevo hace que busque a tu competencia. Con nuestros flujos, la respuesta inicial tarda menos de 2 segundos.
            </p>
          </div>

          <div class="p-7 rounded-2xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 space-y-3">
            <div class="w-12 h-12 rounded-xl bg-emerald-100 dark:bg-emerald-900/60 text-emerald-700 dark:text-emerald-300 flex items-center justify-center text-2xl font-bold">
              📑
            </div>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white">Cotizaciones Inmediatas</h3>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
              En vez de hacer esperar horas al cliente para enviarle un presupuesto básico, el sistema recopila los datos y le envía la cotización en el mismo chat.
            </p>
          </div>

          <div class="p-7 rounded-2xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 space-y-3">
            <div class="w-12 h-12 rounded-xl bg-emerald-100 dark:bg-emerald-900/60 text-emerald-700 dark:text-emerald-300 flex items-center justify-center text-2xl font-bold">
              💳
            </div>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white">Cobranzas Sin Desgaste</h3>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
              Cobrar a mano es incómodo y consume horas. El sistema envía recordatorios automáticos y amigables con botón de pago, mejorando el flujo de caja de tu empresa.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Beneficios WhatsApp API Oficial (Componente Modular) -->
    <WhatsAppBenefits />

    <!-- Catálogo de Servicios Automatización -->
    <section id="beneficios" class="scroll-mt-20 py-16 bg-slate-50 dark:bg-slate-950">
      <div class="max-w-7xl mx-auto px-6">
        <div class="text-center max-w-2xl mx-auto mb-14">
          <h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-3">
            Procesos que Automatizamos para tu Negocio
          </h2>
          <p class="text-slate-600 dark:text-slate-400 text-sm">
            Deja las tareas monótonas en manos de la tecnología y enfoca a tu equipo en vender.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          {
            automationServices.map((f) => (
              <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 flex flex-col justify-between hover:border-emerald-400 transition shadow-sm">
                <div>
                  <div class="text-2xl mb-3 p-2.5 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 w-fit">
                    {f.icon}
                  </div>
                  <h3 class="text-base font-bold text-slate-900 dark:text-white mb-2">
                    {f.title}
                  </h3>
                  <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed font-normal">
                    {f.description}
                  </p>
                </div>
                <div class="pt-4 mt-4 border-t border-slate-100 dark:border-slate-800">
                  <a
                    href="#contacto"
                    class="text-xs font-bold text-emerald-600 dark:text-emerald-400 hover:underline flex items-center gap-1"
                  >
                    <span>Cotizar esta automatización</span> →
                  </a>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Metodología de Trabajo & Garantías de Ingeniería (Componente Unificado) -->
    <WhyUsSection />

    <!-- Formulario de Captura de Leads Dedicado -->
    <ContactSection
      defaultService="Automatización de Operaciones & WhatsApp API"
    />
  </main>

  <Footer />
</Layout>
