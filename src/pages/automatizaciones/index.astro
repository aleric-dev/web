---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import VisualChatPreview from "../../components/VisualChatPreview.astro";
import WhatsAppBenefits from "../../components/WhatsAppBenefits.astro";
import FaqSection from "../../components/FaqSection.astro";
import ContactSection from "../../components/ContactSection.astro";
import Footer from "../../components/Footer.astro";

const automationServices = [
  {
    icon: "💬",
    title: "Rescate de Conversaciones Perdidas",
    description:
      "Responde a cada cliente en menos de 2 segundos. Evita que prospectos calificados se vayan con tu competencia por falta de tiempo.",
  },
  {
    icon: "⚡",
    title: "Cotizaciones Inmediatas en WhatsApp",
    description:
      "El cliente responde un par de preguntas guiadas y recibe su cotización estimada al instante, listo para cerrar con tu asesor.",
  },
  {
    icon: "💰",
    title: "Cobranzas y Recordatorios de Pago",
    description:
      "Avisos automáticos amables con link directo de pago (PSE, transferencias) antes y el día del vencimiento. Reduce tu cartera morosa sin desgaste.",
  },
  {
    icon: "👥",
    title: "Bandeja Multiagente para tu Equipo",
    description:
      "Conecta a todos tus asesores al mismo número oficial de WhatsApp en una sola plataforma. Cada vendedor atiende sus propios chats sin prestarse el celular.",
  },
  {
    icon: "🔄",
    title: "Conexión de Sistemas sin Fricción",
    description:
      "Orquestamos tus flujos para que los leads de formularios, compras o mensajes se sincronicen solos en tu base de datos o CRM.",
  },
  {
    icon: "📑",
    title: "Generación de Recibos y Confirmaciones",
    description:
      "Envío instantáneo de comprobantes, recibos de pago o confirmaciones de agendamiento por WhatsApp tan pronto el cliente paga.",
  },
  {
    icon: "⏰",
    title: "Seguimiento Automático de Prospectos",
    description:
      "Mensajes de reactivación a los prospectos que dejaron de contestar, recordándoles su cotización y facilitando la decisión de compra.",
  },
  {
    icon: "🛡️",
    title: "Conexión Oficial WhatsApp (Cero Bloqueos)",
    description:
      "Implementación con WhatsApp Cloud API oficial. Cero riesgos de que bloqueen o suspendan el número de tu empresa.",
  },
];

const flowSteps = [
  {
    step: "1. Llega un Mensaje a Cualquier Hora",
    detail: "Un cliente escribe un domingo o a las 11 PM preguntando precios o disponibilidad.",
  },
  {
    step: "2. Respuesta Inmediata & Guiada",
    detail: "El bot oficial responde con botones y opciones claras para atender la necesidad en segundos.",
  },
  {
    step: "3. Cotización o Cobro Automático",
    detail: "Se genera el presupuesto estimado o se entrega el link directo de pago sin intervención humana.",
  },
  {
    step: "4. Pase Inteligente al Asesor Humano",
    detail: "Si el cliente solicita atención personalizada o ya está listo para pagar, un asesor continúa la conversación.",
  },
];
---

<Layout
  title="Aleric.dev | Ventas & Atención Comercial por WhatsApp 24/7"
  description="Automatiza la atención comercial de WhatsApp, cotizaciones guiadas y cobranzas. Vende las 24 horas sin clientes esperando."
>
  <Navbar />

  <main
    class="bg-slate-50 dark:bg-slate-950 transition-colors duration-300"
  >
    <!-- Hero Especializado Automatizaciones -->
    <section
      id="hero"
      class="pt-24 sm:pt-32 pb-12 md:pb-16 relative border-b border-slate-200 dark:border-slate-800 overflow-hidden"
    >
      <div
        class="max-w-7xl mx-auto px-6 grid lg:grid-cols-12 gap-12 items-center relative z-10"
      >
        <div class="lg:col-span-7 space-y-6 text-center lg:text-left flex flex-col items-center lg:items-start">
          <span
            class="inline-flex items-center gap-2 rounded-lg border border-emerald-200 dark:border-emerald-900 bg-emerald-50 dark:bg-emerald-950/80 px-3.5 py-1.5 text-xs font-bold text-emerald-700 dark:text-emerald-300"
          >
            ⚡ Atención Inmediata &amp; Cero Ventas Perdidas
          </span>

          <h1
            class="text-[2.5rem] sm:text-5xl lg:text-6xl font-black text-slate-900 dark:text-white tracking-tight leading-[1.15]"
          >
            Ventas y atención comercial automática por <span
              class="text-emerald-600 dark:text-emerald-400"
              >WhatsApp las 24 horas</span
            >
          </h1>

          <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed max-w-xl mx-auto lg:mx-0">
            Respuestas inmediatas en 2 segundos, cotizaciones guiadas y cobros automáticos sin clientes esperando.
          </p>

          <!-- Imagen Real de Producto en Mobile (< lg) — Integrada al flujo narrativo antes de los botones -->
          <div class="block lg:hidden pt-1 pb-1 w-full max-w-lg mx-auto text-left">
            <div class="relative rounded-2xl overflow-hidden shadow-xl border border-slate-200/90 dark:border-slate-800/90 bg-white dark:bg-slate-900 group">
              <img
                src="/assets/services/solution-automation.webp"
                alt="Automatización comercial de WhatsApp Aleric.dev"
                class="w-full h-auto object-cover"
                width="640"
                height="480"
                loading="eager"
              />
              <div class="absolute bottom-2.5 left-2.5 bg-white/95 dark:bg-slate-900/95 backdrop-blur-xs border border-slate-200 dark:border-slate-800 rounded-lg px-2.5 py-1 text-[11px] font-bold text-slate-800 dark:text-slate-200 shadow-xs flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                <span>WhatsApp Cloud API Oficial · Cero Bloqueos</span>
              </div>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3.5 pt-2 w-full sm:w-auto">
            <a
              href="#contacto"
              class="w-full sm:w-auto h-11 px-6 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs uppercase tracking-wider shadow-xs transition flex items-center justify-center"
            >
              Cotizar WhatsApp Comercial
            </a>
            <a
              href="/"
              class="w-full sm:w-auto h-11 px-5 rounded-xl bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 font-bold text-xs border border-slate-300 dark:border-slate-800 hover:bg-slate-100 dark:hover:bg-slate-800 transition flex items-center justify-center"
            >
              ← Volver al Inicio
            </a>
          </div>
        </div>

        <!-- Visual Showcase Imagen Real en Desktop (Oculta en Mobile) -->
        <div class="hidden lg:block lg:col-span-5 w-full">
          <div class="relative w-full max-w-lg lg:max-w-none mx-auto select-none">
            <div class="relative rounded-3xl overflow-hidden shadow-2xl border border-slate-200/90 dark:border-slate-800/90 bg-white dark:bg-slate-900 group">
              <img
                src="/assets/services/solution-automation.webp"
                alt="Automatización comercial de WhatsApp Aleric.dev"
                class="w-full h-auto object-cover"
                width="640"
                height="480"
                loading="eager"
              />
            </div>
            <div class="hidden sm:flex absolute -bottom-4 -left-4 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md border border-slate-200 dark:border-slate-800 rounded-2xl p-3 shadow-xl items-center gap-3">
              <div class="w-8 h-8 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold text-sm">
                💬
              </div>
              <div>
                <p class="text-xs font-bold text-slate-900 dark:text-white">WhatsApp Cloud API</p>
                <p class="text-[10px] text-slate-500 dark:text-slate-400">Canal Oficial · Cero bloqueos</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección Especial: Dolor de WhatsApp & Cobranzas -->
    <section class="py-16 bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800">
      <div class="max-w-7xl mx-auto px-6">
        <div class="text-center max-w-4xl mx-auto mb-14">
          <h2 class="text-3xl sm:text-4xl lg:text-[2.75rem] font-black text-slate-900 dark:text-white tracking-tight leading-[1.15]">
            ¿Cuántas ventas se te están escapando por falta de tiempo?
          </h2>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          <div class="p-7 rounded-2xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 space-y-3">
            <div class="w-12 h-12 rounded-xl bg-emerald-100 dark:bg-emerald-900/60 text-emerald-700 dark:text-emerald-300 flex items-center justify-center text-2xl font-bold">
              🕒
            </div>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white">Demoras que Matan Ventas</h3>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
              Tardar más de 10 minutos en responder a un prospecto nuevo hace que busque a tu competencia. Con nuestros flujos, la respuesta inicial tarda menos de 2 segundos.
            </p>
          </div>

          <div class="p-7 rounded-2xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 space-y-3">
            <div class="w-12 h-12 rounded-xl bg-emerald-100 dark:bg-emerald-900/60 text-emerald-700 dark:text-emerald-300 flex items-center justify-center text-2xl font-bold">
              📑
            </div>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white">Cotizaciones Inmediatas</h3>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
              En vez de hacer esperar horas al cliente para enviarle un presupuesto básico, el sistema recopila los datos y le envía la cotización en el mismo chat.
            </p>
          </div>

          <div class="p-7 rounded-2xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 space-y-3">
            <div class="w-12 h-12 rounded-xl bg-emerald-100 dark:bg-emerald-900/60 text-emerald-700 dark:text-emerald-300 flex items-center justify-center text-2xl font-bold">
              💳
            </div>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white">Cobranzas Sin Desgaste</h3>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
              Cobrar a mano es incómodo y consume horas. El sistema envía recordatorios automáticos y amigables con botón de pago, mejorando el flujo de caja de tu empresa.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Beneficios WhatsApp API Oficial (Componente Modular) -->
    <WhatsAppBenefits />

    <!-- Catálogo de Servicios Automatización -->
    <section id="beneficios" class="scroll-mt-20 py-16 bg-slate-50 dark:bg-slate-950">
      <div class="max-w-7xl mx-auto px-6">
        <div class="text-center max-w-4xl mx-auto mb-14">
          <h2 class="text-3xl sm:text-4xl lg:text-[2.75rem] font-black text-slate-900 dark:text-white tracking-tight leading-[1.15]">
            Procesos que Automatizamos para tu Negocio
          </h2>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          {
            automationServices.map((f) => (
              <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 flex flex-col justify-between hover:border-emerald-400 transition shadow-sm">
                <div>
                  <div class="text-2xl mb-3 p-2.5 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 w-fit">
                    {f.icon}
                  </div>
                  <h3 class="text-base font-bold text-slate-900 dark:text-white mb-2">
                    {f.title}
                  </h3>
                  <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed font-normal">
                    {f.description}
                  </p>
                </div>
                <div class="pt-4 mt-4 border-t border-slate-100 dark:border-slate-800">
                  <a
                    href="#contacto"
                    class="text-xs font-bold text-emerald-600 dark:text-emerald-400 hover:underline flex items-center gap-1"
                  >
                    <span>Cotizar esta automatización</span> →
                  </a>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Preguntas Frecuentes Reales & Garantías Blindadas -->
    <FaqSection />

    <!-- Formulario de Captura de Leads Dedicado -->
    <ContactSection
      defaultService="Automatización de Operaciones & WhatsApp API"
    />
  </main>

  <Footer />
</Layout>
