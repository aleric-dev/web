---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const mentorshipPillars = [
  {
    icon: '🎓',
    title: 'Acompañamiento 1-a-1 Directo',
    description: 'Sesiones personalizadas en vivo para resolver dudas, revisar tu código real y acelerar tu aprendizaje sin rodeos.',
  },
  {
    icon: '💻',
    title: 'Stack Moderno & Demandado',
    description: 'Dominio de TypeScript estricto, React 19, NestJS, PostgreSQL, Prisma ORM, Redis y Tailwind CSS.',
  },
  {
    icon: '🏗️',
    title: 'Arquitectura Limpia & Testing',
    description: 'Aprende a estructurar proyectos escalables, desacoplados y con pruebas automatizadas (Jest/Vitest).',
  },
  {
    icon: '💼',
    title: 'Preparación para Roles Senior',
    description: 'Mejora tu nivel técnico para optar a mejores salarios, liderar equipos o cotizar proyectos como freelancer senior.',
  },
];
---

<Layout
  title="Consultoría & Mentoría Técnica Full Stack | Aleric.dev"
  description="Capacitación y mentoría 1-a-1 para desarrolladores y freelancers que buscan dominar el stack moderno: TypeScript, React, NestJS y PostgreSQL."
>
  <Navbar />

  <main class="pt-28 pb-20 bg-slate-950">
    <!-- Hero Especializado Mentoría -->
    <section class="py-16 relative overflow-hidden">
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[400px] bg-purple-600/15 rounded-full blur-[140px] pointer-events-none"></div>

      <div class="max-w-7xl mx-auto px-6 relative z-10 text-center">
        <span class="inline-flex items-center gap-2 rounded-full border border-purple-500/40 bg-purple-500/10 px-4 py-2 text-xs font-mono font-bold text-purple-300 mb-6">
          🎓 Para Developers, Freelancers &amp; Estudiantes
        </span>

        <h1 class="text-4xl sm:text-6xl font-extrabold text-white tracking-tight max-w-4xl mx-auto leading-tight mb-6">
          Mentoría Técnica 1-a-1 &amp; <span class="bg-gradient-to-r from-purple-400 via-pink-300 to-indigo-400 bg-clip-text text-transparent">Maestría Full Stack</span>
        </h1>

        <p class="text-slate-300 text-lg sm:text-xl max-w-2xl mx-auto leading-relaxed mb-10">
          Supera los bloqueos técnicos en tus proyectos. Te guiamos paso a paso en buenas prácticas de ingeniería, arquitectura limpia y código profesional.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <button
            type="button"
            data-trigger-whatsapp
            data-whatsapp-msg="Hola Aleric.dev, me interesa solicitar información sobre la mentoría técnica Full Stack 1-a-1."
            class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-gradient-to-r from-purple-600 to-indigo-600 text-white font-extrabold text-xs uppercase tracking-wider shadow-xl shadow-purple-950/50 hover:scale-105 transition cursor-pointer"
          >
            Consultar Programa por WhatsApp
          </button>
          <a
            href="/"
            class="w-full sm:w-auto px-7 py-4 rounded-2xl bg-slate-900 text-slate-300 hover:text-white font-bold text-xs border border-slate-800 transition flex items-center justify-center"
          >
            ← Volver al Orquestador
          </a>
        </div>
      </div>
    </section>

    <!-- Características -->
    <section class="py-16 bg-slate-900/60 border-t border-slate-800">
      <div class="max-w-7xl mx-auto px-6">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <h2 class="text-3xl font-bold text-white mb-3">Pilares de la Mentoría Técnica</h2>
          <p class="text-slate-400 text-sm">Enfoque 100% práctico sobre proyectos y situaciones de la vida real.</p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
          {mentorshipPillars.map((f) => (
            <div class="p-7 rounded-3xl border border-slate-800 bg-slate-950/80 shadow-xl">
              <div class="text-3xl mb-4">{f.icon}</div>
              <h3 class="text-lg font-bold text-white mb-2">{f.title}</h3>
              <p class="text-xs text-slate-300 leading-relaxed">{f.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA Final -->
    <section class="py-20 text-center">
      <div class="max-w-3xl mx-auto px-6 p-10 rounded-3xl bg-gradient-to-r from-slate-900 via-purple-950/50 to-slate-900 border border-purple-500/30">
        <h3 class="text-2xl sm:text-3xl font-extrabold text-white mb-4">¿Listo para elevar tu nivel como desarrollador?</h3>
        <p class="text-slate-300 text-sm mb-8">Agenda una sesión de diagnóstico inicial para evaluar tus objetivos y armar un plan de mentoría a tu medida.</p>
        <button
          type="button"
          data-trigger-whatsapp
          data-whatsapp-msg="Hola Aleric.dev, quiero agendar mi sesión de diagnóstico inicial para la mentoría."
          class="px-8 py-4 rounded-2xl bg-purple-600 hover:bg-purple-500 text-white font-extrabold text-xs uppercase tracking-wider shadow-lg transition cursor-pointer"
        >
          Agendar Diagnóstico Inicial
        </button>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
