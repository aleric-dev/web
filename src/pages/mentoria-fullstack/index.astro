---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import MentorshipRoadmap from "../../components/MentorshipRoadmap.astro";
import ContactSection from "../../components/ContactSection.astro";
import Footer from "../../components/Footer.astro";

const mentorshipServices = [
  {
    icon: "🎓",
    title: "Acompañamiento 1-a-1 Directo",
    description:
      "Sesiones personalizadas en vivo para resolver dudas, revisar tu código real y acelerar tu aprendizaje.",
  },
  {
    icon: "📘",
    title: "Dominio de TypeScript Estricto",
    description:
      "Tipos avanzados, genéricos, utilidades de tipo y arquitecturas con tipado seguro de extremo a extremo.",
  },
  {
    icon: "⚛️",
    title: "React 19 & Next.js App Router",
    description:
      "Patrones de diseño modernos, Server Components, React Hooks complejos y optimización de renderizado.",
  },
  {
    icon: "🦁",
    title: "Backend Senior con NestJS & Node",
    description:
      "APIs empresariales estructuradas con inyección de dependencias, módulos y guards de seguridad.",
  },
  {
    icon: "🐘",
    title: "PostgreSQL & Prisma ORM",
    description:
      "Modelado relacional eficiente, migraciones de base de datos, índices y consultas complejas.",
  },
  {
    icon: "🏗️",
    title: "Arquitectura Limpia & Clean Code",
    description:
      "Estructuración de proyectos desacoplados aplicando principios SOLID y patrones de diseño profesionales.",
  },
  {
    icon: "🧪",
    title: "Testing Automatizado (Jest & Vitest)",
    description:
      "Implementación de pruebas unitarias, de integración y e2e para garantizar código robusto.",
  },
  {
    icon: "💼",
    title: "Entrevistas Tech & Freelancing",
    description:
      "Mejora de perfil profesional, superación de pruebas técnicas y cotización de proyectos senior.",
  },
];
---

<Layout
  title="Consultoría & Mentoría Técnica Full Stack | Aleric.dev"
  description="Capacitación y mentoría 1-a-1 para desarrolladores y freelancers que buscan dominar el stack moderno: TypeScript, React, NestJS y PostgreSQL."
>
  <Navbar />

  <main
    class="pt-24 bg-slate-50 dark:bg-slate-950 transition-colors duration-300"
  >
    <!-- Hero Especializado Mentoría -->
    <section
      id="hero"
      class="py-16 md:py-24 relative border-b border-slate-200 dark:border-slate-800"
    >
      <div
        class="max-w-7xl mx-auto px-6 grid lg:grid-cols-12 gap-12 items-center"
      >
        <div class="lg:col-span-7 space-y-6">
          <span
            class="inline-flex items-center gap-2 rounded-lg border border-rose-200 dark:border-rose-900 bg-rose-50 dark:bg-rose-950/80 px-3.5 py-1.5 text-xs font-bold text-rose-700 dark:text-rose-300"
          >
            🎓 Para Developers, Freelancers &amp; Estudiantes
          </span>

          <h1
            class="text-4xl sm:text-5xl lg:text-6xl font-black text-slate-900 dark:text-white tracking-tight leading-tight"
          >
            Mentoría Técnica 1-a-1 &amp; <span
              class="text-rose-600 dark:text-rose-400">Maestría Full Stack</span
            >
          </h1>

          <p class="text-slate-600 dark:text-slate-300 text-lg leading-relaxed">
            Supera los bloqueos técnicos en tus proyectos. Te guiamos paso a
            paso en buenas prácticas de ingeniería, arquitectura limpia y código
            profesional sin rodeos teóricos.
          </p>

          <div class="flex flex-col sm:flex-row items-center gap-4 pt-2">
            <a
              href="#contacto"
              class="w-full sm:w-auto px-7 py-3.5 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs uppercase tracking-wider shadow-sm transition flex items-center justify-center"
            >
              Consultar Programa de Mentoría
            </a>
            <a
              href="/"
              class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 font-bold text-xs border border-slate-300 dark:border-slate-800 hover:bg-slate-100 dark:hover:bg-slate-800 transition flex items-center justify-center"
            >
              ← Volver al Inicio
            </a>
          </div>
        </div>

        <!-- Mentorship Format Visual Card -->
        <div class="lg:col-span-5">
          <div
            class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm space-y-4"
          >
            <div
              class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-800"
            >
              <span class="text-xs font-bold text-slate-900 dark:text-white"
                >Formato del Entrenamiento 1-a-1</span
              >
              <span
                class="text-[10px] font-mono font-bold text-rose-600 dark:text-rose-400"
                >Personalizado</span
              >
            </div>

            <div class="space-y-2.5 text-xs">
              <div
                class="p-3 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 flex items-center gap-2"
              >
                <span
                  class="text-rose-600 dark:text-rose-400 font-bold font-mono"
                  >✓</span
                >
                <span class="text-slate-700 dark:text-slate-300 font-medium"
                  >Sesiones en vivo 1-a-1 con revisión de pantalla</span
                >
              </div>
              <div
                class="p-3 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 flex items-center gap-2"
              >
                <span
                  class="text-rose-600 dark:text-rose-400 font-bold font-mono"
                  >✓</span
                >
                <span class="text-slate-700 dark:text-slate-300 font-medium"
                  >Code Reviews exhaustivos en Pull Requests reales</span
                >
              </div>
              <div
                class="p-3 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 flex items-center gap-2"
              >
                <span
                  class="text-rose-600 dark:text-rose-400 font-bold font-mono"
                  >✓</span
                >
                <span class="text-slate-700 dark:text-slate-300 font-medium"
                  >Resolución de bugs y arquitectura en tu proyecto</span
                >
              </div>
              <div
                class="p-3 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 flex items-center gap-2"
              >
                <span
                  class="text-rose-600 dark:text-rose-400 font-bold font-mono"
                  >✓</span
                >
                <span class="text-slate-700 dark:text-slate-300 font-medium"
                  >Chat directo continuo para dudas rápidas</span
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Roadmap de Aprendizaje Timeline por Fases (Componente Modular) -->
    <MentorshipRoadmap />

    <!-- Catálogo de Módulos Mentoría -->
    <section id="beneficios" class="scroll-mt-20 py-16 bg-slate-50 dark:bg-slate-950">

      <div class="max-w-7xl mx-auto px-6">
        <div class="text-center max-w-2xl mx-auto mb-14">
          <h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-3">
            Módulos &amp; Especialidades
          </h2>
          <p class="text-slate-600 dark:text-slate-400 text-sm">
            Enfoque 100% práctico sobre proyectos reales para acelerar tu
            crecimiento.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          {
            mentorshipServices.map((f) => (
              <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 flex flex-col justify-between hover:border-rose-400 transition">
                <div>
                  <div class="text-2xl mb-3 p-2.5 rounded-xl bg-rose-50 dark:bg-rose-950/60 w-fit">
                    {f.icon}
                  </div>
                  <h3 class="text-base font-bold text-slate-900 dark:text-white mb-2">
                    {f.title}
                  </h3>
                  <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed font-normal">
                    {f.description}
                  </p>
                </div>
                <div class="pt-4 mt-4 border-t border-slate-100 dark:border-slate-800">
                  <a
                    href="#contacto"
                    class="text-xs font-bold text-rose-600 dark:text-rose-400 hover:underline flex items-center gap-1"
                  >
                    <span>Consultar módulo</span> →
                  </a>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Formulario de Captura de Leads Dedicado -->
    <ContactSection defaultService="Mentoría & Capacitación Full Stack" />
  </main>

  <Footer />
</Layout>
