---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import CommercialHero from '../components/CommercialHero.astro';
import { ProfileRouter } from '../components/ProfileRouter';
import WhyUsSection from '../components/WhyUsSection.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';


// JSON-LD Schema para SEO indexable por Google y otros motores
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": "Aleric.dev",
  "description": "Agencia de desarrollo web comercial, plataformas de software a la medida, automatizaciones de WhatsApp y consultoría técnica senior.",
  "url": "https://aleric.dev",
  "areaServed": "Global",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Servicios Digitales Aleric.dev",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Desarrollo Web & Landings de Alta Conversión",
          "url": "https://aleric.dev/desarrollo-web"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Desarrollo de Software & SaaS a la Medida",
          "url": "https://aleric.dev/software-a-medida"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Automatización de Operaciones & WhatsApp API",
          "url": "https://aleric.dev/automatizaciones"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Consultoría Técnica Senior",
          "url": "https://aleric.dev/consultoria-tecnica"
        }
      }
    ]
  }
};
---

<Layout
  title="Aleric.dev | Páginas Web que Venden, Software a la Medida y Automatizaciones"
  description="Soluciones digitales para hacer crecer tu empresa: páginas web de alta velocidad, software a tu medida para salir de Excel y automatización de WhatsApp 24/7."
>
  <!-- Inyección de Schema para SEO Indexable -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <Navbar />

  <main class="flex flex-col">
    <!-- Hero Comercial Limpio -->
    <CommercialHero />

    <!-- Orquestador Principal de Soluciones Especializadas en Secciones Protagonistas -->
    <ProfileRouter client:load />

    <!-- Metodología de Trabajo & Garantías de Ingeniería (Componente Unificado) -->
    <WhyUsSection />

    <!-- Formulario de Captura de Leads Directo -->
    <ContactSection />

    <!-- Sección Semántica SEO para Indexación -->
    <section class="sr-only">
      <h2>Agencia de Desarrollo Web, Software a Medida, Automatizaciones y Consultoría Técnica</h2>
      <p>
        En Aleric.dev ayudamos a empresas y marcas a digitalizarse y crecer con páginas web comerciales de alta velocidad,
        plataformas de software a la medida para centralizar operaciones y salir de Excel, flujos de atención y cobranza automática en WhatsApp API,
        y consultoría técnica senior para auditorías, rescate de plataformas e integraciones con Siigo ERP y n8n.
      </p>
      <ul>
        <li><a href="/desarrollo-web">Desarrollo Web &amp; Landings de Alta Conversión</a></li>
        <li><a href="/software-a-medida">Desarrollo de Software &amp; SaaS a la Medida</a></li>
        <li><a href="/automatizaciones">Automatización de Operaciones &amp; WhatsApp API</a></li>
        <li><a href="/consultoria-tecnica">Consultoría Técnica Senior</a></li>
      </ul>
    </section>
  </main>

  <Footer />
</Layout>


