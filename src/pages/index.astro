---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import CommercialHero from '../components/CommercialHero.astro';
import { ProfileRouter } from '../components/ProfileRouter';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';

// JSON-LD Schema para SEO indexable por Google y otros motores
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": "Aleric.dev",
  "description": "Agencia especializada en desarrollo web de alta conversión, aplicaciones a la medida, automatizaciones de WhatsApp API y consultoría técnica.",
  "url": "https://aleric.dev",
  "areaServed": "Global",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Servicios Digitales Aleric.dev",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Desarrollo Web & Landings de Alta Conversión",
          "url": "https://aleric.dev/desarrollo-web"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Desarrollo de Software & SaaS a la Medida",
          "url": "https://aleric.dev/software-a-medida"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Automatización de Operaciones & WhatsApp API",
          "url": "https://aleric.dev/automatizaciones"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Consultoría & Auditoría Técnica",
          "url": "https://aleric.dev/consultoria-tecnica"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Mentoría & Capacitación Full Stack",
          "url": "https://aleric.dev/mentoria-fullstack"
        }
      }
    ]
  }
};
---

<Layout
  title="Aleric.dev | Desarrollo Web, Software a Medida & Automatizaciones"
  description="Soluciones de software y automatización comercial. Desarrollo de páginas web de alta conversión, plataformas a la medida, bots de WhatsApp API y consultoría."
>
  <!-- Inyección de Schema para SEO Indexable -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <Navbar />

  <main class="min-h-[85vh] flex flex-col justify-between">
    <!-- Hero Comercial Minimalista -->
    <CommercialHero />

    <!-- Orquestador Principal de Opciones & Soluciones -->
    <ProfileRouter client:load />

    <!-- Sección de Formulario de Captura de Leads Directo -->
    <ContactSection />

    <!-- Sección Semántica SEO para Indexación de Motores de Búsqueda -->
    <section class="sr-only">
      <h2>Agencia de Desarrollo Web, Software a Medida y Automatizaciones</h2>
      <p>
        En Aleric.dev ofrecemos servicios especializados en creación de páginas web corporativas, landings de alta conversión,
        desarrollo de plataformas SaaS a la medida, integración de WhatsApp Cloud API, flujos automáticos en n8n, auditoría de código legacy
        y mentoría técnica Full Stack.
      </p>
      <ul>
        <li><a href="/desarrollo-web">Desarrollo Web &amp; Landings de Alta Conversión</a></li>
        <li><a href="/software-a-medida">Desarrollo de Software &amp; SaaS a Medida</a></li>
        <li><a href="/automatizaciones">Automatización de Procesos &amp; WhatsApp API</a></li>
        <li><a href="/consultoria-tecnica">Consultoría &amp; Auditoría Técnica Senior</a></li>
        <li><a href="/mentoria-fullstack">Mentoría &amp; Capacitación Full Stack 1-a-1</a></li>
      </ul>
    </section>
  </main>

  <Footer />
</Layout>
