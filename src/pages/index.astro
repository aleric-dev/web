---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import CommercialHero from '../components/CommercialHero.astro';
import BusinessPainPoints from '../components/BusinessPainPoints.astro';
import ServicesShowcase from '../components/ServicesShowcase.astro';
import BeforeAfterTransform from '../components/BeforeAfterTransform.astro';
import ProcessAndGuarantees from '../components/ProcessAndGuarantees.astro';
import FaqSection from '../components/FaqSection.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';


// JSON-LD Schema para SEO indexable por Google y otros motores
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": "Aleric.dev",
  "description": "Agencia de desarrollo web comercial, plataformas de software a la medida, automatizaciones de WhatsApp y consultoría técnica senior.",
  "url": "https://aleric.dev",
  "areaServed": "Global",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Servicios Digitales Aleric.dev",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Desarrollo Web & Landings de Alta Conversión",
          "url": "https://aleric.dev/desarrollo-web"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Desarrollo de Software & SaaS a la Medida",
          "url": "https://aleric.dev/software-a-medida"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Automatización de Operaciones & WhatsApp API",
          "url": "https://aleric.dev/automatizaciones"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Consultoría Técnica Senior",
          "url": "https://aleric.dev/consultoria-tecnica"
        }
      }
    ]
  }
};
---

<Layout
  title="Aleric.dev · Estudio de Software"
  description="Desarrollo de páginas web de alta conversión, software a la medida y automatización comercial con WhatsApp."
>
  <!-- Inyección de Schema para SEO Indexable -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <Navbar />

  <main class="flex flex-col">
    <!-- Hero Comercial Limpio -->
    <CommercialHero />

    <!-- 1. ANTES DE LAS SOLUCIONES: Diagnóstico de Fugas Operativas de Negocio -->
    <BusinessPainPoints />

    <!-- 2. SERVICIOS & ESPECIALIDADES COMERCIALES (Flujo Vertical Continuo) -->
    <ServicesShowcase />

    <!-- 3. TRANSFORMACIÓN TANGIBLE: Transformación Real Antes vs. Con Aleric -->
    <BeforeAfterTransform />

    <!-- 4. METODOLOGÍA & GARANTÍAS: De la Idea a Producción en 4 Pasos Garantizados -->
    <ProcessAndGuarantees />

    <!-- 5. Preguntas Frecuentes Reales -->
    <FaqSection />

    <!-- 7. Formulario de Captura de Leads Directo -->
    <ContactSection />

    <!-- Sección Semántica SEO para Indexación -->
    <section class="sr-only">
      <h2>Agencia de Desarrollo Web, Software a Medida, Automatizaciones y Consultoría Técnica</h2>
      <p>
        En Aleric.dev ayudamos a empresas y marcas a digitalizarse y crecer con páginas web comerciales de alta velocidad,
        plataformas de software a la medida para centralizar operaciones y salir de Excel, flujos de atención y cobranza automática en WhatsApp API,
        y consultoría técnica senior para auditorías, rescate de plataformas e integración de sistemas empresariales y facturación electrónica.
      </p>
      <ul>
        <li><a href="/desarrollo-web">Desarrollo Web &amp; Landings de Alta Conversión</a></li>
        <li><a href="/software-a-medida">Desarrollo de Software &amp; SaaS a la Medida</a></li>
        <li><a href="/automatizaciones">Automatización de Operaciones &amp; WhatsApp API</a></li>
        <li><a href="/consultoria-tecnica">Consultoría Técnica Senior</a></li>
      </ul>
    </section>
  </main>

  <Footer />
</Layout>


