---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import VisualExcelTransform from "../../components/VisualExcelTransform.astro";
import SoftwareLifecycle from "../../components/SoftwareLifecycle.astro";
import FaqSection from "../../components/FaqSection.astro";
import ContactSection from "../../components/ContactSection.astro";
import Footer from "../../components/Footer.astro";

const softwareServices = [
  {
    icon: "📊",
    title: "Sistemas para Salir del Caos de Excel",
    description:
      "Transformamos hojas de cálculo desordenadas en plataformas web seguras, con accesos por rol y sin riesgo de fórmulas rotas.",
  },
  {
    icon: "📱",
    title: "Aplicaciones Web y Móviles B2C",
    description:
      "Lanza tus ideas de negocio con aplicaciones modernas e intuitivas para tus clientes finales: pedidos, membresías, reservas o servicios.",
  },
  {
    icon: "🏢",
    title: "Reemplazo de Software Rígido de Terceros",
    description:
      "Deja de pagar costosas licencias mensuales por software genérico que te obliga a cambiar tu operación para adaptarte a él.",
  },
  {
    icon: "🖥️",
    title: "Paneles de Control & Dashboards en Vivo",
    description:
      "Visualiza tus ventas, inventarios y métricas clave en tiempo real desde tu computador o celular sin tener que cruzar archivos.",
  },
  {
    icon: "👥",
    title: "Portales de Clientes y Proveedores",
    description:
      "Permite que tus clientes descarguen facturas, consulten estados de pedidos o agenden citas directamente en su propio portal.",
  },
  {
    icon: "💳",
    title: "Cobros en Línea & Facturación Integrada",
    description:
      "Conexión con pasarelas de pago (PSE, tarjetas, transferencias) y sincronización con tu sistema contable sin digitación manual.",
  },
  {
    icon: "🔐",
    title: "Control de Permisos y Seguridad de Datos",
    description:
      "Cada empleado o asesor solo ve y edita la información que le corresponde, protegiendo tus datos confidenciales.",
  },
  {
    icon: "🔑",
    title: "Propiedad 100% Tuya (Cero Ataduras)",
    description:
      "Te entregamos el código fuente completo. El sistema es un activo de tu empresa, no un alquiler que te deja sin nada si dejas de pagar.",
  },
];
---

<Layout
  title="Aleric.dev | Software a la Medida, Sal de Excel & Apps Web/Móviles B2C"
  description="Construimos plataformas de software exclusivas para tu negocio: sal del desorden de Excel, elimina software genérico costoso y lanza tus aplicaciones web y móviles."
>
  <Navbar />

  <main
    class="bg-slate-50 dark:bg-slate-950 transition-colors duration-300"
  >
    <!-- Hero Especializado Software a Medida -->
    <section
      id="hero"
      class="pt-24 sm:pt-32 pb-12 md:pb-16 relative border-b border-slate-200 dark:border-slate-800 overflow-hidden"
    >
      <div
        class="max-w-7xl mx-auto px-6 grid lg:grid-cols-12 gap-12 items-center relative z-10"
      >
        <div class="lg:col-span-7 space-y-6 text-center lg:text-left flex flex-col items-center lg:items-start">
          <span
            class="inline-flex items-center gap-2 rounded-lg border border-indigo-200 dark:border-indigo-900 bg-indigo-50 dark:bg-indigo-950/80 px-3.5 py-1.5 text-xs font-bold text-indigo-700 dark:text-indigo-300"
          >
            🚀 Para Empresas que Crecen &amp; Nuevas Ideas de Negocio
          </span>

          <h1
            class="text-[2.5rem] sm:text-5xl lg:text-6xl font-black text-slate-900 dark:text-white tracking-tight leading-[1.15]"
          >
            Software a la medida para <span
              class="text-indigo-600 dark:text-indigo-400"
              >centralizar y ordenar tu empresa</span
            >
          </h1>

          <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed max-w-xl mx-auto lg:mx-0">
            Reemplaza hojas de cálculo desordenadas por una plataforma propia, segura y accesible desde cualquier lugar.
          </p>

          <!-- Imagen Real de Producto en Mobile (< lg) — Integrada al flujo narrativo antes de los botones -->
          <div class="block lg:hidden pt-1 pb-1 w-full max-w-lg mx-auto text-left">
            <div class="relative rounded-2xl overflow-hidden shadow-xl border border-slate-200/90 dark:border-slate-800/90 bg-white dark:bg-slate-900 group">
              <img
                src="/assets/services/solution-software.webp"
                alt="Plataforma de software a la medida Aleric.dev"
                class="w-full h-auto object-cover"
                width="640"
                height="480"
                loading="eager"
              />
              <div class="absolute bottom-2.5 left-2.5 bg-white/95 dark:bg-slate-900/95 backdrop-blur-xs border border-slate-200 dark:border-slate-800 rounded-lg px-2.5 py-1 text-[11px] font-bold text-slate-800 dark:text-slate-200 shadow-xs flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-indigo-500"></span>
                <span>Código 100% Tuyo · Sin Licencias por Usuario</span>
              </div>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3.5 pt-2 w-full sm:w-auto">
            <a
              href="#contacto"
              class="w-full sm:w-auto h-11 px-6 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs uppercase tracking-wider shadow-xs transition flex items-center justify-center"
            >
              Cotizar Software a Medida
            </a>
            <a
              href="/"
              class="w-full sm:w-auto h-11 px-5 rounded-xl bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 font-bold text-xs border border-slate-300 dark:border-slate-800 hover:bg-slate-100 dark:hover:bg-slate-800 transition flex items-center justify-center"
            >
              ← Volver al Inicio
            </a>
          </div>
        </div>

        <!-- Visual Showcase Imagen Real en Desktop (Oculta en Mobile) -->
        <div class="hidden lg:block lg:col-span-5 w-full">
          <div class="relative w-full max-w-lg lg:max-w-none mx-auto select-none">
            <div class="relative rounded-3xl overflow-hidden shadow-2xl border border-slate-200/90 dark:border-slate-800/90 bg-white dark:bg-slate-900 group">
              <img
                src="/assets/services/solution-software.webp"
                alt="Plataforma de software a la medida Aleric.dev"
                class="w-full h-auto object-cover"
                width="640"
                height="480"
                loading="eager"
              />
            </div>
            <div class="hidden sm:flex absolute -bottom-4 -left-4 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md border border-slate-200 dark:border-slate-800 rounded-2xl p-3 shadow-xl items-center gap-3">
              <div class="w-8 h-8 rounded-xl bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 flex items-center justify-center font-bold text-sm">
                🔑
              </div>
              <div>
                <p class="text-xs font-bold text-slate-900 dark:text-white">Código 100% Tuyo</p>
                <p class="text-[10px] text-slate-500 dark:text-slate-400">Sin licencias por usuario</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección Especial: Salir de Excel & Ideas de Negocio B2C -->
    <section class="py-16 bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800">
      <div class="max-w-7xl mx-auto px-6">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          
          <div class="space-y-4">
            <span class="inline-block px-3.5 py-1 rounded-lg bg-indigo-100 dark:bg-indigo-950 border border-indigo-200 dark:border-indigo-800 text-indigo-700 dark:text-indigo-300 text-xs font-bold uppercase tracking-wider">
              Especialidad 01: Operaciones
            </span>
            <h2 class="text-3xl font-extrabold text-slate-900 dark:text-white">
              ¿Tu empresa ya superó la capacidad de Excel?
            </h2>
            <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed">
              Excel es una herramienta fantástica para empezar, pero cuando tienes múltiples vendedores, inventarios que se mueven a diario y clientes esperando respuestas, <strong>se convierte en un cuello de botella peligroso</strong>.
            </p>
            <ul class="space-y-2.5 text-xs sm:text-sm text-slate-600 dark:text-slate-400">
              <li class="flex items-center gap-2">
                <span class="text-emerald-500 font-bold">✓</span> Migramos tus datos de Excel a una base de datos segura y profesional.
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-500 font-bold">✓</span> Acceso simultáneo de todo tu equipo sin bloqueos ni caídas.
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-500 font-bold">✓</span> Permisos restringidos: los empleados solo ven lo que deben ver.
              </li>
            </ul>
          </div>

          <!-- Comparativa Visual Interactiva -->
          <div>
            <VisualExcelTransform />
          </div>

          <div class="space-y-4">
            <span class="inline-block px-3.5 py-1 rounded-lg bg-emerald-100 dark:bg-emerald-950 border border-emerald-200 dark:border-emerald-800 text-emerald-700 dark:text-emerald-300 text-xs font-bold uppercase tracking-wider">
              Especialidad 02: Nuevos Negocios
            </span>
            <h2 class="text-3xl font-extrabold text-slate-900 dark:text-white">
              ¿Tienes una idea de negocio o app para clientes finales (B2C)?
            </h2>
            <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed">
              Si quieres lanzar un nuevo servicio digital para consumidores finales (aplicaciones de pedidos, plataformas de cursos, marketplaces o sistemas de suscripción), construimos la versión web y móvil lista para el mercado.
            </p>
            <ul class="space-y-2.5 text-xs sm:text-sm text-slate-600 dark:text-slate-400">
              <li class="flex items-center gap-2">
                <span class="text-emerald-500 font-bold">✓</span> Experiencia de usuario fácil, atractiva y rápida en cualquier dispositivo.
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-500 font-bold">✓</span> Cobros automáticos, billeteras y pasarelas de pago integradas.
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-500 font-bold">✓</span> Panel administrativo para que gestiones usuarios, ventas y reportes.
              </li>
            </ul>
          </div>

        </div>
      </div>
    </section>

    <!-- Ciclo de Vida del Desarrollo de Software (Componente Modular) -->
    <SoftwareLifecycle />

    <!-- Catálogo Especializado de Servicios Software -->
    <section id="beneficios" class="scroll-mt-20 py-16 bg-slate-50 dark:bg-slate-950">
      <div class="max-w-7xl mx-auto px-6">
        <div class="text-center max-w-4xl mx-auto mb-14">
          <h2 class="text-3xl sm:text-4xl lg:text-[2.75rem] font-black text-slate-900 dark:text-white tracking-tight leading-[1.15]">
            Soluciones de Software que Desarrollamos
          </h2>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          {
            softwareServices.map((f) => (
              <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 flex flex-col justify-between hover:border-indigo-400 transition shadow-sm">
                <div>
                  <div class="text-2xl mb-3 p-2.5 rounded-xl bg-indigo-50 dark:bg-indigo-950/60 w-fit">
                    {f.icon}
                  </div>
                  <h3 class="text-base font-bold text-slate-900 dark:text-white mb-2">
                    {f.title}
                  </h3>
                  <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed font-normal">
                    {f.description}
                  </p>
                </div>
                <div class="pt-4 mt-4 border-t border-slate-100 dark:border-slate-800">
                  <a
                    href="#contacto"
                    class="text-xs font-bold text-indigo-600 dark:text-indigo-400 hover:underline flex items-center gap-1"
                  >
                    <span>Cotizar esta solución</span> →
                  </a>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Preguntas Frecuentes Reales & Garantías Blindadas -->
    <FaqSection />

    <!-- Formulario de Captura de Leads Dedicado -->
    <ContactSection
      defaultService="Desarrollo de Software & SaaS a la Medida"
    />
  </main>

  <Footer />
</Layout>
