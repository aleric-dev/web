<!-- Modal Accesible: Política de Tratamiento de Datos Personales (Habeas Data) -->
<div
  id="privacy-policy-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="privacy-modal-title"
  class="fixed inset-0 z-50 bg-slate-950/70 backdrop-blur-xs flex items-center justify-center p-4 hidden"
>
  <div
    class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl max-w-lg w-full p-6 shadow-2xl max-h-[85vh] overflow-y-auto space-y-4"
  >
