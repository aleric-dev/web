---
const commercialBadges = [
  { text: 'Atención Directa & Rápida', icon: '💬' },
  { text: 'Soluciones a la Medida', icon: '🚀' },
  { text: 'Garantía de Calidad', icon: '⭐' },
];
---

<section id="hero" class="relative pt-32 pb-16 flex flex-col justify-center overflow-hidden bg-gradient-to-b from-indigo-50/70 via-slate-50 to-white dark:from-slate-950 dark:via-slate-900 dark:to-slate-950 text-slate-900 dark:text-slate-100 transition-colors duration-300">
  <!-- Soft Ambient Glow -->
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[450px] bg-indigo-500/10 dark:bg-indigo-600/10 rounded-full blur-[160px] pointer-events-none"></div>

  <div class="relative max-w-5xl mx-auto px-6 text-center z-10">
    
    <!-- Status Badge -->
    <div class="inline-flex items-center gap-2 rounded-full border border-indigo-500/30 bg-indigo-500/10 dark:bg-indigo-500/10 px-4 py-2 text-xs font-bold text-indigo-700 dark:text-indigo-300 backdrop-blur-md mb-6 shadow-sm">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
      </span>
      <span>Agencia de Desarrollo &amp; Automatización</span>
    </div>

    <!-- Main Headline -->
    <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-tight mb-6">
      Transformamos la complejidad de tu empresa en <span class="bg-gradient-to-r from-indigo-600 via-purple-600 to-cyan-500 dark:from-indigo-400 dark:via-purple-300 dark:to-cyan-400 bg-clip-text text-transparent">Resultados Digitales</span>
    </h1>

    <!-- Commercial Subtitle -->
    <p class="text-base sm:text-xl text-slate-600 dark:text-slate-300 max-w-3xl mx-auto leading-relaxed mb-8">
      Desde páginas web comerciales y aplicaciones a la medida hasta automatización de WhatsApp y procesos de negocio. Elige la solución que necesitas hoy.
    </p>

    <!-- Primary High-Contrast & Secondary CTAs justo debajo del párrafo descriptivo -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-10">
      <!-- Botón Primario Alto Contraste dirigido a #contacto -->
      <a
        href="#contacto"
        class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-gradient-to-r from-indigo-600 via-indigo-500 to-cyan-500 hover:from-indigo-500 hover:to-cyan-400 text-white font-extrabold text-sm uppercase tracking-wider shadow-xl shadow-indigo-600/30 hover:shadow-indigo-500/50 hover:scale-[1.03] active:scale-[0.98] transition cursor-pointer border border-indigo-400/40 flex items-center justify-center gap-3 group"
      >
        <span>Solicitar Propuesta</span>
        <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </a>

      <!-- Botón Secundario Subtil -->
      <a
        href="#servicios"
        class="w-full sm:w-auto px-7 py-4 rounded-2xl bg-white dark:bg-slate-900 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-800 dark:text-slate-200 font-bold text-sm border border-slate-300 dark:border-slate-800 transition flex items-center justify-center gap-2 cursor-pointer shadow-md"
      >
        <span>Ver Servicios</span>
        <svg class="w-4 h-4 text-slate-500 dark:text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
        </svg>
      </a>
    </div>

    <!-- Commercial Badges -->
    <div class="flex flex-wrap items-center justify-center gap-6 text-xs text-slate-700 dark:text-slate-300">
      {commercialBadges.map((b) => (
        <div class="flex items-center gap-2 font-semibold bg-white/80 dark:bg-slate-900/50 px-3.5 py-1.5 rounded-full border border-slate-200 dark:border-slate-800 shadow-sm">
          <span>{b.icon}</span>
          <span>{b.text}</span>
        </div>
      ))}
    </div>

  </div>
</section>
