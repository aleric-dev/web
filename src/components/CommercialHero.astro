---
const commercialBadges = [
  { text: 'Atención Directa & Rápida', icon: '💬' },
  { text: 'Soluciones a la Medida', icon: '🚀' },
  { text: 'Garantía de Calidad', icon: '⭐' },
];
---

<section id="hero" class="relative pt-36 pb-20 flex flex-col justify-center bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 transition-colors duration-300">
  <div class="relative max-w-5xl mx-auto px-6 text-center z-10">
    
    <!-- Status Badge -->
    <div class="inline-flex items-center gap-2 rounded-full border border-indigo-200 dark:border-indigo-900 bg-indigo-50 dark:bg-indigo-950/80 px-4 py-1.5 text-xs font-bold text-indigo-700 dark:text-indigo-300 mb-8 shadow-sm">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
      </span>
      <span>Agencia de Desarrollo &amp; Automatización</span>
    </div>

    <!-- Main Headline - Solid Color Focus -->
    <h1 class="text-4xl sm:text-6xl font-black tracking-tight text-slate-900 dark:text-white leading-[1.15] mb-6">
      Transformamos la complejidad de tu empresa en <span class="text-indigo-600 dark:text-indigo-400">Resultados Digitales</span>
    </h1>

    <!-- Commercial Subtitle -->
    <p class="text-base sm:text-xl text-slate-600 dark:text-slate-300 max-w-3xl mx-auto leading-relaxed mb-10">
      Desde páginas web comerciales y plataformas SaaS a la medida hasta automatización de WhatsApp y procesos de negocio. Soluciones con ingeniería de alto rendimiento.
    </p>

    <!-- CTAs de colores planos -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-12">
      <a
        href="#contacto"
        class="w-full sm:w-auto px-8 py-4 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-sm uppercase tracking-wider shadow-md hover:shadow-lg transition cursor-pointer border border-indigo-500 flex items-center justify-center gap-3 group"
      >
        <span>Solicitar Propuesta</span>
        <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </a>

      <a
        href="#soluciones"
        class="w-full sm:w-auto px-7 py-4 rounded-xl bg-white dark:bg-slate-900 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-800 dark:text-slate-200 font-bold text-sm border border-slate-300 dark:border-slate-800 transition flex items-center justify-center gap-2 cursor-pointer shadow-sm"
      >
        <span>Explorar Especialidades</span>
        <svg class="w-4 h-4 text-slate-500 dark:text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
        </svg>
      </a>
    </div>

    <!-- Commercial Badges -->
    <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-6 text-xs text-slate-600 dark:text-slate-300">
      {commercialBadges.map((b) => (
        <div class="flex items-center gap-2 font-semibold bg-white dark:bg-slate-900 px-4 py-2 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm">
          <span>{b.icon}</span>
          <span>{b.text}</span>
        </div>
      ))}
    </div>

  </div>
</section>

