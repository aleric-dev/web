---
// Hero Comercial con Reducción Radical de Texto e Imagen Real de Producto
---

<section
  id="hero"
  class="relative pt-28 sm:pt-36 pb-16 sm:pb-24 flex flex-col justify-center bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 transition-colors duration-300 overflow-hidden"
>
  <!-- Cuadrícula sutil de fondo para textura de ingeniería -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#cbd5e115_1px,transparent_1px),linear-gradient(to_bottom,#cbd5e115_1px,transparent_1px)] dark:bg-[linear-gradient(to_right,#1e293b20_1px,transparent_1px),linear-gradient(to_bottom,#1e293b20_1px,transparent_1px)] bg-[size:3.5rem_3.5rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_20%,#000_70%,transparent_100%)] pointer-events-none"></div>


  <div class="relative max-w-7xl mx-auto px-6 z-10 w-full">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      
      <!-- Columna Izquierda: Ultra Minimalista y Directa (6 Columnas) -->
      <div class="lg:col-span-6 space-y-6 text-center lg:text-left flex flex-col items-center lg:items-start">
        <!-- Main Headline Corto y Contundente -->
        <h1 class="text-[2.6rem] sm:text-5xl lg:text-[3.5rem] xl:text-[3.75rem] font-extrabold tracking-tight text-slate-900 dark:text-white leading-[1.15]">
          Tecnología que hace <span class="text-indigo-600 dark:text-indigo-400">crecer tu negocio</span>.
        </h1>

        <!-- Subtítulo de 1 Sola Línea Ágil -->
        <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 max-w-xl leading-relaxed mx-auto lg:mx-0">
          Páginas web de alta conversión, plataformas de software a la medida y automatizaciones comerciales para tu empresa.
        </p>

        <!-- Imagen Real de Producto en Mobile (< lg) — Integrada al flujo narrativo antes de los botones -->
        <div class="block lg:hidden pt-1 pb-1 w-full max-w-lg mx-auto text-left">
          <div class="relative rounded-2xl overflow-hidden shadow-xl border border-slate-200/90 dark:border-slate-800/90 bg-white dark:bg-slate-900 group">
            <img
              src="/assets/hero-showcase.jpg"
              alt="Plataforma de software y automatizaciones de Aleric.dev"
              class="w-full h-auto object-cover"
              width="640"
              height="480"
              loading="eager"
            />
            <div class="absolute bottom-2.5 left-2.5 bg-white/95 dark:bg-slate-900/95 backdrop-blur-xs border border-slate-200 dark:border-slate-800 rounded-lg px-2.5 py-1 text-[11px] font-bold text-slate-800 dark:text-slate-200 shadow-xs flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              <span>100% Código Tuyo · Cero Ataduras</span>
            </div>
          </div>
        </div>

        <!-- Botones de Acción Inmediata -->
        <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center justify-center lg:justify-start gap-3.5 w-full sm:w-auto">
          <a
            href="#contacto"
            class="px-7 py-4 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs uppercase tracking-wider shadow-md hover:shadow-indigo-500/25 active:scale-[0.98] transition cursor-pointer border border-indigo-500 flex items-center justify-center gap-2 group"
          >
            <span>Cotizar Proyecto por WhatsApp</span>
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>

          <a
            href="#soluciones"
            class="px-6 py-4 rounded-xl bg-white dark:bg-slate-900 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-800 dark:text-slate-200 font-bold text-xs uppercase tracking-wider border border-slate-300 dark:border-slate-800 transition flex items-center justify-center gap-2 cursor-pointer shadow-xs"
          >
            <span>Ver Soluciones</span>
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </a>
        </div>

      </div>

      <!-- Columna Derecha: Imagen Real de Producto en Desktop (Oculta en Mobile) -->
      <div class="hidden lg:block lg:col-span-6 w-full">
        <div class="relative w-full max-w-lg lg:max-w-none mx-auto select-none">
          
          <!-- Resplandor sutil de fondo -->
          <div class="absolute -top-6 -right-6 w-72 h-72 bg-indigo-500/10 dark:bg-indigo-600/15 rounded-full blur-3xl pointer-events-none"></div>
          <div class="absolute -bottom-8 -left-8 w-64 h-64 bg-cyan-500/10 dark:bg-cyan-600/15 rounded-full blur-3xl pointer-events-none"></div>

          <!-- Contenedor de la Imagen con Marco Sólido y Sombra Profunda -->
          <div class="relative rounded-3xl overflow-hidden shadow-2xl border border-slate-200/90 dark:border-slate-800/90 bg-white dark:bg-slate-900 group transition duration-300 hover:shadow-indigo-500/10">
            <img
              src="/assets/hero-showcase.jpg"
              alt="Plataforma de software y automatizaciones de Aleric.dev"
              class="w-full h-auto object-cover transform transition-transform duration-500 group-hover:scale-[1.02]"
              width="640"
              height="480"
              loading="eager"
              fetchpriority="high"
            />
          </div>

          <!-- Micro-Badge Flotante de Confianza -->
          <div class="hidden sm:flex absolute -bottom-4 -left-4 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md border border-slate-200 dark:border-slate-800 rounded-2xl p-3 shadow-xl items-center gap-3 animate-fade-in-up">
            <div class="w-8 h-8 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold text-sm">
              ⚡
            </div>
            <div>
              <p class="text-xs font-bold text-slate-900 dark:text-white">Velocidad &amp; Propiedad</p>
              <p class="text-[10px] text-slate-500 dark:text-slate-400">Código 100% tuyo · Cero ataduras</p>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
