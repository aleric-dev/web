---
// Hero Comercial con Reducción Radical de Texto e Imagen Real de Producto
const heroSlides = [
  {
    src: '/assets/hero/hero-showcase.webp',
    vertical: 'Aleric.dev',
    title: 'Ingeniería de Software a tu Medida',
    desc: 'Páginas web · Software propio · Automatizaciones 24/7',
    mobileLabel: 'Software a tu medida',
    dotClass: 'bg-indigo-500',
    textColor: 'text-indigo-600 dark:text-indigo-400',
    icon: '⚡',
    iconBg: 'bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 border border-indigo-200/60 dark:border-indigo-800/40',
  },
  {
    src: '/assets/services/solution-web.webp',
    vertical: 'Desarrollo Web',
    title: 'Páginas Web de Alta Conversión',
    desc: 'Carga ultrarrápida · Optimizada para vender',
    mobileLabel: 'Carga ultrarrápida',
    dotClass: 'bg-cyan-500',
    textColor: 'text-cyan-600 dark:text-cyan-400',
    icon: '🌐',
    iconBg: 'bg-cyan-50 dark:bg-cyan-950/60 text-cyan-600 dark:text-cyan-400 border border-cyan-200/60 dark:border-cyan-800/40',
  },
  {
    src: '/assets/services/solution-software.webp',
    vertical: 'Software a Medida',
    title: 'Plataformas y Sistemas Propios',
    desc: '100% de tu empresa · Cero cobros por empleado',
    mobileLabel: 'Cero cobros por empleado',
    dotClass: 'bg-indigo-500',
    textColor: 'text-indigo-600 dark:text-indigo-400',
    icon: '💻',
    iconBg: 'bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 border border-indigo-200/60 dark:border-indigo-800/40',
  },
  {
    src: '/assets/services/solution-automation.webp',
    vertical: 'Ventas por WhatsApp',
    title: 'Automatización Comercial 24/7',
    desc: 'Respuestas en 2 segundos · Cierra ventas sin esperar',
    mobileLabel: 'Respuestas en 2 segundos',
    dotClass: 'bg-emerald-500',
    textColor: 'text-emerald-600 dark:text-emerald-400',
    icon: '💬',
    iconBg: 'bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 border border-emerald-200/60 dark:border-emerald-800/40',
  },
  {
    src: '/assets/services/solution-consultancy.webp',
    vertical: 'Consultoría Técnica',
    title: 'Auditoría y Rescate de Software',
    desc: 'Diagnóstico honesto · Rescate de código caído',
    mobileLabel: 'Diagnóstico honesto',
    dotClass: 'bg-amber-500',
    textColor: 'text-amber-600 dark:text-amber-400',
    icon: '🛡️',
    iconBg: 'bg-amber-50 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 border border-amber-200/60 dark:border-amber-800/40',
  },
];
---

<section
  id="hero"
  class="relative pt-28 sm:pt-36 pb-16 sm:pb-24 flex flex-col justify-center bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 transition-colors duration-300 overflow-hidden"
>
  <!-- Cuadrícula sutil de fondo para textura de ingeniería -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#cbd5e115_1px,transparent_1px),linear-gradient(to_bottom,#cbd5e115_1px,transparent_1px)] dark:bg-[linear-gradient(to_right,#1e293b20_1px,transparent_1px),linear-gradient(to_bottom,#1e293b20_1px,transparent_1px)] bg-[size:3.5rem_3.5rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_20%,#000_70%,transparent_100%)] pointer-events-none"></div>

  <div class="relative max-w-7xl mx-auto px-6 z-10 w-full">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      
      <!-- Columna Izquierda: Ultra Minimalista y Directa (6 Columnas) -->
      <div class="lg:col-span-6 space-y-6 text-center lg:text-left flex flex-col items-center lg:items-start">
        <!-- Main Headline Fijo y Limpio para Máximo Rendimiento SEO -->
        <h1 class="text-[2.4rem] sm:text-5xl lg:text-[3.25rem] xl:text-[3.5rem] font-extrabold tracking-tight text-slate-900 dark:text-white leading-[1.2]">
          Tecnología que hace <span class="text-indigo-600 dark:text-indigo-400">crecer tu negocio</span>.
        </h1>

        <!-- Subtítulo de 1 Sola Línea Ágil -->
        <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 max-w-xl leading-relaxed mx-auto lg:mx-0">
          Páginas web de alta conversión, plataformas de software a la medida y automatizaciones comerciales para tu empresa.
        </p>

        <!-- Imagen Real de Producto en Mobile (< lg) — Carrusel sincronizado sin mutación de src -->
        <div class="block lg:hidden pt-1 pb-1 w-full max-w-lg mx-auto text-left">
          <div class="relative h-56 sm:h-64 rounded-2xl overflow-hidden shadow-xl border border-slate-200/90 dark:border-slate-800/90 bg-white dark:bg-slate-900">
            {heroSlides.map((slide, idx) => (
              <img
                data-hero-slide-mobile={idx}
                src={slide.src}
                alt={slide.title}
                class={`absolute inset-0 w-full h-full object-cover transition-opacity duration-700 ${
                  idx === 0 ? "opacity-100" : "opacity-0 pointer-events-none"
                }`}
                width="640"
                height="400"
                loading={idx === 0 ? "eager" : "lazy"}
              />
            ))}
            <div class="absolute bottom-2.5 left-2.5 bg-white/95 dark:bg-slate-900/95 backdrop-blur-xs border border-slate-200 dark:border-slate-800 rounded-lg px-2.5 py-1 text-[11px] font-bold shadow-xs flex items-center gap-1.5 z-10">
              <span id="hero-dot-mobile" class="w-2 h-2 rounded-full bg-indigo-500"></span>
              <span id="hero-vertical-mobile" class="font-mono text-[10px] font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">Aleric.dev</span>
              <span class="text-slate-400 dark:text-slate-600">·</span>
              <span id="hero-label-mobile" class="text-slate-800 dark:text-slate-200 text-[11px]">Software a tu medida</span>
            </div>
          </div>
        </div>

        <!-- Botones de Acción Inmediata -->
        <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center justify-center lg:justify-start gap-3.5 w-full sm:w-auto">
          <a
            href="#contacto"
            class="px-7 py-4 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs uppercase tracking-wider shadow-md hover:shadow-indigo-500/25 active:scale-[0.98] transition cursor-pointer border border-indigo-500 flex items-center justify-center gap-2 group"
          >
            <span>Cotizar Proyecto por WhatsApp</span>
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>

          <a
            href="#soluciones"
            class="px-6 py-4 rounded-xl bg-white dark:bg-slate-900 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-800 dark:text-slate-200 font-bold text-xs uppercase tracking-wider border border-slate-300 dark:border-slate-800 transition flex items-center justify-center gap-2 cursor-pointer shadow-xs"
          >
            <span>Ver Soluciones</span>
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </a>
        </div>

      </div>

      <!-- Columna Derecha: Imagen Real de Producto en Desktop (Rotación Dinámica con Capas Superpuestas) -->
      <div class="hidden lg:block lg:col-span-6 w-full">
        <div class="relative w-full max-w-lg lg:max-w-none mx-auto select-none">
          
          <!-- Resplandor sutil de fondo -->
          <div class="absolute -top-6 -right-6 w-72 h-72 bg-indigo-500/10 dark:bg-indigo-600/15 rounded-full blur-3xl pointer-events-none"></div>
          <div class="absolute -bottom-8 -left-8 w-64 h-64 bg-cyan-500/10 dark:bg-cyan-600/15 rounded-full blur-3xl pointer-events-none"></div>

          <!-- Contenedor de la Imagen con Marco Sólido y Capas fijas -->
          <div class="relative h-[410px] rounded-3xl overflow-hidden shadow-2xl border border-slate-200/90 dark:border-slate-800/90 bg-white dark:bg-slate-900">
            {heroSlides.map((slide, idx) => (
              <img
                data-hero-slide-desktop={idx}
                src={slide.src}
                alt={slide.title}
                class={`absolute inset-0 w-full h-full object-cover transition-opacity duration-700 ${
                  idx === 0 ? "opacity-100" : "opacity-0 pointer-events-none"
                }`}
                width="640"
                height="410"
                loading={idx === 0 ? "eager" : "lazy"}
                fetchpriority={idx === 0 ? "high" : "auto"}
              />
            ))}
          </div>

          <!-- Micro-Badge Flotante Sincronizado con la Vertical y Color Oficial -->
          <div class="hidden sm:flex absolute -bottom-4 -left-4 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md border border-slate-200 dark:border-slate-800 rounded-2xl p-3.5 shadow-xl items-center gap-3.5 max-w-sm z-10">
            <div id="hero-badge-icon" class="w-10 h-10 rounded-xl bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 flex items-center justify-center font-bold text-base shrink-0 border border-indigo-200/60 dark:border-indigo-800/40">
              ⚡
            </div>
            <div class="flex-1 min-w-0">
              <!-- Nombre de la Vertical en Color Oficial -->
              <div class="flex items-center gap-1.5 mb-0.5">
                <span id="hero-badge-dot" class="w-1.5 h-1.5 rounded-full bg-indigo-500"></span>
                <span id="hero-badge-vertical" class="font-mono text-[10px] font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">
                  Aleric.dev
                </span>
              </div>
              <p id="hero-badge-title" class="text-xs font-bold text-slate-900 dark:text-white truncate">
                Ingeniería de Software a tu Medida
              </p>
              <p id="hero-badge-desc" class="text-[10px] text-slate-500 dark:text-slate-400 truncate">
                Páginas web · Software propio · Automatizaciones 24/7
              </p>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<script is:inline>
  (function() {
    function initHeroImageCarousel() {
      const slidesDesktop = Array.from(document.querySelectorAll('[data-hero-slide-desktop]'));
      const slidesMobile = Array.from(document.querySelectorAll('[data-hero-slide-mobile]'));
      
      const labelMobile = document.getElementById('hero-label-mobile');
      const verticalMobile = document.getElementById('hero-vertical-mobile');
      const dotMobile = document.getElementById('hero-dot-mobile');
      
      const badgeVertical = document.getElementById('hero-badge-vertical');
      const badgeDot = document.getElementById('hero-badge-dot');
      const badgeTitle = document.getElementById('hero-badge-title');
      const badgeDesc = document.getElementById('hero-badge-desc');
      const badgeIcon = document.getElementById('hero-badge-icon');

      if (!slidesDesktop.length && !slidesMobile.length) return;

      const slideMeta = [
        {
          vertical: 'Aleric.dev',
          title: 'Ingeniería de Software a tu Medida',
          desc: 'Páginas web · Software propio · Automatizaciones 24/7',
          mobileLabel: 'Software a tu medida',
          dotClass: 'bg-indigo-500',
          textColor: 'text-indigo-600 dark:text-indigo-400',
          icon: '⚡',
          iconBg: 'bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 border border-indigo-200/60 dark:border-indigo-800/40'
        },
        {
          vertical: 'Desarrollo Web',
          title: 'Páginas Web de Alta Conversión',
          desc: 'Carga ultrarrápida · Optimizada para vender',
          mobileLabel: 'Carga ultrarrápida',
          dotClass: 'bg-cyan-500',
          textColor: 'text-cyan-600 dark:text-cyan-400',
          icon: '🌐',
          iconBg: 'bg-cyan-50 dark:bg-cyan-950/60 text-cyan-600 dark:text-cyan-400 border border-cyan-200/60 dark:border-cyan-800/40'
        },
        {
          vertical: 'Software a Medida',
          title: 'Plataformas y Sistemas Propios',
          desc: '100% de tu empresa · Cero cobros por empleado',
          mobileLabel: 'Cero cobros por empleado',
          dotClass: 'bg-indigo-500',
          textColor: 'text-indigo-600 dark:text-indigo-400',
          icon: '💻',
          iconBg: 'bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 border border-indigo-200/60 dark:border-indigo-800/40'
        },
        {
          vertical: 'Ventas por WhatsApp',
          title: 'Automatización Comercial 24/7',
          desc: 'Respuestas en 2 segundos · Cierra ventas sin esperar',
          mobileLabel: 'Respuestas en 2 segundos',
          dotClass: 'bg-emerald-500',
          textColor: 'text-emerald-600 dark:text-emerald-400',
          icon: '💬',
          iconBg: 'bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 border border-emerald-200/60 dark:border-emerald-800/40'
        },
        {
          vertical: 'Consultoría Técnica',
          title: 'Auditoría y Rescate de Software',
          desc: 'Diagnóstico honesto · Rescate de código caído',
          mobileLabel: 'Diagnóstico honesto',
          dotClass: 'bg-amber-500',
          textColor: 'text-amber-600 dark:text-amber-400',
          icon: '🛡️',
          iconBg: 'bg-amber-50 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 border border-amber-200/60 dark:border-amber-800/40'
        }
      ];

      let currentIndex = 0;
      const totalSlides = slideMeta.length;

      // Rotación pausada mediante opacidad CSS (cero peticiones de red repetitivas)
      setInterval(() => {
        const prevIndex = currentIndex;
        currentIndex = (currentIndex + 1) % totalSlides;
        const current = slideMeta[currentIndex];

        // Transición de opacidad en Desktop
        if (slidesDesktop.length) {
          slidesDesktop[prevIndex]?.classList.remove('opacity-100');
          slidesDesktop[prevIndex]?.classList.add('opacity-0', 'pointer-events-none');

          slidesDesktop[currentIndex]?.classList.remove('opacity-0', 'pointer-events-none');
          slidesDesktop[currentIndex]?.classList.add('opacity-100');
        }

        // Transición de opacidad en Mobile
        if (slidesMobile.length) {
          slidesMobile[prevIndex]?.classList.remove('opacity-100');
          slidesMobile[prevIndex]?.classList.add('opacity-0', 'pointer-events-none');

          slidesMobile[currentIndex]?.classList.remove('opacity-0', 'pointer-events-none');
          slidesMobile[currentIndex]?.classList.add('opacity-100');
        }

        // Actualizar textos y badges sincronizados
        if (verticalMobile) {
          verticalMobile.textContent = current.vertical;
          verticalMobile.className = `font-mono text-[10px] font-bold uppercase tracking-wider ${current.textColor}`;
        }
        if (labelMobile) labelMobile.textContent = current.mobileLabel;
        if (dotMobile) dotMobile.className = `w-2 h-2 rounded-full ${current.dotClass}`;

        if (badgeVertical) {
          badgeVertical.textContent = current.vertical;
          badgeVertical.className = `font-mono text-[10px] font-bold uppercase tracking-wider ${current.textColor}`;
        }
        if (badgeDot) badgeDot.className = `w-1.5 h-1.5 rounded-full ${current.dotClass}`;
        if (badgeTitle) badgeTitle.textContent = current.title;
        if (badgeDesc) badgeDesc.textContent = current.desc;
        if (badgeIcon) {
          badgeIcon.textContent = current.icon;
          badgeIcon.className = `w-10 h-10 rounded-xl flex items-center justify-center font-bold text-base shrink-0 ${current.iconBg}`;
        }
      }, 6000);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeroImageCarousel);
    } else {
      initHeroImageCarousel();
    }
  })();
</script>
