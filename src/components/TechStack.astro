---
const techCategories = [
  {
    title: 'Frontend & UI',
    description: 'Interfaces ultra-responsivas, dinámicas y optimizadas para máxima velocidad.',
    techs: ['TypeScript', 'React', 'Astro', 'Tailwind CSS', 'Next.js', 'Framer Motion'],
    icon: '💻',
  },
  {
    title: 'Backend & APIs',
    description: 'Arquitecturas robustas, desacopladas, seguras y de alto rendimiento.',
    techs: ['Node.js', 'NestJS', 'Express', 'Python', 'REST APIs', 'GraphQL'],
    icon: '⚙️',
  },
  {
    title: 'Bases de Datos & Caché',
    description: 'Persistencia eficiente, modelado estricto e indexación acelerada.',
    techs: ['PostgreSQL', 'Redis', 'Prisma ORM', 'TypeORM', 'MongoDB'],
    icon: '🗄️',
  },
  {
    title: 'Automatización & WhatsApp',
    description: 'Flujos operativos automáticos sin fricción ni fallas.',
    techs: ['n8n', 'WhatsApp Cloud API', 'Chatwoot', 'Webhooks', 'Python Bots'],
    icon: '⚡',
  },
];
---

<section id="stack" class="py-24 bg-slate-900/60 relative overflow-hidden border-t border-slate-800">
  <!-- Glow decorativo -->
  <div class="absolute top-0 right-1/4 w-96 h-96 bg-cyan-500/10 rounded-full blur-[140px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 relative z-10">

    <!-- Performance Lighthouse Highlight Banner -->
    <div id="rendimiento" class="mb-20 rounded-3xl border border-indigo-500/30 bg-gradient-to-r from-slate-950 via-indigo-950/40 to-slate-950 p-8 sm:p-12 shadow-2xl backdrop-blur-xl relative overflow-hidden">
      <div class="absolute -right-10 -bottom-10 w-80 h-80 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
      
      <div class="grid lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-7 space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-mono font-bold">
            <span>⚡ Garantía de Calidad Técnica</span>
          </div>
          <h3 class="text-2xl sm:text-4xl font-extrabold text-white">
            100/100 en Google Lighthouse &amp; Cero Bloatware
          </h3>
          <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
            Construimos con la <strong class="text-white">Astro Island Architecture</strong> para enviar 0 bytes de JavaScript innecesario al cliente. Tus usuarios disfrutarán de una velocidad de carga instantánea y la mejor indexación SEO posible.
          </p>
          <div class="grid sm:grid-cols-3 gap-4 pt-2 font-mono text-xs">
            <div class="p-3 rounded-xl bg-slate-900/90 border border-slate-800 text-slate-300">
              <span class="block text-emerald-400 font-bold text-lg">100%</span>
              <span>Performance Score</span>
            </div>
            <div class="p-3 rounded-xl bg-slate-900/90 border border-slate-800 text-slate-300">
              <span class="block text-emerald-400 font-bold text-lg">100%</span>
              <span>SEO Optimization</span>
            </div>
            <div class="p-3 rounded-xl bg-slate-900/90 border border-slate-800 text-slate-300">
              <span class="block text-emerald-400 font-bold text-lg">0.2s</span>
              <span>First Contentful Paint</span>
            </div>
          </div>
        </div>

        <!-- Lighthouse Visual Badges Grid -->
        <div class="lg:col-span-5 flex justify-center">
          <div class="grid grid-cols-2 gap-4 w-full max-w-sm">
            <div class="p-4 rounded-2xl bg-slate-900/90 border border-emerald-500/30 text-center shadow-lg">
              <div class="w-14 h-14 mx-auto rounded-full border-4 border-emerald-400 flex items-center justify-center font-extrabold text-emerald-400 text-lg mb-2">
                100
              </div>
              <span class="text-xs font-mono font-bold text-slate-200">Performance</span>
            </div>
            <div class="p-4 rounded-2xl bg-slate-900/90 border border-emerald-500/30 text-center shadow-lg">
              <div class="w-14 h-14 mx-auto rounded-full border-4 border-emerald-400 flex items-center justify-center font-extrabold text-emerald-400 text-lg mb-2">
                100
              </div>
              <span class="text-xs font-mono font-bold text-slate-200">Accessibility</span>
            </div>
            <div class="p-4 rounded-2xl bg-slate-900/90 border border-emerald-500/30 text-center shadow-lg">
              <div class="w-14 h-14 mx-auto rounded-full border-4 border-emerald-400 flex items-center justify-center font-extrabold text-emerald-400 text-lg mb-2">
                100
              </div>
              <span class="text-xs font-mono font-bold text-slate-200">Best Practices</span>
            </div>
            <div class="p-4 rounded-2xl bg-slate-900/90 border border-emerald-500/30 text-center shadow-lg">
              <div class="w-14 h-14 mx-auto rounded-full border-4 border-emerald-400 flex items-center justify-center font-extrabold text-emerald-400 text-lg mb-2">
                100
              </div>
              <span class="text-xs font-mono font-bold text-slate-200">SEO</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Tech Stack Categories Title -->
    <div class="text-center max-w-2xl mx-auto mb-16 space-y-3">
      <span class="inline-block px-4 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 text-xs font-mono font-bold uppercase tracking-widest">
        Stack Tecnológico
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white">
        Herramientas de Clase Mundial
      </h2>
      <p class="text-slate-400 text-sm sm:text-base">
        Seleccionamos con rigor las mejores tecnologías para garantizar robustez, mantenibilidad y rapidez.
      </p>
    </div>

    <!-- Tech Stack Cards -->
    <div class="grid md:grid-cols-2 gap-8">
      {techCategories.map((cat) => (
        <div class="rounded-3xl border border-slate-800 bg-slate-950/80 p-8 shadow-xl hover:border-slate-700 transition">
          <div class="flex items-center gap-4 mb-4">
            <div class="w-12 h-12 rounded-2xl bg-slate-900 border border-slate-800 flex items-center justify-center text-2xl">
              {cat.icon}
            </div>
            <div>
              <h3 class="text-xl font-bold text-white">{cat.title}</h3>
              <p class="text-xs text-slate-400">{cat.description}</p>
            </div>
          </div>
          
          <div class="flex flex-wrap gap-2 pt-4 border-t border-slate-900">
            {cat.techs.map((tech) => (
              <span class="px-3 py-1.5 rounded-xl bg-slate-900 border border-slate-800 text-xs font-mono font-semibold text-indigo-300 hover:border-indigo-500/40 hover:text-white transition">
                {tech}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
