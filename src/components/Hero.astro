---
const techBadges = [
  { name: 'TypeScript', icon: '⚡', color: 'border-blue-500/30 bg-blue-500/10 text-blue-300' },
  { name: 'React', icon: '⚛️', color: 'border-cyan-500/30 bg-cyan-500/10 text-cyan-300' },
  { name: 'NestJS', icon: '🦁', color: 'border-red-500/30 bg-red-500/10 text-red-300' },
  { name: 'PostgreSQL', icon: '🐘', color: 'border-indigo-500/30 bg-indigo-500/10 text-indigo-300' },
  { name: 'n8n', icon: '🔀', color: 'border-pink-500/30 bg-pink-500/10 text-pink-300' },
  { name: 'WhatsApp API', icon: '💬', color: 'border-emerald-500/30 bg-emerald-500/10 text-emerald-300' },
];
---

<section class="relative min-h-screen pt-32 pb-20 flex flex-col justify-center overflow-hidden bg-slate-950">
  <!-- Radial Neon Lights & Background Blur Elements -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-indigo-600/15 rounded-full blur-[140px] pointer-events-none animate-pulse-glow"></div>
  <div class="absolute top-1/3 right-10 w-[400px] h-[400px] bg-cyan-500/10 rounded-full blur-[120px] pointer-events-none"></div>
  <div class="absolute bottom-10 left-10 w-[400px] h-[400px] bg-purple-600/10 rounded-full blur-[120px] pointer-events-none"></div>

  <!-- Grid lines overlay -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#1e293b15_1px,transparent_1px),linear-gradient(to_bottom,#1e293b15_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] pointer-events-none"></div>

  <div class="relative max-w-7xl mx-auto px-6">
    <div class="grid lg:grid-cols-12 gap-12 items-center">

      <!-- Text Content Left -->
      <div class="lg:col-span-7 space-y-8 text-center lg:text-left">
        
        <!-- Status Tag Badge -->
        <div class="inline-flex items-center gap-2.5 rounded-full border border-indigo-500/40 bg-indigo-500/10 px-4 py-2 text-xs font-mono font-semibold text-indigo-300 backdrop-blur-md shadow-inner">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span>Disponible para Nuevos Proyectos &amp; Consultoría</span>
        </div>

        <!-- Main Headline -->
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.15]">
          Transformamos procesos caóticos en <span class="bg-gradient-to-r from-indigo-400 via-purple-300 to-cyan-400 bg-clip-text text-transparent">software de alto rendimiento</span>.
        </h1>

        <!-- Secondary Description -->
        <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto lg:mx-0 leading-relaxed">
          Construcción de sistemas a la medida, automatizaciones sin fricción y arquitectura sólida para empresas que no pueden permitirse fallar.
        </p>

        <p class="text-sm sm:text-base text-slate-400 max-w-2xl mx-auto lg:mx-0 leading-relaxed font-normal">
          Desde aplicaciones escalables hasta automatización de operaciones. Soluciones técnicas reales con código limpio y entregas oportunas.
        </p>

        <!-- Tech Badges visuales -->
        <div class="pt-2">
          <p class="text-xs font-mono font-bold text-slate-400 uppercase tracking-wider mb-3">
            Dominio Técnico Destacado:
          </p>
          <div class="flex flex-wrap items-center justify-center lg:justify-start gap-2.5">
            {techBadges.map((badge) => (
              <span class={`inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border text-xs font-bold font-mono transition hover:scale-105 ${badge.color}`}>
                <span>{badge.icon}</span>
                <span>{badge.name}</span>
              </span>
            ))}
          </div>
        </div>

        <!-- CTA Buttons -->
        <div class="pt-4 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
          <button
            type="button"
            data-trigger-whatsapp
            data-whatsapp-msg="Hola Aleric.dev, me interesa iniciar un proyecto con ustedes. Quisiera solicitar una cotización."
            class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-gradient-to-r from-indigo-600 via-indigo-500 to-cyan-500 text-white font-extrabold text-sm uppercase tracking-wider shadow-xl shadow-indigo-600/30 hover:shadow-indigo-500/50 hover:scale-[1.03] active:scale-[0.98] transition cursor-pointer border border-indigo-400/40 flex items-center justify-center gap-3 group"
          >
            <span>Cotizar Proyecto por WhatsApp</span>
            <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </button>

          <a
            href="#servicios"
            class="w-full sm:w-auto px-7 py-4 rounded-2xl bg-slate-900/90 hover:bg-slate-800 text-slate-200 hover:text-white font-bold text-sm border border-slate-800 transition flex items-center justify-center gap-2"
          >
            <span>Ver Servicios</span>
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </a>
        </div>

      </div>

      <!-- Hero Visual Right (Code & Architecture Showcase Card) -->
      <div class="lg:col-span-5">
        <div class="relative rounded-3xl border border-slate-800 bg-slate-900/80 p-6 shadow-2xl backdrop-blur-xl glow-border">
          
          <!-- Top Mockup Window Header -->
          <div class="flex items-center justify-between pb-4 border-b border-slate-800/80">
            <div class="flex items-center gap-2">
              <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
              <div class="w-3 h-3 rounded-full bg-amber-500/80"></div>
              <div class="w-3 h-3 rounded-full bg-emerald-500/80"></div>
            </div>
            <span class="text-xs font-mono text-slate-400">architecture-system.ts</span>
          </div>

          <!-- Code & Metric Demonstration Body -->
          <div class="mt-4 space-y-3 font-mono text-xs text-slate-300 leading-relaxed">
            <div class="text-slate-400">// Aleric.dev Core Engineering Standards</div>
            <div>
              <span class="text-indigo-400">const</span> <span class="text-cyan-300">systemArchitecture</span> = &#123;
            </div>
            <div class="pl-4">
              <span class="text-purple-300">performance:</span> <span class="text-emerald-400">'100/100 Lighthouse'</span>,
            </div>
            <div class="pl-4">
              <span class="text-purple-300">reliability:</span> <span class="text-emerald-400">'Zero Downtime'</span>,
            </div>
            <div class="pl-4">
              <span class="text-purple-300">automation:</span> <span class="text-cyan-300">['n8n', 'WhatsApp API']</span>,
            </div>
            <div class="pl-4">
              <span class="text-purple-300">stack:</span> <span class="text-cyan-300">['TypeScript', 'React', 'NestJS', 'PostgreSQL']</span>
            </div>
            <div>&#125;;</div>

            <div class="pt-3 text-slate-400">// Output Audit Status</div>
            <div class="p-3 rounded-xl bg-slate-950/80 border border-emerald-500/30 flex items-center justify-between text-xs font-sans">
              <div class="flex items-center gap-2">
                <span class="text-emerald-400 font-bold">✓ SSL &amp; Security:</span>
                <span class="text-slate-200">A+ Grade</span>
              </div>
              <span class="text-emerald-400 font-mono font-bold">PASS</span>
            </div>
          </div>

          <!-- Floating Metric Badge 1 -->
          <div class="absolute -bottom-5 -left-5 bg-slate-900 border border-slate-700/80 p-3.5 rounded-2xl shadow-xl flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-lg">
              ⚡
            </div>
            <div>
              <p class="text-xs font-bold text-white">Rendimiento 100/100</p>
              <p class="text-[11px] text-slate-400">Optimización extrema</p>
            </div>
          </div>

          <!-- Floating Metric Badge 2 -->
          <div class="absolute -top-5 -right-5 bg-slate-900 border border-slate-700/80 p-3.5 rounded-2xl shadow-xl flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-indigo-500/20 text-indigo-400 flex items-center justify-center font-bold text-lg">
              🛡️
            </div>
            <div>
              <p class="text-xs font-bold text-white">Código Limpio</p>
              <p class="text-[11px] text-slate-400">Arquitectura sólida</p>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
