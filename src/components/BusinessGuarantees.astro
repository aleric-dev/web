---
interface GuaranteeRow {
  step: string;
  badge: string;
  badgeColor: string;
  title: string;
  summary: string;
  points: string[];
  imageSrc: string;
  imageAlt: string;
  imagePill: string;
}

const guarantees: GuaranteeRow[] = [
  {
    step: "01",
    badge: "A LA MEDIDA",
    badgeColor: "border-indigo-200 dark:border-indigo-900 bg-indigo-50 dark:bg-indigo-950/60 text-indigo-700 dark:text-indigo-300",
    title: "Desarrollo Personalizado Adaptado a tu Empresa",
    summary:
      "Construimos soluciones diseñadas exactamente según la operación de tu negocio. Cero plantillas genéricas que te obligan a cambiar cómo trabajas.",
    points: [
      "Arquitectura construida para tus flujos de trabajo específicos.",
      "Sin limitaciones de plugins o plataformas rígidas que no se dejan adaptar."
    ],
    imageSrc: "/assets/guarantees/guarantee-custom.jpg",
    imageAlt: "Ingeniería y desarrollo de software adaptado a la medida de la empresa Aleric.dev",
    imagePill: "Arquitectura Propia · Flujos a la Medida"
  },
  {
    step: "02",
    badge: "ACTIVO PROPIO",
    badgeColor: "border-emerald-200 dark:border-emerald-900 bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300",
    title: "Propiedad 100% de tu Empresa",
    summary:
      "El código fuente, los accesos a la nube y las bases de datos son activos de tu empresa. Cero cobros obligatorios de licenciamiento por usuario o empleado.",
    points: [
      "Entrega formal de código fuente y credenciales maestras en tu infraestructura.",
      "Tus datos de clientes son tuyos: sin cláusulas de permanencia ni secuestro de información."
    ],
    imageSrc: "/assets/guarantees/guarantee-ownership.jpg",
    imageAlt: "Contrato formal de propiedad intelectual y código fuente Aleric.dev",
    imagePill: "Entrega Contractual · Propiedad Absoluta"
  },
  {
    step: "03",
    badge: "SUSCRIPCIÓN OPCIONAL",
    badgeColor: "border-cyan-200 dark:border-cyan-900 bg-cyan-50 dark:bg-cyan-950/60 text-cyan-700 dark:text-cyan-300",
    title: "Soporte Extendido por Suscripción",
    summary:
      "Mantenimiento preventivo, soporte técnico prioritario y evolución de nuevas funciones bajo una suscripción mensual predecible. Tu software nunca queda solo.",
    points: [
      "Monitoreo proactivo de servidores, parches de seguridad y copias de respaldo.",
      "Evolución continua y atención prioritaria para cuando tu empresa decida crecer."
    ],
    imageSrc: "/assets/guarantees/guarantee-support.jpg",
    imageAlt: "Monitoreo y soporte técnico continuo de servidores Aleric.dev",
    imagePill: "Monitoreo Proactivo · Soporte Prioritario"
  }
];
---

<section id="garantias" class="py-16 sm:py-24 bg-slate-50 dark:bg-slate-950 border-b border-slate-200 dark:border-slate-800 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-6">
    
    <!-- Encabezado Editorial -->
    <div class="max-w-3xl mb-14 sm:mb-20 space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 font-mono text-[11px] font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        <span>Compromiso &amp; Modelo Sostenible</span>
      </div>

      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-[1.15]">
        Tranquilidad para tu empresa <span class="text-emerald-600 dark:text-emerald-400">desde el primer día</span>
      </h2>

      <p class="text-slate-600 dark:text-slate-400 text-sm sm:text-base leading-relaxed">
        Un modelo claro diseñado para que tu inversión se convierta en un activo real y respaldado:
      </p>
    </div>

    <!-- Filas Estructuradas Editoriales (Sin Cards Flotantes) -->
    <div class="divide-y divide-slate-200 dark:divide-slate-800 border-y border-slate-200 dark:border-slate-800">
      {guarantees.map((item) => (
        <div class="py-10 sm:py-14 grid lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          
          <!-- Columna Izquierda: Información & Promesa de Negocio -->
          <div class="lg:col-span-7 space-y-4">
            
            <div class="flex items-center gap-3">
              <span class="font-mono text-2xl sm:text-3xl font-black text-slate-400 dark:text-slate-600">
                {item.step}
              </span>
              <span class={`inline-block px-2.5 py-0.5 rounded-md border font-mono text-[10px] font-bold tracking-wider ${item.badgeColor}`}>
                {item.badge}
              </span>
            </div>

            <h3 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight">
              {item.title}
            </h3>

            <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed">
              {item.summary}
            </p>

            <!-- Bullets de Valor -->
            <ul class="space-y-2 pt-1">
              {item.points.map((pt) => (
                <li class="flex items-start gap-2 text-xs sm:text-sm text-slate-600 dark:text-slate-400">
                  <span class="text-emerald-500 font-bold shrink-0">✓</span>
                  <span>{pt}</span>
                </li>
              ))}
            </ul>

          </div>

          <!-- Columna Derecha: Fotografía Realista Panorámica Compacta -->
          <div class="lg:col-span-5 w-full">
            <div class="relative rounded-2xl overflow-hidden border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
              <img
                src={item.imageSrc}
                alt={item.imageAlt}
                class="w-full h-48 sm:h-56 object-cover"
                width="640"
                height="360"
                loading="lazy"
              />
              <div class="absolute bottom-2.5 left-2.5 bg-slate-900/90 dark:bg-slate-950/90 backdrop-blur-xs border border-slate-700/60 rounded-lg px-2.5 py-1 text-[11px] font-mono font-bold text-white flex items-center gap-1.5 shadow-sm">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                <span>{item.imagePill}</span>
              </div>
            </div>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
