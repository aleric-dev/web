---
const timelineSteps = [
  {
    step: '01',
    phase: 'Diagnóstico',
    title: 'Alcance & Precio Fijo',
    desc: 'Analizamos tus necesidades exactas y te entregamos una propuesta formal con presupuesto cerrado y cronograma garantizado, sin costos ocultos.',
    icon: '🎯',
    color: 'border-indigo-500 bg-indigo-50 dark:bg-indigo-950/80 text-indigo-600 dark:text-indigo-400',
  },
  {
    step: '02',
    phase: 'Prototipo',
    title: 'Demostración Funcional',
    desc: 'Diseñamos una maqueta interactiva y navegable para que pruebes y apruebes cómo funcionará cada pantalla antes de escribir código.',
    icon: '🚀',
    color: 'border-cyan-500 bg-cyan-50 dark:bg-cyan-950/80 text-cyan-600 dark:text-cyan-400',
  },
  {
    step: '03',
    phase: 'Construcción',
    title: 'Desarrollo & Conexiones',
    desc: 'Programamos con ingeniería limpia y conectamos tus bases de datos, WhatsApp o pasarelas, con revisiones y pruebas funcionales periódicas.',
    icon: '⚡',
    color: 'border-emerald-500 bg-emerald-50 dark:bg-emerald-950/80 text-emerald-600 dark:text-emerald-400',
  },
  {
    step: '04',
    phase: 'Lanzamiento',
    title: 'Puesta en Marcha & Soporte',
    desc: 'Desplegamos en la nube con monitoreo activo, entregándote el 100% del código fuente y accesos de tu propiedad con garantía post-entrega.',
    icon: '🛡️',
    color: 'border-amber-500 bg-amber-50 dark:bg-amber-950/80 text-amber-600 dark:text-amber-400',
  },
];
---

<section id="metodologia-y-garantia" class="scroll-mt-20 py-20 bg-slate-50 dark:bg-slate-950 border-t border-slate-200 dark:border-slate-800 transition-colors duration-300">
  <div class="max-w-4xl mx-auto px-6">
    
    <!-- Encabezado Directo y Preciso -->
    <div class="text-center max-w-2xl mx-auto mb-16 space-y-3">
      <span class="inline-block px-3.5 py-1.5 rounded-full bg-indigo-100 dark:bg-indigo-950 border border-indigo-200 dark:border-indigo-800 text-indigo-700 dark:text-indigo-300 text-xs font-bold uppercase tracking-wider">
        Método Ágil &amp; Cronograma
      </span>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 dark:text-white tracking-tight">
        De la Idea a Producción en <span class="text-indigo-600 dark:text-indigo-400">4 Pasos</span>
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-base leading-relaxed">
        Un proceso ordenado, sin sorpresas técnicas y con entregas funcionales continuas.
      </p>
    </div>

    <!-- Timeline Vertical (Uno abajo del otro) -->
    <div class="relative max-w-3xl mx-auto">
      
      <!-- Línea conectora vertical -->
      <div class="absolute top-7 bottom-7 left-6 sm:left-7 w-0.5 bg-slate-200 dark:bg-slate-800 z-0"></div>

      <!-- Pasos Verticales Secuenciales -->
      <div class="space-y-6 sm:space-y-8 relative z-10">
        {timelineSteps.map((item) => (
          <div class="flex items-start gap-4 sm:gap-6 group">
            
            <!-- Indicador Circular/Badge del Paso -->
            <div class={`w-12 h-12 sm:w-14 sm:h-14 rounded-2xl flex items-center justify-center font-mono font-black text-sm sm:text-base border-2 shrink-0 ${item.color} shadow-xs group-hover:scale-105 transition-transform duration-200 bg-white dark:bg-slate-900 relative z-10`}>
              {item.step}
            </div>

            <!-- Tarjeta Limpia con 1 Solo Párrafo -->
            <div class="flex-1 p-5 sm:p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs hover:border-indigo-500/40 hover:shadow-sm transition-all duration-200">
              <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
                  <span>{item.icon}</span>
                  <span>{item.title}</span>
                </h3>
                <span class="px-2.5 py-0.5 rounded-lg bg-slate-100 dark:bg-slate-800 text-[11px] font-mono font-semibold text-slate-600 dark:text-slate-300">
                  {item.phase}
                </span>
              </div>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed font-normal">
                {item.desc}
              </p>
            </div>

          </div>
        ))}
      </div>

    </div>

    <!-- Garantías Rápidas Inferiores -->
    <div class="mt-14 text-center">
      <div class="inline-flex flex-wrap items-center justify-center gap-6 px-6 py-3 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs text-slate-600 dark:text-slate-400 shadow-xs">
        <span class="flex items-center gap-1.5 font-semibold text-slate-800 dark:text-slate-200">
          <span class="text-emerald-500">✓</span> Presupuesto cerrado por contrato
        </span>
        <span class="hidden sm:inline text-slate-300 dark:text-slate-700">•</span>
        <span class="flex items-center gap-1.5 font-semibold text-slate-800 dark:text-slate-200">
          <span class="text-emerald-500">✓</span> Entregas funcionales continuas
        </span>
        <span class="hidden sm:inline text-slate-300 dark:text-slate-700">•</span>
        <span class="flex items-center gap-1.5 font-semibold text-slate-800 dark:text-slate-200">
          <span class="text-emerald-500">✓</span> Código 100% de tu propiedad
        </span>
      </div>
    </div>

  </div>
</section>
