---
const masterSteps = [
  {
    step: '01',
    title: 'Diagnóstico',
    desc: 'Analizamos tus necesidades comerciales y definimos un alcance claro con presupuesto cerrado.',
    guaranteeIcon: '💬',
    guarantee: 'Trato directo con ingenieros, sin intermediarios.',
    accent: 'border-indigo-500/30 text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-950/50',
  },
  {
    step: '02',
    title: 'Demo',
    desc: 'Te presentamos una demostración funcional tangible de la solución adaptada a tu caso particular.',
    guaranteeIcon: '🚀',
    guarantee: 'Sistemas escalables y preparados para crecer.',
    accent: 'border-cyan-500/30 text-cyan-600 dark:text-cyan-400 bg-cyan-50 dark:bg-cyan-950/50',
  },
  {
    step: '03',
    title: 'Implementación',
    desc: 'Construimos, conectamos con tus sistemas o datos y dejamos la plataforma 100% operativa.',
    guaranteeIcon: '🔑',
    guarantee: 'Propiedad 100% tuya del código y accesos.',
    accent: 'border-emerald-500/30 text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/50',
  },
  {
    step: '04',
    title: 'Soporte',
    desc: 'Puesta en marcha definitiva con monitoreo continuo, resolución de dudas y respaldo activo.',
    guaranteeIcon: '🛡️',
    guarantee: 'Garantía post-entrega y acompañamiento real.',
    accent: 'border-amber-500/30 text-amber-600 dark:text-amber-400 bg-amber-50 dark:bg-amber-950/50',
  },
];
---

<section id="metodologia-y-garantia" class="scroll-mt-20 py-14 lg:py-16 bg-slate-50 dark:bg-slate-950 border-t border-slate-200 dark:border-slate-800 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-6">
    
    <!-- Encabezado Compacto y Directo -->
    <div class="text-center max-w-2xl mx-auto mb-10 space-y-2.5">
      <span class="inline-block px-3 py-1 rounded-full bg-indigo-100 dark:bg-indigo-950 border border-indigo-200 dark:border-indigo-800 text-indigo-700 dark:text-indigo-300 text-xs font-bold uppercase tracking-wider">
        Método Ágil &amp; Garantía
      </span>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        De la Necesidad a la Solución en 4 Pasos
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-xs sm:text-sm">
        Proceso transparente, sin sorpresas y con código 100% de tu propiedad.
      </p>
    </div>

    <!-- 4 Tarjetas Maestras en Fila Horizontal Compacta (Opción A) -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-5">
      {masterSteps.map((s) => (
        <div class="p-5 sm:p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm flex flex-col justify-between hover:border-indigo-400 dark:hover:border-indigo-600 transition duration-200 group">
          <div class="space-y-3">
            <!-- Cabecera de la tarjeta: Número + Título -->
            <div class="flex items-center justify-between">
              <span class={`px-2.5 py-1 rounded-xl text-xs font-mono font-black border ${s.accent}`}>
                Paso {s.step}
              </span>
              <h3 class="text-base font-bold text-slate-900 dark:text-white">
                {s.title}
              </h3>
            </div>

            <!-- Descripción clara y corta -->
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
              {s.desc}
            </p>
          </div>

          <!-- Compromiso / Garantía Integrada al pie de la tarjeta -->
          <div class="pt-3.5 mt-4 border-t border-slate-100 dark:border-slate-800/80 flex items-start gap-2 text-[11px] text-slate-700 dark:text-slate-300 font-medium">
            <span class="text-sm shrink-0 leading-none">{s.guaranteeIcon}</span>
            <span class="leading-tight">{s.guarantee}</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
