---
const faqs = [
  {
    question: '¿Cuánto tiempo tarda en estar listo un proyecto?',
    answer:
      'Una página web o landing comercial toma entre 5 y 10 días hábiles. Un desarrollo de software a medida o automatización de WhatsApp toma entre 2 y 4 semanas, con entregas funcionales semanales para que pruebes los avances en vivo.',
  },
  {
    question: '¿El código y los accesos son 100% de mi propiedad?',
    answer:
      'Totalmente sí. Desplegamos en tus propias cuentas y te entregamos la totalidad del código fuente sin letras pequeñas. Cero ataduras ni mensualidades obligatorias de permanencia. El software es tuyo.',
  },
  {
    question: '¿Cómo se maneja el esquema de pagos?',
    answer:
      'Trabajamos con hitos claros: 50% de anticipo para iniciar la arquitectura y desarrollo, y el 50% restante únicamente contra entrega final probada y aprobada a tu entera satisfacción.',
  },
  {
    question: '¿Necesito tener conocimientos técnicos para trabajar con ustedes?',
    answer:
      'Para nada. Hablamos de tus procesos, ventas y clientes en español claro. Nosotros asumimos el 100% de la arquitectura, conexiones de bases de datos, seguridad y desarrollo técnico.',
  },
  {
    question: '¿Qué sucede si después del lanzamiento necesito ajustes o soporte?',
    answer:
      'Todos los proyectos incluyen período de soporte post-entrega para resolver cualquier duda o ajuste sin costo adicional. Además, cuentas con la opción de soporte mensual o bolsa de horas bajo demanda.',
  },
];
---

<section id="faq" class="scroll-mt-20 py-20 bg-white dark:bg-slate-900/60 border-t border-slate-200 dark:border-slate-800 transition-colors duration-300">
  <div class="max-w-4xl mx-auto px-6">
    
    <!-- Encabezado Centrado con Tipografía Mayor -->
    <div class="text-center max-w-4xl mx-auto mb-12 sm:mb-14">
      <h2 class="text-3xl sm:text-4xl lg:text-[2.75rem] font-black text-slate-900 dark:text-white tracking-tight leading-[1.15]">
        Preguntas Frecuentes
      </h2>
    </div>

    <!-- Lista de Preguntas Frecuentes (Acordeón HTML5 Nativo) -->
    <div class="space-y-3.5">
      {faqs.map((faq, index) => (
        <details
          class="group rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900 transition-all duration-200 overflow-hidden shadow-xs open:border-emerald-500/40 open:bg-white dark:open:bg-slate-900 open:shadow-sm"
          open={index === 0}
        >
          <summary class="flex items-center justify-between gap-4 p-5 cursor-pointer list-none select-none text-left focus:outline-none">
            <!-- Pregunta a la izquierda -->
            <span class="text-sm sm:text-base font-bold text-slate-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
              {faq.question}
            </span>

            <!-- Flecha interactiva a la derecha -->
            <span class="w-7 h-7 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 flex items-center justify-center shrink-0 group-open:rotate-180 group-open:bg-emerald-500 group-open:text-white transition-all duration-200 text-xs">
              ▼
            </span>
          </summary>
          <div class="px-5 pb-5 pt-1 text-sm text-slate-600 dark:text-slate-300 leading-relaxed border-t border-slate-100 dark:border-slate-800/80">
            {faq.answer}
          </div>
        </details>
      ))}
    </div>

    <!-- Micro CTA Directo y Discreto -->
    <div class="mt-10 text-center">
      <p class="text-xs text-slate-500 dark:text-slate-400">
        ¿Tienes otra consulta en mente? 
        <a
          href="https://wa.me/573013229292?text=Hola%20Aleric.dev,%20tengo%20una%20pregunta%20sobre%20un%20proyecto"
          target="_blank"
          rel="noopener noreferrer"
          class="font-bold text-emerald-600 dark:text-emerald-400 hover:underline ml-1 inline-flex items-center gap-1"
        >
          <span>Pregúntanos por WhatsApp</span>
          <span>💬</span>
        </a>
      </p>
    </div>

  </div>
</section>
