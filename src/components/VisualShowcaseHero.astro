---
// Componente de demostración visual de alta fidelidad para la columna derecha del Hero
// Combina métricas comerciales en tiempo real, micro-pedidos por WhatsApp y rendimiento técnico
---

<div class="relative w-full max-w-lg lg:max-w-none mx-auto select-none">
  <!-- Resplandor sutil de fondo (efecto dinámico sin saturar) -->
  <div class="absolute -top-6 -right-6 w-72 h-72 bg-indigo-500/15 dark:bg-indigo-600/20 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-8 -left-8 w-64 h-64 bg-cyan-500/15 dark:bg-cyan-600/15 rounded-full blur-3xl pointer-events-none"></div>

  <!-- Contenedor Maestro Tipo Ventana de Aplicación (Dashboard) -->
  <div class="relative rounded-3xl border border-slate-200/90 dark:border-slate-800 bg-white/95 dark:bg-slate-900/90 shadow-2xl backdrop-blur-xl p-5 sm:p-7 overflow-hidden transition-all duration-300 hover:shadow-indigo-500/10">
    
    <!-- Barra Superior de la Ventana del Software -->
    <div class="flex items-center justify-between pb-4 border-b border-slate-100 dark:border-slate-800/80">
      <div class="flex items-center gap-2">
        <div class="w-3 h-3 rounded-full bg-rose-400/80 dark:bg-rose-500/60"></div>
        <div class="w-3 h-3 rounded-full bg-amber-400/80 dark:bg-amber-500/60"></div>
        <div class="w-3 h-3 rounded-full bg-emerald-400/80 dark:bg-emerald-500/60"></div>
        <span class="ml-2 text-[11px] font-mono font-medium text-slate-500 dark:text-slate-400 hidden sm:inline">
          panel.tuempresa.com
        </span>
      </div>

      <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800/60 text-emerald-700 dark:text-emerald-300 text-[10px] font-bold font-mono">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>EN VIVO</span>
      </div>
    </div>

    <!-- Cuerpo del Panel: Métricas de Negocio Claramente Entendibles -->
    <div class="pt-5 space-y-4">
      
      <!-- Fila 1: Resumen de Ventas y Crecimiento -->
      <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-950 border border-slate-200/80 dark:border-slate-800/90 flex items-center justify-between">
        <div>
          <p class="text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
            Ventas Online del Mes
          </p>
          <div class="flex items-baseline gap-2 mt-0.5">
            <span class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight">
              $18,450 <span class="text-sm font-semibold text-slate-500">USD</span>
            </span>
          </div>
        </div>

        <div class="text-right">
          <span class="inline-flex items-center px-2 py-0.5 rounded-lg bg-emerald-100 dark:bg-emerald-950/80 text-emerald-700 dark:text-emerald-300 text-xs font-bold font-mono">
            ↑ +38.4%
          </span>
          <p class="text-[10px] text-slate-400 mt-1">vs. mes anterior</p>
        </div>
      </div>

      <!-- Gráfico Miniaturizado Dinámico (SVG Sparkline de Ventas) -->
      <div class="px-2 pt-1">
        <div class="flex items-center justify-between text-[11px] font-medium text-slate-500 dark:text-slate-400 mb-2">
          <span>Tráfico y Conversión Semanal</span>
          <span class="text-indigo-600 dark:text-indigo-400 font-bold">98.6% Efectividad</span>
        </div>
        
        <svg class="w-full h-14 overflow-visible" viewBox="0 0 300 60" fill="none">
          <defs>
            <linearGradient id="chartGradient" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#6366F1" stop-opacity="0.3"></stop>
              <stop offset="100%" stop-color="#6366F1" stop-opacity="0.0"></stop>
            </linearGradient>
          </defs>
          <path
            d="M 0,45 Q 40,35 70,30 T 140,20 T 210,12 T 300,5 L 300,60 L 0,60 Z"
            fill="url(#chartGradient)"
          ></path>
          <path
            d="M 0,45 Q 40,35 70,30 T 140,20 T 210,12 T 300,5"
            stroke="#6366F1"
            stroke-width="3"
            stroke-linecap="round"
          ></path>
          <circle cx="300" cy="5" r="4" fill="#6366F1" class="animate-ping opacity-75"></circle>
          <circle cx="300" cy="5" r="3.5" fill="#4F46E5"></circle>
        </svg>
      </div>

      <!-- Widget Flotante de Simulación WhatsApp en Vivo -->
      <div class="p-3.5 sm:p-4 rounded-2xl bg-emerald-50/70 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-800/60 flex items-start gap-3 transition-transform hover:-translate-y-0.5">
        <div class="w-9 h-9 rounded-xl bg-emerald-500 text-white flex items-center justify-center shrink-0 shadow-sm text-lg">
          💬
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex items-center justify-between gap-2">
            <p class="text-xs font-bold text-slate-900 dark:text-slate-100 truncate">
              Nuevo Pedido Automatizado WhatsApp
            </p>
            <span class="text-[10px] font-mono text-emerald-600 dark:text-emerald-400 font-semibold shrink-0">
              Hace 12s
            </span>
          </div>
          <p class="text-[11px] text-slate-600 dark:text-slate-300 mt-0.5 leading-snug">
            Cliente atendido con cotización express · Factura emitida en tu sistema ERP autom.
          </p>
        </div>
      </div>

      <!-- Métricas Clave de Confianza (Grid de 2 tarjetas) -->
      <div class="grid grid-cols-2 gap-3 pt-1">
        
        <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200/70 dark:border-slate-800/80">
          <div class="flex items-center gap-1.5 text-xs font-bold text-slate-800 dark:text-slate-200">
            <span class="text-amber-500">⚡</span>
            <span>Velocidad Móvil</span>
          </div>
          <p class="text-lg font-black text-slate-900 dark:text-white mt-0.5">
            &lt; 0.6s
          </p>
          <p class="text-[10px] text-slate-500 dark:text-slate-400">Apertura instantánea</p>
        </div>

        <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200/70 dark:border-slate-800/80">
          <div class="flex items-center gap-1.5 text-xs font-bold text-slate-800 dark:text-slate-200">
            <span class="text-indigo-500">🔑</span>
            <span>Código 100% Tuyo</span>
          </div>
          <p class="text-lg font-black text-slate-900 dark:text-white mt-0.5">
            Sin Ataduras
          </p>
          <p class="text-[10px] text-slate-500 dark:text-slate-400">Tú eres el dueño</p>
        </div>

      </div>

    </div>

  </div>

  <!-- Sello Flotante de Rendimiento Exterior (Micro-badge) -->
  <div class="hidden sm:flex absolute -bottom-4 -right-4 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-3 shadow-xl items-center gap-3 animate-fade-in-up">
    <div class="w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-black text-xs font-mono">
      100
    </div>
    <div>
      <p class="text-xs font-bold text-slate-900 dark:text-white">Google Lighthouse</p>
      <p class="text-[10px] text-slate-500">Rendimiento y SEO Máximo</p>
    </div>
  </div>

</div>
