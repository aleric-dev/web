---
const PHONE_NUMBER = "573013229292";
const WHATSAPP_URL = `https://wa.me/${PHONE_NUMBER}?text=Hola%20Aleric.dev,%20quiero%20cotizar%20un%20proyecto`;
const CONTACT_EMAIL = "contacto@aleric.dev";
---

<!-- Barra Flotante Acoplada de Contacto & Ir Arriba (Esquina Inferior Derecha) -->
<div class="fixed bottom-6 right-6 z-50 flex items-center gap-3 select-none">

  <!-- Botón 1: Ir Arriba (Exacto mismo tamaño w-12 h-12, visible al hacer scroll > 300px) -->
  <div
    id="scroll-to-top-wrapper"
    class="transition-all duration-300 opacity-0 invisible translate-y-2 pointer-events-none"
  >
    <button
      type="button"
      id="scroll-to-top-btn"
      class="w-12 h-12 rounded-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 hover:border-indigo-300 dark:hover:border-indigo-800 shadow-xl flex items-center justify-center transition active:scale-95 cursor-pointer"
      aria-label="Ir al inicio de la página"
      title="Ir arriba"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7"></path>
      </svg>
    </button>
  </div>

  <!-- Contenedor Speed Dial de Contacto -->
  <div id="speed-dial-container" class="relative">
    
    <!-- Columna de Botones Vertical (Se despliega hacia arriba con etiquetas a la izquierda) -->
    <div
      id="speed-dial-menu"
      class="absolute bottom-full right-0 mb-3 flex flex-col items-end gap-3 transition-all duration-200 opacity-0 invisible translate-y-3 pointer-events-none"
    >
      <!-- Opción 1: WhatsApp -->
      <a
        href={WHATSAPP_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center gap-2.5 cursor-pointer"
        title="Contactar por WhatsApp"
      >
        <span class="px-3 py-1.5 rounded-xl bg-slate-900/90 dark:bg-slate-800/95 backdrop-blur-md text-white text-xs font-semibold shadow-lg border border-slate-700/50 whitespace-nowrap group-hover:bg-slate-800 transition">
          WhatsApp
        </span>
        <div class="w-11 h-11 rounded-full bg-[#25D366] text-white shadow-xl flex items-center justify-center group-hover:scale-105 transition-transform">
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
        </div>
      </a>

      <!-- Opción 2: Correo -->
      <a
        href={`mailto:${CONTACT_EMAIL}`}
        class="group flex items-center gap-2.5 cursor-pointer"
        title="Enviar Correo"
      >
        <span class="px-3 py-1.5 rounded-xl bg-slate-900/90 dark:bg-slate-800/95 backdrop-blur-md text-white text-xs font-semibold shadow-lg border border-slate-700/50 whitespace-nowrap group-hover:bg-slate-800 transition">
          Correo
        </span>
        <div class="w-11 h-11 rounded-full bg-slate-800 dark:bg-slate-800 text-white border border-slate-700 shadow-xl flex items-center justify-center group-hover:scale-105 transition-transform">
          <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
        </div>
      </a>

      <!-- Opción 3: Formulario Web -->
      <button
        type="button"
        id="btn-action-form"
        class="group flex items-center gap-2.5 cursor-pointer"
        title="Llenar Formulario Web"
      >
        <span class="px-3 py-1.5 rounded-xl bg-slate-900/90 dark:bg-slate-800/95 backdrop-blur-md text-white text-xs font-semibold shadow-lg border border-slate-700/50 whitespace-nowrap group-hover:bg-slate-800 transition">
          Formulario
        </span>
        <div class="w-11 h-11 rounded-full bg-indigo-600 text-white shadow-xl flex items-center justify-center group-hover:scale-105 transition-transform">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
        </div>
      </button>
    </div>

    <!-- Botón Disparador Principal: Mismo tamaño exacto w-12 h-12 con icono oficial básico inverso -->
    <button
      type="button"
      id="speed-dial-trigger"
      class="w-12 h-12 rounded-full bg-[#25D366] hover:bg-[#20bd5a] text-white shadow-xl flex items-center justify-center transition-all duration-200 active:scale-95 cursor-pointer group"
      aria-label="Opciones de contacto"
      aria-expanded="false"
      title="Contactar a Aleric.dev"
    >
      <!-- Icono WhatsApp Básico Inverso (Líneas blancas en burbuja, sin doble círculo) -->
      <svg id="icon-dial-chat" class="w-6 h-6 fill-current text-white transition-transform duration-200 group-hover:scale-110" viewBox="0 0 24 24">
        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
      </svg>

      <!-- Icono de Cruz Cerrar (Visible cuando está abierto) -->
      <svg id="icon-dial-close" class="w-5 h-5 hidden transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

  </div>

</div>

<script is:inline>
  (function() {
    function initFloatingSpeedDial() {
      const trigger = document.getElementById('speed-dial-trigger');
      const menu = document.getElementById('speed-dial-menu');
      const iconChat = document.getElementById('icon-dial-chat');
      const iconClose = document.getElementById('icon-dial-close');
      const topBtn = document.getElementById('scroll-to-top-btn');
      const topWrapper = document.getElementById('scroll-to-top-wrapper');
      const actionForm = document.getElementById('btn-action-form');

      let isOpen = false;

      function toggleMenu() {
        isOpen = !isOpen;
        if (isOpen) {
          menu.classList.remove('opacity-0', 'invisible', 'translate-y-3', 'pointer-events-none');
          menu.classList.add('opacity-100', 'visible', 'translate-y-0', 'pointer-events-auto');
          iconChat.classList.add('hidden');
          iconClose.classList.remove('hidden');
          trigger.setAttribute('aria-expanded', 'true');
        } else {
          menu.classList.add('opacity-0', 'invisible', 'translate-y-3', 'pointer-events-none');
          menu.classList.remove('opacity-100', 'visible', 'translate-y-0', 'pointer-events-auto');
          iconChat.classList.remove('hidden');
          iconClose.classList.add('hidden');
          trigger.setAttribute('aria-expanded', 'false');
        }
      }

      function closeMenu() {
        if (isOpen) toggleMenu();
      }

      if (trigger) {
        trigger.onclick = (e) => {
          e.stopPropagation();
          toggleMenu();
        };
      }

      // Cerrar al hacer clic fuera
      document.addEventListener('click', (e) => {
        if (!e.target.closest('#speed-dial-container')) {
          closeMenu();
        }
      });

      // Scroll hacia el formulario
      if (actionForm) {
        actionForm.onclick = () => {
          closeMenu();
          const contactEl = document.getElementById('contacto');
          if (contactEl) {
            contactEl.scrollIntoView({ behavior: 'smooth' });
          }
        };
      }

      // Scroll to Top
      function handleScroll() {
        if (!topWrapper) return;
        if (window.scrollY > 300) {
          topWrapper.classList.remove('opacity-0', 'invisible', 'translate-y-2', 'pointer-events-none');
          topWrapper.classList.add('opacity-100', 'visible', 'translate-y-0', 'pointer-events-auto');
        } else {
          topWrapper.classList.add('opacity-0', 'invisible', 'translate-y-2', 'pointer-events-none');
          topWrapper.classList.remove('opacity-100', 'visible', 'translate-y-0', 'pointer-events-auto');
        }
      }

      window.addEventListener('scroll', handleScroll, { passive: true });
      handleScroll();

      if (topBtn) {
        topBtn.onclick = (e) => {
          e.preventDefault();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        };
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFloatingSpeedDial);
    } else {
      initFloatingSpeedDial();
    }
    document.addEventListener('astro:page-load', initFloatingSpeedDial);
  })();
</script>
