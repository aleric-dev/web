---
---

<!-- Controles Flotantes (Esquina Inferior Derecha) -->
<div class="fixed bottom-6 right-6 z-40 flex flex-col items-center gap-3">
  
  <!-- Botón 1: Ir Arriba (Flecha) -->
  <div class="relative group flex items-center">
    <!-- Tooltip al hacer hover -->
    <span class="absolute right-full mr-3 px-3 py-1.5 rounded-lg bg-slate-900 dark:bg-slate-800 text-white text-xs font-semibold whitespace-nowrap shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 pointer-events-none">
      Ir arriba
    </span>

    <button
      type="button"
      id="scroll-to-top-btn"
      class="w-11 h-11 rounded-full bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 shadow-md flex items-center justify-center transition active:scale-95 cursor-pointer"
      aria-label="Ir al inicio de la página"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7"></path>
      </svg>
    </button>
  </div>

  <!-- Botón 2: Solicitar Reunión (Ícono Circular + Tooltip) -->
  <div class="relative group flex items-center">
    <!-- Tooltip al hacer hover -->
    <span class="absolute right-full mr-3 px-3 py-1.5 rounded-lg bg-slate-900 dark:bg-slate-800 text-white text-xs font-semibold whitespace-nowrap shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 pointer-events-none">
      Solicitar reunión
    </span>

    <a
      href="#contacto"
      id="floating-contact-btn"
      class="w-12 h-12 rounded-full bg-indigo-600 hover:bg-indigo-700 text-white border border-indigo-500 shadow-xl flex items-center justify-center transition active:scale-95 relative cursor-pointer"
      aria-label="Solicitar reunión de diagnóstico"
    >
      <span class="absolute top-0 right-0 w-3 h-3 rounded-full bg-emerald-400 border-2 border-white dark:border-slate-950 animate-pulse"></span>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
      </svg>
    </a>
  </div>

</div>

<script is:inline>
  (function() {
    function initFloatingControls() {
      const contactBtn = document.getElementById('floating-contact-btn');
      const topBtn = document.getElementById('scroll-to-top-btn');

      if (contactBtn) {
        contactBtn.onclick = (e) => {
          const contactEl = document.getElementById('contacto');
          if (contactEl) {
            e.preventDefault();
            contactEl.scrollIntoView({ behavior: 'smooth' });
          }
        };
      }

      if (topBtn) {
        topBtn.onclick = (e) => {
          e.preventDefault();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        };
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFloatingControls);
    } else {
      initFloatingControls();
    }
    document.addEventListener('astro:after-swap', initFloatingControls);
  })();
</script>

