---

<section id="fugas-operativas" class="py-16 sm:py-24 bg-white dark:bg-slate-950 border-b border-slate-200 dark:border-slate-800 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-6">
    
    <!-- Encabezado 100% Centrado -->
    <div class="text-center max-w-4xl mx-auto mb-10 sm:mb-12">
      <h2 class="text-3xl sm:text-4xl lg:text-[2.75rem] font-black text-slate-900 dark:text-white tracking-tight leading-[1.15]">
        ¿Reconoces alguna de estas <span class="text-rose-600 dark:text-rose-400">fugas operativas</span> en tu empresa?
      </h2>
    </div>

    <!-- Carrusel Deslizante con Foco Central de Tarjetas -->
    <div class="relative">
      <div
        id="leaks-slider-track"
        class="flex gap-4 sm:gap-6 overflow-x-auto pb-8 pt-4 px-4 scrollbar-none select-none"
        style="scrollbar-width: none; -ms-overflow-style: none;"
      >
        {leaks.map((leak, idx) => (
          <article
            data-leak-index={idx}
            class={`leak-card w-[80vw] sm:w-[320px] lg:w-[350px] shrink-0 flex flex-col justify-between rounded-2xl border bg-white dark:bg-slate-900 shadow-sm p-4 sm:p-5 cursor-pointer select-none transition-all duration-500 ease-out ${
              idx === 0
                ? "is-focused scale-100 opacity-100 border-slate-300 dark:border-slate-700 ring-2 ring-rose-500/25 shadow-xl"
                : "scale-[0.92] opacity-40 grayscale-[25%] border-slate-200 dark:border-slate-800/80 hover:opacity-70"
            }`}
          >
            <div>
              <!-- Imagen 16:9 Limpia -->
              <div class="relative rounded-xl overflow-hidden border border-slate-200/80 dark:border-slate-800 aspect-16/9 bg-slate-100 dark:bg-slate-800 mb-3.5">
                <img
                  src={leak.image}
                  alt={leak.alt}
                  class="w-full h-full object-cover"
                  width="480"
                  height="270"
                  loading="lazy"
                />
              </div>

              <!-- Título del Problema en Rojo -->
              <h3 class="text-sm sm:text-[15px] font-extrabold text-rose-600 dark:text-rose-400 leading-snug tracking-tight">
                {leak.title}
              </h3>

              <!-- Descripción Breve con Tipografía Menor y Espaciado Reducido -->
              <p class="text-xs sm:text-[13px] text-slate-600 dark:text-slate-300 leading-snug mt-1.5">
                {leak.description}
              </p>
            </div>

            <!-- Mensaje Sutil de Enlace 'Valida la solución' -->
            <div class="pt-4 mt-auto">
              <a
                href={leak.href}
                class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-900 dark:text-white hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors group/link cursor-pointer"
              >
                <span>Valida la solución</span>
                <span class="transition-transform duration-200 group-hover/link:translate-x-1" aria-hidden="true">→</span>
              </a>
            </div>

          </article>
        ))}
      </div>
    </div>

    <!-- Controles de Deslizamiento Centrados con Indicador de Posición -->
    <div class="flex items-center justify-center gap-3 mt-4 sm:mt-6">
      <button
        type="button"
        id="leaks-scroll-prev"
        class="w-11 h-11 rounded-full border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 flex items-center justify-center transition active:scale-95 cursor-pointer shadow-md"
        aria-label="Deslizar fuga anterior hacia el centro"
        title="Fuga anterior"
      >
        <span class="text-base font-bold">←</span>
      </button>

      <!-- Indicadores de Puntos Discretos -->
      <div id="leaks-dots-container" class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
        {leaks.map((_, idx) => (
          <button
            type="button"
            data-dot-index={idx}
            class={`w-2 h-2 rounded-full transition-all duration-300 cursor-pointer ${
              idx === 0 ? "w-5 bg-rose-500" : "bg-slate-300 dark:bg-slate-700 hover:bg-slate-400"
            }`}
            aria-label={`Ver fuga operativa ${idx + 1}`}
          />
        ))}
      </div>

      <button
        type="button"
        id="leaks-scroll-next"
        class="w-11 h-11 rounded-full border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 flex items-center justify-center transition active:scale-95 cursor-pointer shadow-md"
        aria-label="Deslizar fuga siguiente hacia el centro"
        title="Fuga siguiente"
      >
        <span class="text-base font-bold">→</span>
      </button>
    </div>

  </div>
</section>

<style>
  #leaks-slider-track {
    scroll-behavior: smooth;
    /* Padding dinámico para permitir que la 1ra y última tarjeta queden perfectamente en el centro */
    padding-left: calc(50vw - 160px);
    padding-right: calc(50vw - 160px);
  }

  @media (min-width: 640px) {
    #leaks-slider-track {
      padding-left: calc(50vw - 160px);
      padding-right: calc(50vw - 160px);
    }
  }

  @media (min-width: 1280px) {
    #leaks-slider-track {
      padding-left: calc(50% - 175px);
      padding-right: calc(50% - 175px);
    }
  }

  #leaks-slider-track::-webkit-scrollbar {
    display: none;
  }
</style>

<script is:inline>
  (function() {
    function initLeaksSlider() {
      const track = document.getElementById('leaks-slider-track');
      const prevBtn = document.getElementById('leaks-scroll-prev');
      const nextBtn = document.getElementById('leaks-scroll-next');
      const cards = track ? Array.from(track.querySelectorAll('.leak-card')) : [];
      const dots = Array.from(document.querySelectorAll('[data-dot-index]'));

      if (!track || !cards.length) return;

      let currentIndex = 0;
      let isHovered = false;
      let autoplayTimer = null;
      let isScrolling = false;
      let scrollTimeout = null;

      // Centra una tarjeta específica por índice
      function centerCard(index, smooth = true) {
        if (index < 0) index = cards.length - 1;
        if (index >= cards.length) index = 0;

        currentIndex = index;
        const targetCard = cards[index];
        if (!targetCard) return;

        const trackCenter = track.clientWidth / 2;
        const cardCenter = targetCard.offsetLeft + (targetCard.offsetWidth / 2);
        const targetScrollLeft = cardCenter - trackCenter;

        track.scrollTo({
          left: Math.max(0, targetScrollLeft),
          behavior: smooth ? 'smooth' : 'auto'
        });

        applyFocusStyles(index);
      }

      // Aplica clases de foco visual a la tarjeta central y actualiza puntos
      function applyFocusStyles(activeIndex) {
        cards.forEach((card, idx) => {
          if (idx === activeIndex) {
            card.classList.add('is-focused', 'scale-100', 'opacity-100', 'border-slate-300', 'dark:border-slate-700', 'ring-2', 'ring-rose-500/25', 'shadow-xl');
            card.classList.remove('scale-[0.92]', 'opacity-40', 'grayscale-[25%]', 'border-slate-200', 'dark:border-slate-800/80');
          } else {
            card.classList.remove('is-focused', 'scale-100', 'opacity-100', 'border-slate-300', 'dark:border-slate-700', 'ring-2', 'ring-rose-500/25', 'shadow-xl');
            card.classList.add('scale-[0.92]', 'opacity-40', 'grayscale-[25%]', 'border-slate-200', 'dark:border-slate-800/80');
          }
        });

        dots.forEach((dot, idx) => {
          if (idx === activeIndex) {
            dot.className = 'w-5 h-2 rounded-full bg-rose-500 transition-all duration-300 cursor-pointer';
          } else {
            dot.className = 'w-2 h-2 rounded-full bg-slate-300 dark:bg-slate-700 hover:bg-slate-400 transition-all duration-300 cursor-pointer';
          }
        });
      }

      // Detecta cuál tarjeta está más cerca del centro durante el scroll manual
      function updateFocusOnScroll() {
        const trackRect = track.getBoundingClientRect();
        const trackCenter = trackRect.left + (trackRect.width / 2);

        let closestIndex = 0;
        let minDistance = Infinity;

        cards.forEach((card, idx) => {
          const cardRect = card.getBoundingClientRect();
          const cardCenter = cardRect.left + (cardRect.width / 2);
          const distance = Math.abs(cardCenter - trackCenter);

          if (distance < minDistance) {
            minDistance = distance;
            closestIndex = idx;
          }
        });

        if (closestIndex !== currentIndex) {
          currentIndex = closestIndex;
          applyFocusStyles(currentIndex);
        }
      }

      // Listener de scroll pasivo
      track.addEventListener('scroll', () => {
        if (!isScrolling) {
          window.requestAnimationFrame(updateFocusOnScroll);
        }
        clearTimeout(scrollTimeout);
        scrollTimeout = setTimeout(() => {
          updateFocusOnScroll();
        }, 100);
      }, { passive: true });

      // Botón Siguiente
      if (nextBtn) {
        nextBtn.onclick = (e) => {
          e.preventDefault();
          centerCard(currentIndex + 1);
          restartAutoplay();
        };
      }

      // Botón Anterior
      if (prevBtn) {
        prevBtn.onclick = (e) => {
          e.preventDefault();
          centerCard(currentIndex - 1);
          restartAutoplay();
        };
      }

      // Clic en tarjetas individuales para centrarlas
      cards.forEach((card, idx) => {
        card.addEventListener('click', (e) => {
          // Si el clic fue en el enlace interior, permitir navegar
          if (e.target.closest('a')) return;
          e.preventDefault();
          centerCard(idx);
          restartAutoplay();
        });
      });

      // Clic en los puntos de navegación
      dots.forEach((dot, idx) => {
        dot.addEventListener('click', (e) => {
          e.preventDefault();
          centerCard(idx);
          restartAutoplay();
        });
      });

      // Pausar autoplay al hacer hover o tocar con el dedo
      track.addEventListener('mouseenter', () => { isHovered = true; });
      track.addEventListener('mouseleave', () => { isHovered = false; });
      track.addEventListener('touchstart', () => { isHovered = true; }, { passive: true });
      track.addEventListener('touchend', () => { 
        isHovered = false;
        restartAutoplay();
      });

      // Autoplay pausado: 8 segundos exactos por tarjeta
      function startAutoplay() {
        if (autoplayTimer) clearInterval(autoplayTimer);
        autoplayTimer = setInterval(() => {
          if (!isHovered) {
            centerCard(currentIndex + 1);
          }
        }, 8000);
      }

      function restartAutoplay() {
        startAutoplay();
      }

      // Inicializar centrado en la primera tarjeta
      setTimeout(() => {
        centerCard(0, false);
      }, 50);

      startAutoplay();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initLeaksSlider);
    } else {
      initLeaksSlider();
    }
    document.addEventListener('astro:page-load', initLeaksSlider);
  })();
</script>
