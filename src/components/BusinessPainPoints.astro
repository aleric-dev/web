  id: string;
  image: string;
  alt: string;
  title: string;
  description: string;
  href: string;
}

const leaks: LeakItem[] = [
  {
    id: "fuga-01",
    image: "/assets/leaks/leak-whatsapp.jpg",
    alt: "Fuga comercial en WhatsApp por demora en respuestas",
    title: "Mensajes que se enfrían",
    description: "Tardar en responder hace que el cliente le compre a la competencia en minutos.",
    href: "/automatizaciones",
  },
  {
    id: "fuga-02",
    image: "/assets/leaks/leak-slow-web.jpg",
    alt: "Página web lenta que hace perder el presupuesto de pauta",
    title: "Páginas web lentas",
    description: "Espantan visitas y desperdician tu presupuesto en pauta publicitaria.",
    href: "/desarrollo-web",
  },
  {
    id: "fuga-03",
    image: "/assets/leaks/leak-excel.jpg",
    alt: "Desorden operativo y errores por hojas de cálculo compartidas",
    title: "El descontrol de Excel",
    description: "Fórmulas rotas, pedidos duplicados y datos de tu empresa sin seguridad ni respaldo.",
    href: "/software-a-medida",
  },
  {
    id: "fuga-04",
    image: "/assets/leaks/leak-system.jpg",
    alt: "Sistema caído o código abandonado por el proveedor anterior",
    title: "Sistemas caídos o abandonados",
    description: "Paralizan la operación y atrapan dinero en código que nadie puede mantener.",
    href: "/consultoria-tecnica",
  },
  {
    id: "fuga-05",
    image: "/assets/leaks/leak-quote-delay.jpg",
    alt: "Cotizaciones demoradas por procesos comerciales manuales",
    title: "Cotizaciones que tardan días",
    description: "Tu equipo pasa horas armando propuestas mientras el cliente pierde interés.",
    href: "/automatizaciones",
  },
  {
    id: "fuga-06",
    image: "/assets/leaks/leak-mobile-broken.jpg",
    alt: "Sitio web que falla o se rompe en teléfonos móviles",
    title: "Sitios rotos en móvil",
    description: "El 70% de tus visitas navega en celulares y se va si la web no responde.",
    href: "/desarrollo-web",
  },
  {
    id: "fuga-07",
    image: "/assets/leaks/leak-manual-billing.jpg",
    alt: "Procesos manuales repetitivos y digitación en oficina",
    title: "Digitación manual repetitiva",
    description: "Horas de tu equipo perdidas cruzando inventarios y facturas a mano.",
    href: "/software-a-medida",
  },
  {
    id: "fuga-08",
    image: "/assets/leaks/leak-server-crash.jpg",
    alt: "Servidor colapsado por tráfico pico de campañas",
    title: "Caídas en fechas de alta demanda",
    description: "Tu plataforma colapsa justo cuando lanzas campañas y más clientes entran.",
    href: "/consultoria-tecnica",
  },
  {
    id: "fuga-09",
    image: "/assets/leaks/leak-lost-leads.jpg",
    alt: "Prospectos de campañas sin contactar ni registrar",
    title: "Leads olvidados en la bandeja",
    description: "Prospectos calificados que nunca son contactados por falta de un flujo ágil.",
    href: "/automatizaciones",
  },
  {
    id: "fuga-10",
    image: "/assets/leaks/leak-expensive-saas.jpg",
    alt: "Sobrecostos mensuales por licencias de software genérico",
    title: "Cobros forzados por empleado",
    description: "Pagar mensualidades crecientes por software genérico que limita tu operación.",
