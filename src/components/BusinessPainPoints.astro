---

<section id="fugas-operativas" class="py-16 sm:py-24 bg-white dark:bg-slate-950 border-b border-slate-200 dark:border-slate-800 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-6">
    
    <!-- Encabezado 100% Centrado -->
    <div class="text-center max-w-4xl mx-auto mb-10 sm:mb-12">
      <h2 class="text-3xl sm:text-4xl lg:text-[2.75rem] font-black text-slate-900 dark:text-white tracking-tight leading-[1.15]">
        ¿Reconoces alguna de estas <span class="text-rose-600 dark:text-rose-400">fugas operativas</span> en tu empresa?
      </h2>
    </div>

    <!-- Carrusel Deslizante Infinito de Tarjetas -->
    <div
      id="leaks-slider-track"
      class="flex gap-5 sm:gap-6 overflow-x-auto scroll-smooth pb-4 pt-1 px-1 -mx-1 scrollbar-none"
      style="scrollbar-width: none; -ms-overflow-style: none;"
    >
      {leaks.map((leak) => (
        <article class="w-[82vw] sm:w-[330px] lg:w-[350px] shrink-0 flex flex-col justify-between rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/90 shadow-sm hover:shadow-md hover:border-slate-300 dark:hover:border-slate-700 transition-all p-4 sm:p-5">
          
          <div>
            <!-- Imagen 16:9 Limpia -->
            <div class="relative rounded-xl overflow-hidden border border-slate-200/80 dark:border-slate-800 aspect-16/9 bg-slate-100 dark:bg-slate-800 mb-3.5">
              <img
                src={leak.image}
                alt={leak.alt}
                class="w-full h-full object-cover"
                width="480"
                height="270"
                loading="lazy"
              />
            </div>

            <!-- Título del Problema en Rojo -->
            <h3 class="text-sm sm:text-[15px] font-extrabold text-rose-600 dark:text-rose-400 leading-snug tracking-tight">
              {leak.title}
            </h3>

            <!-- Descripción Breve con Tipografía Menor y Espaciado Reducido -->
            <p class="text-xs sm:text-[13px] text-slate-600 dark:text-slate-300 leading-snug mt-1.5">
              {leak.description}
            </p>
          </div>

          <!-- Mensaje Sutil de Enlace 'Valida la solución' -->
          <div class="pt-4 mt-auto">
            <a
              href={leak.href}
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-900 dark:text-white hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors group/link cursor-pointer"
            >
              <span>Valida la solución</span>
              <span class="transition-transform duration-200 group-hover/link:translate-x-1" aria-hidden="true">→</span>
            </a>
          </div>

        </article>
      ))}
    </div>

    <!-- Controles de Deslizamiento Centrados -->
    <div class="flex items-center justify-center gap-3 mt-6 sm:mt-8">
      <button
        type="button"
        id="leaks-scroll-prev"
        class="w-11 h-11 rounded-full border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 flex items-center justify-center transition active:scale-95 cursor-pointer shadow-md"
        aria-label="Deslizar fugas hacia la izquierda"
        title="Fuga anterior"
      >
        <span class="text-base font-bold">←</span>
      </button>
      <button
        type="button"
        id="leaks-scroll-next"
        class="w-11 h-11 rounded-full border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 flex items-center justify-center transition active:scale-95 cursor-pointer shadow-md"
        aria-label="Deslizar fugas hacia la derecha"
        title="Fuga siguiente"
      >
        <span class="text-base font-bold">→</span>
      </button>
    </div>

  </div>
</section>

<style>
  #leaks-slider-track::-webkit-scrollbar {
    display: none;
  }
</style>

<script is:inline>
  (function() {
    function initLeaksSlider() {
      const track = document.getElementById('leaks-slider-track');
      const prevBtn = document.getElementById('leaks-scroll-prev');
      const nextBtn = document.getElementById('leaks-scroll-next');

      if (!track || !prevBtn || !nextBtn) return;

      let isHovered = false;
      let autoplayTimer = null;

      const getStep = () => {
        const firstCard = track.querySelector('article');
        if (!firstCard) return 350;
        return firstCard.offsetWidth + 24; // ancho de tarjeta + gap
      };

      const scrollNext = () => {
        const step = getStep();
        const maxScroll = track.scrollWidth - track.clientWidth;
        if (track.scrollLeft >= maxScroll - 30) {
          track.scrollTo({ left: 0, behavior: 'smooth' });
        } else {
          track.scrollBy({ left: step, behavior: 'smooth' });
        }
      };

      const scrollPrev = () => {
        const step = getStep();
        if (track.scrollLeft <= 30) {
          const maxScroll = track.scrollWidth - track.clientWidth;
          track.scrollTo({ left: maxScroll, behavior: 'smooth' });
        } else {
          track.scrollBy({ left: -step, behavior: 'smooth' });
        }
      };

      prevBtn.onclick = (e) => {
        e.preventDefault();
        scrollPrev();
        restartAutoplay();
      };

      nextBtn.onclick = (e) => {
        e.preventDefault();
        scrollNext();
        restartAutoplay();
      };

      // Pausar autoplay al hacer hover o tocar con el dedo
      track.onmouseenter = () => { isHovered = true; };
      track.onmouseleave = () => { isHovered = false; };
      track.ontouchstart = () => { isHovered = true; };
      track.ontouchend = () => { 
        isHovered = false;
        restartAutoplay();
      };

      function startAutoplay() {
        if (autoplayTimer) clearInterval(autoplayTimer);
        autoplayTimer = setInterval(() => {
          if (!isHovered) {
            scrollNext();
          }
        }, 5000);
      }

      function restartAutoplay() {
        startAutoplay();
      }

      startAutoplay();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initLeaksSlider);
    } else {
      initLeaksSlider();
    }
    document.addEventListener('astro:page-load', initLeaksSlider);
  })();
</script>
