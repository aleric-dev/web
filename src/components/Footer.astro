---
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-950 border-t border-slate-900 text-slate-400 py-16 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-slate-900">
      
      <!-- Brand Column -->
      <div class="lg:col-span-2 space-y-4">
        <div class="flex items-center gap-2">
          <div class="w-9 h-9 rounded-xl bg-indigo-600/20 border border-indigo-500/40 flex items-center justify-center text-indigo-400 font-mono text-base font-bold">
            &lt;/&gt;
          </div>
          <span class="text-xl font-black tracking-tight text-white">
            Aleric<span class="text-indigo-400">.dev</span>
          </span>
        </div>

        <p class="text-xs text-slate-400 leading-relaxed max-w-sm">
          Agencia de desarrollo de software, automatizaciones avanzadas y consultoría técnica. Transformamos complejidad operativa en sistemas de alto rendimiento.
        </p>

        <div class="flex items-center gap-2 text-xs font-mono text-emerald-400 pt-2">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
          <span>Sistemas &amp; Infraestructura 100% Operativos</span>
        </div>
      </div>

      <!-- Links Column 1: Servicios -->
      <div class="space-y-3">
        <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-200">Servicios</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="#servicios" class="hover:text-white transition">Desarrollo Web</a></li>
          <li><a href="#servicios" class="hover:text-white transition">Desarrollo a la Medida</a></li>
          <li><a href="#servicios" class="hover:text-white transition">Automatización de Procesos</a></li>
          <li><a href="#servicios" class="hover:text-white transition">Asesorías Tecnológicas</a></li>
          <li><a href="#servicios" class="hover:text-white transition">Consultoría &amp; Mentoría</a></li>
        </ul>
      </div>

      <!-- Links Column 2: Dominio Técnico -->
      <div class="space-y-3">
        <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-200">Dominio Técnico</h4>
        <ul class="space-y-2 text-xs">
          <li><span class="text-slate-400">TypeScript &amp; React</span></li>
          <li><span class="text-slate-400">NestJS &amp; Node.js</span></li>
          <li><span class="text-slate-400">PostgreSQL &amp; Redis</span></li>
          <li><span class="text-slate-400">n8n &amp; WhatsApp API</span></li>
          <li><span class="text-slate-400">Astro &amp; Tailwind CSS</span></li>
        </ul>
      </div>

      <!-- Contact CTA Column -->
      <div class="space-y-4">
        <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-200">Contacto Directo</h4>
        <p class="text-xs text-slate-400">
          ¿Tienes un proyecto en mente? Hablemos directamente por WhatsApp.
        </p>
        <button
          type="button"
          data-trigger-whatsapp
          data-whatsapp-msg="Hola Aleric.dev, quiero solicitar información sobre sus servicios."
          class="w-full py-3 px-4 rounded-xl bg-slate-900 hover:bg-emerald-600 border border-slate-800 hover:border-emerald-500 text-xs font-bold text-slate-200 hover:text-white transition shadow-md flex items-center justify-center gap-2 cursor-pointer"
        >
          <span>Chat de WhatsApp</span>
          <span>💬</span>
        </button>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400 font-mono">
      <p>© {currentYear} Aleric.dev. Todos los derechos reservados.</p>
      <p class="flex items-center gap-2">
        <span>Construido con Astro &amp; Tailwind CSS</span>
        <span>•</span>
        <span class="text-emerald-400">100/100 Lighthouse</span>
      </p>
    </div>
  </div>
</footer>
