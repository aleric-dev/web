---
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-950 border-t border-slate-800 text-slate-300 py-16 sm:py-20 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-6">
    
    <!-- Top Grid: 4 Columnas Altas y Cómodas con texto legible de 14px (text-sm) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-12 pb-12 border-b border-slate-800/80 items-start text-left">
      
      <!-- Columna 1: Identidad Aleric Dev -->
      <div class="space-y-4">
        <a href="/" class="inline-block group">
          <img
            src="/logo/logo-text-light.svg"
            alt="Aleric.dev Logo"
            class="h-9 w-auto object-contain group-hover:opacity-90 transition duration-150"
          />
        </a>

        <div class="space-y-2">
          <p class="text-sm font-semibold text-white">
            Aleric.dev · Estudio de Software
          </p>
          <p class="text-sm text-slate-400 leading-relaxed font-normal">
            Páginas web de alta velocidad, software a la medida y ventas por WhatsApp para acelerar el crecimiento de tu empresa.
          </p>
        </div>
      </div>

      <!-- Columna 2: Soluciones Especializadas -->
      <div class="space-y-4">
        <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-200">Soluciones</h4>
        <ul class="space-y-3 text-sm">
          <li><a href="/desarrollo-web" class="text-slate-400 hover:text-white transition-colors">Desarrollo Web Comercial</a></li>
          <li><a href="/software-a-medida" class="text-slate-400 hover:text-white transition-colors">Software a la Medida</a></li>
          <li><a href="/automatizaciones" class="text-slate-400 hover:text-white transition-colors">Ventas &amp; Atención por WhatsApp</a></li>
          <li><a href="/consultoria-tecnica" class="text-slate-400 hover:text-white transition-colors">Consultoría Técnica Senior</a></li>
        </ul>
      </div>

      <!-- Columna 3: Temas de Interés -->
      <div class="space-y-4">
        <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-200">De Interés</h4>
        <ul class="space-y-3 text-sm">
          <li><a href="/software-a-medida#beneficios" class="text-slate-400 hover:text-white transition-colors">Salir del Desorden de Excel</a></li>
          <li><a href="/desarrollo-web#beneficios" class="text-slate-400 hover:text-white transition-colors">Velocidad Extrema en Celulares</a></li>
          <li><a href="/automatizaciones#beneficios" class="text-slate-400 hover:text-white transition-colors">Atención Inmediata por WhatsApp</a></li>
          <li><a href="/consultoria-tecnica#beneficios" class="text-slate-400 hover:text-white transition-colors">Diagnóstico y Rescate de Software</a></li>
        </ul>
      </div>

      <!-- Columna 4: Contacto Directo -->
      <div class="space-y-4">
        <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-200">Contacto</h4>
        <div class="space-y-3.5 text-sm">
          <div>
            <a
              href="https://wa.me/573013229292?text=Hola%20Aleric.dev,%20me%20gustar%C3%ADa%20cotizar%20un%20proyecto"
              target="_blank"
              rel="noopener noreferrer"
              class="text-slate-300 hover:text-emerald-400 font-mono transition-colors inline-flex items-center gap-2 group"
            >
              <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              <span class="font-medium text-slate-200 group-hover:text-emerald-400 transition-colors">(57) 301 3229292</span>
            </a>
          </div>

          <div class="text-slate-400 flex items-center gap-2">
            <svg class="w-4 h-4 text-slate-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>Cali, Colombia</span>
          </div>

          <!-- Redes Sociales Coherentes -->
          <div class="pt-1 flex items-center gap-2.5">
            <a
              href="mailto:contacto@aleric.dev"
              class="w-9 h-9 rounded-xl bg-slate-900 border border-slate-800 text-slate-400 hover:text-white hover:border-slate-700 hover:bg-slate-800 flex items-center justify-center transition shadow-xs"
              title="contacto@aleric.dev"
              aria-label="Enviar correo a contacto@aleric.dev"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
            </a>

            <a
              href="https://instagram.com/aleric.dev"
              target="_blank"
              rel="noopener noreferrer"
              class="w-9 h-9 rounded-xl bg-slate-900 border border-slate-800 text-slate-400 hover:text-pink-400 hover:border-slate-700 hover:bg-slate-800 flex items-center justify-center transition shadow-xs"
              title="Instagram @aleric.dev"
              aria-label="Instagram @aleric.dev"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke-width="2"></rect>
                <path stroke-width="2" d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" stroke-width="2.5" stroke-linecap="round"></line>
              </svg>
            </a>

            <a
              href="https://linkedin.com/company/aleric-dev"
              target="_blank"
              rel="noopener noreferrer"
              class="w-9 h-9 rounded-xl bg-slate-900 border border-slate-800 text-slate-400 hover:text-sky-400 hover:border-slate-700 hover:bg-slate-800 flex items-center justify-center transition shadow-xs"
              title="LinkedIn aleric-dev"
              aria-label="LinkedIn aleric-dev"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-width="2" d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6z"></path>
                <rect x="2" y="9" width="4" height="12" stroke-width="2"></rect>
                <circle cx="4" cy="4" r="2" stroke-width="2"></circle>
              </svg>
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- Barra Inferior de Derechos -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs sm:text-sm text-slate-500 font-mono text-center sm:text-left">
      <p>© {currentYear} Aleric.dev. Todos los derechos reservados.</p>
      
      <div class="flex flex-wrap items-center justify-center gap-2 text-slate-400 font-sans font-medium">
        <span class="text-indigo-400 font-semibold">Menos palabras, más resultados</span>
        <span class="text-slate-700 hidden sm:inline">•</span>
        <span>Código 100% propio sin ataduras</span>
      </div>
    </div>

  </div>
</footer>
