---
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-950 border-t border-slate-900 text-slate-400 pt-16 pb-24 sm:pb-16 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-6">
    <!-- Top Grid: 3 Clean Columns (Brand, Servicios, Contacto Directo) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 pb-12 border-b border-slate-900 items-start">
      
      <!-- Column 1: Brand -->
      <div class="space-y-4">
        <a href="/" class="inline-block group">
          <img src="/logo.png" alt="Aleric.dev Logo" class="h-12 sm:h-14 w-auto object-contain group-hover:opacity-90 transition duration-200" />
        </a>

        <p class="text-xs text-slate-400 leading-relaxed max-w-sm">
          Agencia de desarrollo de software, automatizaciones avanzadas y consultoría técnica. Transformamos complejidad operativa en sistemas de alto rendimiento.
        </p>

        <div class="flex items-center gap-2 text-xs font-mono text-emerald-400 pt-2">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
          <span>Sistemas &amp; Infraestructura 100% Operativos</span>
        </div>
      </div>

      <!-- Column 2: Servicios -->
      <div class="space-y-3 md:pl-8">
        <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-200">Servicios</h4>
        <ul class="space-y-2.5 text-xs">
          <li><a href="/desarrollo-web" class="hover:text-indigo-400 transition-colors">Desarrollo Web</a></li>
          <li><a href="/software-a-medida" class="hover:text-indigo-400 transition-colors">Software a Medida</a></li>
          <li><a href="/automatizaciones" class="hover:text-indigo-400 transition-colors">Automatización de Procesos</a></li>
          <li><a href="/consultoria-tecnica" class="hover:text-indigo-400 transition-colors">Consultoría &amp; Auditoría</a></li>
          <li><a href="/mentoria-fullstack" class="hover:text-indigo-400 transition-colors">Mentoría Full Stack</a></li>
        </ul>
      </div>

      <!-- Column 3: Contacto Directo -->
      <div class="space-y-4">
        <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-200">Contacto Directo</h4>
        <p class="text-xs text-slate-400 leading-relaxed">
          ¿Tienes un proyecto en mente? Escríbenos o déjanos tus datos y te contactaremos.
        </p>
        <button
          type="button"
          data-trigger-whatsapp
          data-whatsapp-msg="Hola Aleric.dev, quiero solicitar información sobre sus servicios."
          class="w-full py-3.5 px-4 rounded-xl bg-slate-900 hover:bg-indigo-600 border border-slate-800 hover:border-indigo-500 text-xs font-bold text-slate-200 hover:text-white transition duration-200 shadow-md flex items-center justify-center gap-2 cursor-pointer group"
        >
          <span>Solicitar Cotización</span>
          <span class="group-hover:scale-110 transition-transform">💬</span>
        </button>
      </div>

    </div>

    <!-- Bottom Bar (Con Padding Derecho Suficiente para Evitar Colisión con el Botón Flotante) -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400 font-mono pr-0 sm:pr-56">
      <p>© {currentYear} Aleric.dev. Todos los derechos reservados.</p>
      <div class="flex items-center gap-3 text-slate-500 text-[11px]">
        <button type="button" data-trigger-whatsapp data-whatsapp-msg="Hola Aleric.dev, solicito información sobre términos y privacidad." class="hover:text-slate-300 transition cursor-pointer">Términos y Condiciones</button>
        <span>•</span>
        <button type="button" data-trigger-whatsapp data-whatsapp-msg="Hola Aleric.dev, solicito información sobre términos y privacidad." class="hover:text-slate-300 transition cursor-pointer">Política de Privacidad</button>
      </div>
    </div>
  </div>
</footer>
