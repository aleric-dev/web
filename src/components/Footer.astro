---
import { Image } from 'astro:assets';
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-100 dark:bg-slate-950 border-t border-slate-200 dark:border-slate-900 text-slate-600 dark:text-slate-400 md:py-12 py-8 relative overflow-hidden transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-6">
    <!-- Top Grid: 1 Col on Mobile, 2 Cols on MD (Tablet), 3 Cols on LG (Desktop) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-12 pb-12 border-b border-slate-200 dark:border-slate-900 items-start text-center sm:text-left">
      
      <!-- Column 1: Brand & Bio (Spans 2 cols across top row on md, 1 col on lg/mobile) -->
      <div class="sm:col-span-2 lg:col-span-1 space-y-4">
        <!-- Logo & Bio Container: Horizontal on MD, Vertical on Mobile and LG+ -->
        <div class="flex flex-col sm:flex-row lg:flex-col items-center md:items-center lg:items-start gap-0 sm:gap-8 lg:gap-0">
          <a href="/" class="inline-block group shrink-0">
            <!-- Light Mode Logo -->
            <Image
              src="/logo-dark-horizontal.png"
              alt="Aleric.dev Logo"
              width={240}
              height={64}
              class="dark:hidden group-hover:opacity-90 transition duration-200"
            />
            <!-- Dark Mode Logo -->
            <Image
              src="/logo-horizontal.png"
              alt="Aleric.dev Logo Dark"
              width={240}
              height={64}
              class="hidden dark:block group-hover:opacity-90 transition duration-200"
            />
          </a>

          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed max-w-sm md:max-w-md lg:max-w-sm mx-auto sm:mx-0">
            Agencia de desarrollo de software, automatizaciones avanzadas y consultoría técnica. Transformamos complejidad operativa en sistemas de alto rendimiento.
          </p>
        </div>

        <!-- Tag Sistemas 100% Operativos -->
        <div class="flex items-center justify-center sm:justify-start gap-2 text-xs font-mono text-emerald-600 dark:text-emerald-400 pt-1">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
          <span>Sistemas 100% Operativos</span>
        </div>
      </div>

      <!-- Column 2: Soluciones & Servicios -->
      <div class="space-y-3 sm:pl-4">
        <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-900 dark:text-slate-200">Soluciones Principales</h4>
        <ul class="space-y-2.5 text-xs">
          <li><a href="/desarrollo-web" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Desarrollo Web &amp; Landings</a></li>
          <li><a href="/software-a-medida" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Software &amp; SaaS a Medida</a></li>
          <li><a href="/automatizaciones" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Automatización &amp; WhatsApp API</a></li>
          <li><a href="/consultoria-tecnica" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Consultoría &amp; Auditoría CTO</a></li>
          <li><a href="/mentoria-fullstack" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Mentoría &amp; Capacitación Full Stack</a></li>
        </ul>
      </div>

      <!-- Column 3: Especialidades & Stack -->
      <div class="space-y-3 sm:pl-4">
        <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-900 dark:text-slate-200">Especialidades Técnicas</h4>
        <ul class="space-y-2.5 text-xs">
          <li><a href="/desarrollo-web#beneficios" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Landings CRO &amp; E-commerce</a></li>
          <li><a href="/software-a-medida#beneficios" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">APIs REST &amp; Arquitectura SaaS</a></li>
          <li><a href="/automatizaciones#beneficios" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">n8n, Make &amp; Chatwoot Multiagente</a></li>
          <li><a href="/consultoria-tecnica#beneficios" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Auditoría OWASP &amp; Rescate Legacy</a></li>
          <li><a href="/mentoria-fullstack#beneficios" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Clean Code &amp; Testing Automatizado</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar: Centered on Mobile, Justified on SM+ -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500 dark:text-slate-400 font-mono text-center sm:text-left">
      <p>© {currentYear} Aleric.dev. Todos los derechos reservados.</p>
      <div class="flex items-center justify-center gap-4 text-[11px] text-slate-500 dark:text-slate-400">
        <a href="/#contacto" class="hover:text-indigo-600 dark:hover:text-slate-200 transition">Solicitar Propuesta</a>
        <span>•</span>
        <a href="/desarrollo-web" class="hover:text-indigo-600 dark:hover:text-slate-200 transition">Servicios Digitales</a>
      </div>
    </div>
  </div>
</footer>
