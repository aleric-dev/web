---
const lifecyclePhases = [
  { phase: 'Fase 1', title: 'Descubrimiento & Modelado', desc: 'Análisis de lógica de negocio, diseño de base de datos relacional y prototipo interactivo.' },
  { phase: 'Fase 2', title: 'Construcción de MVP', desc: 'Desarrollo del núcleo funcional con arquitectura desacoplada frontend/backend.' },
  { phase: 'Fase 3', title: 'Testing & Hardening', desc: 'Pruebas unitarias, auditoría de seguridad OWASP y optimización de consultas SQL.' },
  { phase: 'Fase 4', title: 'Despliegue & Escala', desc: 'Despliegue en infraestructura Cloud (AWS/Vercel/Docker) con CI/CD automatizado.' },
];
---

<section class="py-16 bg-white dark:bg-slate-900/50 border-b border-slate-200 dark:border-slate-800">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white mb-2">
        Ciclo de Construcción SaaS &amp; Software
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-sm">Garantía de calidad desde el concepto inicial hasta el despliegue a producción.</p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {lifecyclePhases.map((item) => (
        <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950">
          <span class="text-xs font-mono font-bold text-indigo-600 dark:text-indigo-400 block mb-2">{item.phase}</span>
          <h3 class="text-base font-bold text-slate-900 dark:text-white mb-2">{item.title}</h3>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">{item.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
