---
const lifecyclePhases = [
  { phase: 'Paso 1', title: 'Diagnóstico de tu Operación', desc: 'Analizamos cómo trabaja hoy tu equipo, qué archivos de Excel usan y qué tareas manuales consumen más tiempo.' },
  { phase: 'Paso 2', title: 'Prototipo Visual & Aprobación', desc: 'Diseñamos las pantallas del sistema para que veas exactamente cómo interactuará tu equipo antes de construirlo.' },
  { phase: 'Paso 3', title: 'Construcción & Migración de Datos', desc: 'Desarrollo de tu plataforma e importación segura de tus datos históricos de Excel sin pérdida de información.' },
  { phase: 'Paso 4', title: 'Lanzamiento & Capacitación', desc: 'Tu equipo aprende a usar la herramienta fácilmente y tu empresa queda operando con código 100% propio y soporte continuo.' },
];
---

<section class="py-16 bg-white dark:bg-slate-900/50 border-b border-slate-200 dark:border-slate-800">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white mb-2">
        Cómo convertimos tu operación en tu propio software
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-sm">Proceso paso a paso sin traumatismos para tu equipo.</p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {lifecyclePhases.map((item) => (
        <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950">
          <span class="text-xs font-mono font-bold text-indigo-600 dark:text-indigo-400 block mb-2">{item.phase}</span>
          <h3 class="text-base font-bold text-slate-900 dark:text-white mb-2">{item.title}</h3>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">{item.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
