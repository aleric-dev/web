---
interface ComparisonRow {
  area: string;
  before: string;
  after: string;
}

const comparisons: ComparisonRow[] = [
  {
    area: "Atención en WhatsApp",
    before: "Respuestas con 40 minutos de demora; prospectos que se cansan y le compran a la competencia.",
    after: "Respuestas en 2 segundos las 24/7 con cotización automática guiada y cierre directo.",
  },
  {
    area: "Control Operativo",
    before: "Archivos de Excel desfasados, cálculos manuales y personal viendo datos sin restricción.",
    after: "Plataforma web propia con permisos por rol e inventarios actualizados en tiempo real.",
  },
  {
    area: "Página Web Comercial",
    before: "Carga lenta en celulares (>3s) y diseño confuso donde el visitante se va sin contactar.",
    after: "Apertura en menos de 1 segundo y mensaje directo enfocado en cerrar ventas.",
  },
  {
    area: "Propiedad & Costos",
    before: "Mensualidades en dólares que suben por cada empleado nuevo que contrata tu empresa.",
    after: "Código, base de datos e infraestructura 100% tuyos. Cero cobros por usuario.",
  },
];
---

<section id="transformacion" class="py-16 sm:py-24 bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-6">
    
    <!-- Encabezado Centrado con Tipografía Mayor -->
    <div class="text-center max-w-4xl mx-auto mb-12 sm:mb-14">
      <h2 class="text-3xl sm:text-4xl lg:text-[2.75rem] font-black text-slate-900 dark:text-white tracking-tight leading-[1.15]">
        El impacto en tu día a día: <span class="text-indigo-600 dark:text-indigo-400">Antes vs. Con Aleric</span>
      </h2>
    </div>

    <!-- Comparador Estructural Editorial (Tablero Side-by-Side Sin Imágenes Extras) -->
    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 overflow-hidden shadow-xs bg-slate-50 dark:bg-slate-950 divide-y divide-slate-200 dark:divide-slate-800">
      
      <!-- Cabecera de Columnas en Desktop -->
      <div class="hidden md:grid md:grid-cols-12 bg-slate-100/90 dark:bg-slate-900/90 text-xs font-mono uppercase tracking-wider font-bold">
        <div class="col-span-3 px-6 py-4 text-slate-600 dark:text-slate-400 border-r border-slate-200 dark:border-slate-800">
          Área Operativa
        </div>
        <div class="col-span-4 px-6 py-4 text-rose-600 dark:text-rose-400 border-r border-slate-200 dark:border-slate-800 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-rose-500"></span>
          Antes de Aleric (Fricción)
        </div>
        <div class="col-span-5 px-6 py-4 text-emerald-600 dark:text-emerald-400 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          Con Aleric (Solución)
        </div>
      </div>

      <!-- Filas de Comparación con Textos Ultra Sintetizados -->
      {comparisons.map((row) => (
        <div class="grid grid-cols-1 md:grid-cols-12 text-sm transition-colors hover:bg-white dark:hover:bg-slate-900/50">
          
          <!-- Área -->
          <div class="md:col-span-3 px-6 py-4 md:py-5 border-b md:border-b-0 md:border-r border-slate-200 dark:border-slate-800 bg-slate-100/40 dark:bg-slate-900/30 flex items-center">
            <span class="font-bold text-slate-900 dark:text-white text-sm">
              {row.area}
            </span>
          </div>

          <!-- Antes (Fricción) -->
          <div class="md:col-span-4 px-6 py-4 md:py-5 border-b md:border-b-0 md:border-r border-slate-200 dark:border-slate-800 text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed flex items-start gap-2">
            <span class="text-rose-500 font-bold shrink-0">✕</span>
            <p>{row.before}</p>
          </div>

          <!-- Con Aleric (Escalabilidad) -->
          <div class="md:col-span-5 px-6 py-4 md:py-5 text-xs sm:text-sm text-slate-800 dark:text-slate-200 leading-relaxed bg-emerald-50/20 dark:bg-emerald-950/10 flex items-start gap-2">
            <span class="text-emerald-500 font-bold shrink-0">✓</span>
            <p class="font-medium text-slate-900 dark:text-slate-100">{row.after}</p>
          </div>

        </div>
      ))}

    </div>

    <!-- Llamado a la Acción Inferior -->
    <div class="mt-10 text-center">
      <a
        href="#contacto"
        class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs uppercase tracking-wider shadow-sm transition"
      >
        <span>Transformar la Operación de mi Empresa</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>

  </div>
</section>
