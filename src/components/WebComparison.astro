---
const comparisonData = [
  { feature: 'Tiempo de Carga en Celular', trad: '4 a 6 segundos (Pierdes el 50% de las visitas)', aleric: '< 0.5 seg (Abre instantáneamente)' },
  { feature: 'Enfoque de Conversión', trad: 'Menús dispersos y textos largos que cansan', aleric: '1 Objetivo Claro: Comprar o escribirte' },
  { feature: 'Canal de Contacto Directo', trad: 'Formularios eternos que pocos completan', aleric: 'WhatsApp directo + Pagos fáciles' },
  { feature: 'Retorno de tu Publicidad (Ads)', trad: 'Bajo (La gente se aburre esperando)', aleric: 'Máximo (Aprovechas cada peso invertido)' },
  { feature: 'Estabilidad y Mantenimiento', trad: 'Caídas constantes y plugins desactualizados', aleric: 'Sistemas que nunca se caen ni fallan' },
];
---

<section class="py-16 bg-white dark:bg-slate-900/50 border-b border-slate-200 dark:border-slate-800">
  <div class="max-w-5xl mx-auto px-6">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white mb-2">
        Sitio Web Tradicional vs Landing Comercial Aleric
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-sm">¿Por qué nuestras páginas multiplican tus ventas?</p>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs sm:text-sm border-collapse">
        <thead>
          <tr class="border-b border-slate-200 dark:border-slate-800 text-slate-500">
            <th class="py-3 px-4 font-bold">Factor Comercial</th>
            <th class="py-3 px-4 font-bold text-slate-400">Página Web Tradicional</th>
            <th class="py-3 px-4 font-bold text-cyan-600 dark:text-cyan-400">Landing Comercial Aleric</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
          {comparisonData.map((row) => (
            <tr>
              <td class="py-4 px-4 font-semibold text-slate-900 dark:text-white">{row.feature}</td>
              <td class="py-4 px-4 text-slate-500 dark:text-slate-400">{row.trad}</td>
              <td class="py-4 px-4 font-bold text-cyan-600 dark:text-cyan-400 bg-cyan-50/50 dark:bg-cyan-950/20">{row.aleric}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
