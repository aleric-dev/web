---
---

<header class="fixed top-0 left-0 right-0 z-40 backdrop-blur-md bg-slate-950/85 border-b border-slate-800/80 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center group">
      <img src="/logo.png" alt="Aleric.dev" class="h-13 sm:h-14 w-auto object-contain group-hover:scale-105 transition duration-200" />
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center gap-7 text-xs font-bold uppercase tracking-wider text-slate-300">
      <a href="/desarrollo-web" class="hover:text-indigo-400 transition-colors py-1">Desarrollo Web</a>
      <a href="/software-a-medida" class="hover:text-indigo-400 transition-colors py-1">Software a Medida</a>
      <a href="/automatizaciones" class="hover:text-indigo-400 transition-colors py-1">Automatización</a>
      <a href="/consultoria-tecnica" class="hover:text-indigo-400 transition-colors py-1">Consultoría CTO</a>
      <a href="/mentoria-fullstack" class="hover:text-indigo-400 transition-colors py-1">Mentoría Devs</a>
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-4">
      <button
        type="button"
        data-trigger-whatsapp
        data-whatsapp-msg="Hola Aleric.dev, me gustaría solicitar una cotización para mi proyecto."
        class="hidden sm:inline-flex items-center justify-center px-5 py-2.5 rounded-xl bg-gradient-to-r from-indigo-600 to-indigo-500 text-white font-bold text-xs uppercase tracking-wider shadow-lg shadow-indigo-600/20 hover:shadow-indigo-500/40 hover:scale-105 transition cursor-pointer border border-indigo-400/30"
      >
        Cotizar Proyecto
      </button>

      <!-- Mobile Menu Toggle Button -->
      <button
        type="button"
        id="mobile-menu-btn"
        class="lg:hidden p-2 text-slate-300 hover:text-white rounded-xl bg-slate-900 border border-slate-800"
        aria-label="Abrir menú"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden lg:hidden bg-slate-900/95 border-b border-slate-800 px-6 py-6 space-y-4 text-center">
    <a href="/desarrollo-web" class="block text-slate-200 font-semibold py-2 hover:text-indigo-400">🌐 Desarrollo Web</a>
    <a href="/software-a-medida" class="block text-slate-200 font-semibold py-2 hover:text-indigo-400">🚀 Software &amp; SaaS a Medida</a>
    <a href="/automatizaciones" class="block text-slate-200 font-semibold py-2 hover:text-indigo-400">⚡ Automatización &amp; WhatsApp</a>
    <a href="/consultoria-tecnica" class="block text-slate-200 font-semibold py-2 hover:text-indigo-400">🛡️ Consultoría &amp; Auditoría CTO</a>
    <a href="/mentoria-fullstack" class="block text-slate-200 font-semibold py-2 hover:text-indigo-400">🎓 Mentoría Full Stack</a>
    <div class="pt-2">
      <button
        type="button"
        data-trigger-whatsapp
        data-whatsapp-msg="Hola Aleric.dev, me gustaría solicitar una cotización para un proyecto."
        class="w-full py-3 rounded-xl bg-indigo-600 text-white font-bold text-xs uppercase tracking-wider"
      >
        Cotizar por WhatsApp
      </button>
    </div>
  </div>
</header>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    if (btn && menu) {
      btn.addEventListener('click', () => {
        menu.classList.toggle('hidden');
      });
      menu.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => menu.classList.add('hidden'));
      });
    }
  });
</script>
